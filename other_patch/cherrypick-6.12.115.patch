--- a/block/blk-mq.c
+++ b/block/blk-mq.c
@@ -3011,7 +3011,8 @@ static void blk_mq_try_issue_list_directly(struct blk_mq_hw_ctx *hctx,
 		case BLK_STS_DEV_RESOURCE:
