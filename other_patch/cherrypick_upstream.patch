+++ b/include/linux/zpool.h
@@ -51,6 +51,7 @@ void zpool_free(struct zpool *pool, unsigned long handle);
 void *zpool_map_handle(struct zpool *pool, unsigned long handle,
 			enum zpool_mapmode mm);
 
+void *zpool_map_handle_read(struct zpool *pool, unsigned long handle, size_t len);
 void zpool_unmap_handle(struct zpool *pool, unsigned long handle);
 
 u64 zpool_get_total_pages(struct zpool *pool);
@@ -94,7 +95,19 @@ struct zpool_driver {
 	u64 (*total_pages)(void *pool);
 };
 
+/*
+ * Register with zpool_register_driver_sized() and leave driver.map NULL.
+ * The extended operation takes a zero length for a legacy full-object map.
+ * Existing backends keep their original struct zpool_driver and callbacks.
+ */
+struct zpool_driver_sized {
+	struct zpool_driver driver;
+	void *(*map)(void *pool, unsigned long handle, enum zpool_mapmode mm,
+		     size_t len);
+};
+
 void zpool_register_driver(struct zpool_driver *driver);
+void zpool_register_driver_sized(struct zpool_driver_sized *sized);
 
 int zpool_unregister_driver(struct zpool_driver *driver);
 
