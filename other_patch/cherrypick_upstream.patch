 			enum zpool_mapmode mapmode)
 {
-	return zpool->driver->map(zpool->pool, handle, mapmode);
+	return zpool_map(zpool, handle, mapmode, 0);
+}
+
+/* Legacy backends map the full object and ignore the read length. */
+void *zpool_map_handle_read(struct zpool *zpool, unsigned long handle,
+			    size_t len)
+{
+	return zpool_map(zpool, handle, ZPOOL_MM_RO, len);
 }
 
