index b9fda1fa857da7eb5a91445fabda6946e810dcfa..d3739505cffa2adc3aa70dec222ebf1809829630 100644
--- a/mm/zpool.c
+++ b/mm/zpool.c
@@ -39,6 +39,13 @@ void zpool_register_driver(struct zpool_driver *driver)
 }
 EXPORT_SYMBOL(zpool_register_driver);
 
+/* Bind extended backends only to cores that support length-aware maps. */
+void zpool_register_driver_sized(struct zpool_driver_sized *sized)
+{
+	zpool_register_driver(&sized->driver);
+}
+EXPORT_SYMBOL_GPL(zpool_register_driver_sized);
+
 /**
  * zpool_unregister_driver() - unregister a zpool implementation.
  * @driver:	driver to unregister.
@@ -277,6 +284,18 @@ void zpool_free(struct zpool *zpool, unsigned long handle)
 	zpool->driver->free(zpool->pool, handle);
 }
 
+static void *zpool_map(struct zpool *zpool, unsigned long handle,
+		       enum zpool_mapmode mode, size_t len)
+{
+	struct zpool_driver_sized *sized;
+
+	if (zpool->driver->map)
+		return zpool->driver->map(zpool->pool, handle, mode);
+
+	sized = container_of(zpool->driver, struct zpool_driver_sized, driver);
+	return sized->map(zpool->pool, handle, mode, len);
+}
+
 /**
  * zpool_map_handle() - Map a previously allocated handle into memory
  * @zpool:	The zpool that the handle was allocated from
@@ -302,7 +321,14 @@ void zpool_free(struct zpool *zpool, unsigned long handle)
