From 0ffc4fa8d702ad2c9c0174d6782c648e03b93f9d Mon Sep 17 00:00:00 2001
From: Android GKI backport <backport@localhost>
Date: Wed, 25 Nov 2026 16:26:47 +0800
Subject: [PATCH 1/3] mm/zsmalloc: use the actual payload length for zram and
 zswap reads

Adapt the read-span optimization from Sergey Senozhatsky to the Android 6.12 map/unmap and zpool APIs. Keep the full-object stride for indexing and writes, and exclude class padding from length-aware reads.

Preserve the original exports and zpool_driver layout. A sized backend explicitly registers with the new core. Old drivers continue to receive the original map callback. Pair both mapping variants with the same unmap.

Link: https://lore.kernel.org/all/20260107052145.3586917-1-senozhatsky@chromium.org/
---
 drivers/block/zram/zram_drv.c |   4 +-
 include/linux/zpool.h         |  13 +++++
 include/linux/zsmalloc.h      |   1 +
 mm/zpool.c                    |  28 +++++++++-
 mm/zsmalloc.c                 | 101 ++++++++++++++++++++++------------
 mm/zswap.c                    |   2 +-
 6 files changed, 109 insertions(+), 40 deletions(-)

diff --git a/drivers/block/zram/zram_drv.c b/drivers/block/zram/zram_drv.c
index 55f52f917fb31a9e381c054839e6b058e6b9c4c5..b0a4f94a58dbbf2ff495dc6f84084141eff93986 100644
--- a/drivers/block/zram/zram_drv.c
+++ b/drivers/block/zram/zram_drv.c
@@ -2404,7 +2404,7 @@ static int read_from_zspool_raw(struct zram *zram, struct page *page, u32 index)
 	/*
 	 * No decompression takes place here, as we read raw compressed data.
 	 */
-	src = zs_map_object(zram->mem_pool, handle, ZS_MM_RO);
+	src = zs_map_object_read(zram->mem_pool, handle, size);
 	memcpy_to_page(page, 0, src, size);
 	zs_unmap_object(zram->mem_pool, handle);
 
@@ -2444,7 +2444,7 @@ static int read_from_zspool(struct zram *zram, struct page *page, u32 index)
 		zstrm = zcomp_stream_get(zram->comps[prio]);
 	}
 
-	src = zs_map_object(zram->mem_pool, handle, ZS_MM_RO);
+	src = zs_map_object_read(zram->mem_pool, handle, size);
 	if (size == PAGE_SIZE) {
 		dst = kmap_local_page(page);
 		copy_page(dst, src);
diff --git a/include/linux/zpool.h b/include/linux/zpool.h
index a67d62b796980a6bae9d695bd93ef23f533ba164..58c3518c8e4fb6efd6c8817a663267171b17de82 100644
