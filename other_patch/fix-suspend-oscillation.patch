  */
+static unsigned long last_suspend_jiffies;
+
 int pm_suspend(suspend_state_t state)
 {
 	int error;
@@ -641,6 +644,17 @@ int pm_suspend(suspend_state_t state)
 	if (state <= PM_SUSPEND_ON || state >= PM_SUSPEND_MAX)
 		return -EINVAL;
 
+	/*
+	 * Reject back-to-back suspend attempts inside one second to stop
+	 * suspend/resume oscillation storms (997 cycles observed) caused by
+	 * missing OEM bus-arbitration/wakelock patches on this BSP.
+	 */
+	if (time_before(jiffies, last_suspend_jiffies + HZ)) {
+		pr_info("suspend entry rejected (rate-limited)\n");
+		return -EBUSY;
+	}
+	last_suspend_jiffies = jiffies;
+
 	pr_info("suspend entry (%s)\n", mem_sleep_labels[state]);
