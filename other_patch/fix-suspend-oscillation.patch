diff --git a/kernel/power/suspend.c b/kernel/power/suspend.c
index 53c8e90..e34955d 100644
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -11,6 +11,7 @@
 
 #include <linux/string.h>
 #include <linux/delay.h>
+#include <linux/jiffies.h>
 #include <linux/errno.h>
 #include <linux/init.h>
 #include <linux/console.h>
@@ -634,6 +635,10 @@ static int enter_state(suspend_state_t state)
  * Check if the value of @state represents one of the supported states,
  * execute enter_state() and update system suspend statistics.
  */
+static unsigned long last_suspend_jiffies;
+static unsigned int suspend_backoff_ms = 1000;
+static unsigned int suspend_reject_streak;
+
 int pm_suspend(suspend_state_t state)
 {
 	int error;
@@ -641,6 +646,26 @@ int pm_suspend(suspend_state_t state)
 	if (state <= PM_SUSPEND_ON || state >= PM_SUSPEND_MAX)
 		return -EINVAL;
 
+	/*
+	 * Adaptive backoff against suspend/resume oscillation storms.
+	 * On this BSP a NO_SUSPEND WLAN IRQ (wlan_wake_irq) keeps waking
+	 * the device ~0.2s after every suspend, so requesters retry in a
+	 * tight loop (997 cycles/30min observed).  Enforce a 1s minimum
+	 * gap and grow it exponentially while retries keep hammering;
+	 * reset after a successful suspend entry.
+	 */
+	if (time_before(jiffies, last_suspend_jiffies + msecs_to_jiffies(suspend_backoff_ms))) {
+		pr_info("suspend entry rejected (rate-limited, %u ms)\n",
+			suspend_backoff_ms);
+		if (++suspend_reject_streak >= 3 &&
+		    suspend_backoff_ms < 30000)
+			suspend_backoff_ms = min(suspend_backoff_ms * 2, 30000U);
+		return -EBUSY;
+	}
+	suspend_reject_streak = 0;
+	suspend_backoff_ms = 1000;
+	last_suspend_jiffies = jiffies;
+
 	pr_info("suspend entry (%s)\n", mem_sleep_labels[state]);
 	error = enter_state(state);
 	if (error) {
