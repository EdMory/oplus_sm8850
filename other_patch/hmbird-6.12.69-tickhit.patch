diff --git a/kernel/sched/hmbird/hmbird_sched_proc.c b/kernel/sched/hmbird/hmbird_sched_proc.c
index d99b31a..1234567 100644
--- a/kernel/sched/hmbird/hmbird_sched_proc.c
+++ b/kernel/sched/hmbird/hmbird_sched_proc.c
@@ -44,6 +44,150 @@ int cluster_separate = 1;
 
 char saved_gov[NR_CPUS][MAX_GOV_LEN];
 
+/* SM8850 Boost Policy Parameters */
+struct boost_policy_params boost_policy_params = {
+	.enable = 1,
+	.bottom_freq = 1500000,
+	.boost_weight = 140,
+};
+EXPORT_SYMBOL_GPL(boost_policy_params);
+
+int hmbird_get_boost_enable(void)
+{
+	return boost_policy_params.enable;
+}
+EXPORT_SYMBOL_GPL(hmbird_get_boost_enable);
+
+unsigned int hmbird_get_boost_bottom_freq(void)
+{
+	return boost_policy_params.bottom_freq;
+}
+EXPORT_SYMBOL_GPL(hmbird_get_boost_bottom_freq);
+
+int hmbird_get_boost_weight(void)
+{
+	return boost_policy_params.boost_weight;
+}
+EXPORT_SYMBOL_GPL(hmbird_get_boost_weight);
+
+static int boost_policy_show(struct seq_file *m, void *v)
+{
+	struct boost_policy_params *data = m->private;
+	seq_printf(m, "boost_policy:{\"enable\":%d; \"bottom_freq\":%u; \"boost_weight\":%d}\n",
+		   data->enable, data->bottom_freq, data->boost_weight);
+	return 0;
+}
+
+static int boost_policy_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, boost_policy_show, pde_data(inode));
+}
+
+static ssize_t boost_policy_write(struct file *file, const char __user *buf,
+				  size_t count, loff_t *ppos)
+{
+	char *data;
+	int enable_tmp, bottom_freq_tmp, boost_weight_tmp;
+
+	data = kmalloc(count + 1, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	if (copy_from_user(data, buf, count)) {
+		kfree(data);
+		return -EFAULT;
+	}
+	data[count] = '\0';
+	if (sscanf(data, "%d %d %d", &enable_tmp, &bottom_freq_tmp, &boost_weight_tmp) != 3) {
+		kfree(data);
+		return -EINVAL;
+	}
+	if (enable_tmp != 0 && enable_tmp != 1) {
+		kfree(data);
+		return -EINVAL;
+	}
+	if (boost_weight_tmp < 50 || boost_weight_tmp > 300) {
+		kfree(data);
+		return -EINVAL;
+	}
+	if (bottom_freq_tmp < 400000 || bottom_freq_tmp > 2200000) {
+		kfree(data);
+		return -EINVAL;
+	}
+	boost_policy_params.bottom_freq = bottom_freq_tmp;
+	boost_policy_params.boost_weight = boost_weight_tmp;
+	boost_policy_params.enable = enable_tmp;
+	pr_info("[HMBIRD] boost_policy: enable=%d freq=%u weight=%d\n",
+		enable_tmp, bottom_freq_tmp, boost_weight_tmp);
+	kfree(data);
+	return count;
+}
+
+static const struct proc_ops boost_policy_proc_ops = {
+	.proc_open = boost_policy_open,
+	.proc_write = boost_policy_write,
+	.proc_read = seq_read,
+	.proc_lseek = seq_lseek,
+	.proc_release = single_release,
+};
+
+static int tick_hit_show(struct seq_file *m, void *v)
+{
+	struct tick_hit_params *data = m->private;
+	seq_printf(m, "tick_hit:{\"enable\":%d; \"hit_count_thres\":%d; \"jiffies_num\":%lu}\n",
+		   data->enable, data->hit_count_thres, data->jiffies_num);
+	return 0;
+}
+
+static int tick_hit_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, tick_hit_show, pde_data(inode));
+}
+
+static ssize_t tick_hit_write(struct file *file, const char __user *buf,
+			      size_t count, loff_t *ppos)
+{
+	char *data;
+	int enable_tmp, hit_count_thres_tmp, jiffies_num_tmp;
+
+	data = kmalloc(count + 1, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	if (copy_from_user(data, buf, count)) {
+		kfree(data);
+		return -EFAULT;
+	}
+	data[count] = '\0';
+	if (sscanf(data, "%d %d %d", &enable_tmp, &hit_count_thres_tmp, &jiffies_num_tmp) != 3) {
+		kfree(data);
+		return -EINVAL;
+	}
+	if (enable_tmp != 0 && enable_tmp != 1) {
+		kfree(data);
+		return -EINVAL;
+	}
+	tick_hit_params.hit_count_thres = hit_count_thres_tmp;
+	tick_hit_params.jiffies_num = jiffies_num_tmp;
+	tick_hit_params.enable = enable_tmp;
+	pr_info("[HMBIRD] tick_hit: enable=%d thres=%d jiffies=%d\n",
+		enable_tmp, hit_count_thres_tmp, jiffies_num_tmp);
+	kfree(data);
+	return count;
+}
+
+static const struct proc_ops tick_hit_proc_ops = {
+	.proc_open = tick_hit_open,
+	.proc_write = tick_hit_write,
+	.proc_read = seq_read,
+	.proc_lseek = seq_lseek,
+	.proc_release = single_release,
+};
+
 static int set_proc_buf_val(struct file *file, const char __user *buf, size_t count, int *val)
 {
 	char kbuf[32] = {0};
@@ -855,6 +999,14 @@ static int __init hmbird_proc_init(void)
 	if (!hmbird_dir) {
 		pr_err("Error creating proc directory %s\n", HMBIRD_SCHED_PROC_DIR);
 		return -ENOMEM;
 	}
+
+	/* SM8850: Register Tick Hit and Boost Policy */
+	if (!proc_create_data("boost_policy", 0644, hmbird_dir,
+			      &boost_policy_proc_ops, &boost_policy_params))
+		return -ENOMEM;
+	if (!proc_create_data("tick_hit", 0644, hmbird_dir,
+			      &tick_hit_proc_ops, &tick_hit_params))
+		return -ENOMEM;
 
 	/* /proc/hmbird_sched--begin */
 	HMBIRD_CREATE_PROC_ENTRY_DATA("scx_enable", HMBIRD_PROC_PERMISSION,
@@ -1028,6 +1176,10 @@ static int __init hmbird_proc_init(void)
 	HMBIRD_CREATE_PROC_ENTRY_DATA("cluster_separate", HMBIRD_PROC_PERMISSION,
 				hmbird_dir,
 				&hmbird_common_proc_ops,
 				&cluster_separate);
 
+	/* SM8850: Enable shadow tick by default */
+	highres_tick_ctrl = 1;
+	tick_hit_params.enable = 1;
+
 	return 0;
 }
