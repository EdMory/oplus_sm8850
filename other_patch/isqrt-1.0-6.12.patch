--- /dev/null
+++ b/lib/isqrt/isqrt_kunit.c
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * KUnit tests for the isqrt kernel port.
+ *
+ * Upstream project: https://github.com/firelzrd/isqrt
+ */
+#include <kunit/test.h>
+#include <linux/isqrt.h>
+#include <linux/types.h>
+
+static bool isqrt_ok(u64 v, u64 r)
+{
+	if (r == 0)
+		return v == 0;
+	if (v / r < r)
+		return false;
+	if (v / (r + 1) >= r + 1)
+		return false;
+	return true;
+}
+
+static void isqrt_u8_exhaustive(struct kunit *test)
+{
+	u64 v;
+
+	for (v = 0; v <= 255; v++)
+		KUNIT_EXPECT_TRUE(test, isqrt_ok(v, isqrt8((u8)v)));
+}
+
+static void isqrt_u16_exhaustive(struct kunit *test)
+{
+	u64 v;
+
+	for (v = 0; v <= 65535; v++)
+		KUNIT_EXPECT_TRUE(test, isqrt_ok(v, isqrt16((u16)v)));
+}
+
+static void isqrt_u32_edges(struct kunit *test)
+{
+	static const u32 edges[] = {
+		0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 255, 256,
+		65535, 65536, 16777215, 16777216, U32_MAX,
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(edges); i++)
+		KUNIT_EXPECT_TRUE(test, isqrt_ok(edges[i], isqrt32(edges[i])));
+}
+
+static void isqrt_u64_edges(struct kunit *test)
+{
+	static const u64 edges[] = {
+		0, 1, 2, 3, 4, 5, 7, 8, 15, 16, 255, 256, 65535, 65536,
+		0xffffffffULL, 0x100000000ULL, 0xffffffffffffffffULL,
+		(1ULL << 32) - 1, (1ULL << 32),
+		0xfffffffe00000001ULL,
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(edges); i++)
+		KUNIT_EXPECT_TRUE(test, isqrt_ok(edges[i], isqrt64(edges[i])));
+}
+
+static struct kunit_case isqrt_test_cases[] = {
+	KUNIT_CASE(isqrt_u8_exhaustive),
+	KUNIT_CASE(isqrt_u16_exhaustive),
+	KUNIT_CASE(isqrt_u32_edges),
+	KUNIT_CASE(isqrt_u64_edges),
+	{}
+};
+
+static struct kunit_suite isqrt_test_suite = {
+	.name = "isqrt",
+	.test_cases = isqrt_test_cases,
+};
+
+kunit_test_suite(isqrt_test_suite);
