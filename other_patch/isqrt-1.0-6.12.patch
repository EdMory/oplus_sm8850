diff --git a/lib/isqrt/isqrt.c b/lib/isqrt/isqrt.c
new file mode 100644
--- /dev/null
+++ b/lib/isqrt/isqrt.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * isqrt - Fast Integer Square Root library, kernel-side self test
+ *
+ * The isqrt library itself is header-only (include/linux/isqrt.h):
+ * every function is static inline and every lookup table is static
+ * const, so there is nothing to link into the image.  This file only
+ * instantiates the four entry points under the real kernel toolchain
+ * and verifies exact floor(sqrt(v)) semantics at boot.
+ *
+ * Copyright (C) 2026 Masahito Suzuki (upstream firelzrd/isqrt v1.0)
+ * Kernel port: EdMory/oplus_sm8850 workflow integration.
+ */
+#include <linux/isqrt.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/limits.h>
+#include <linux/module.h>
+
+static bool isqrt_selftest_fail;
+
+/* Reference: classic binary digit-by-digit sqrt, no multiply overflow. */
+static u64 isqrt_ref(u64 v)
+{
+	u64 r = 0, bit = 1ULL << 62;
+
+	while (bit > v)
+		bit >>= 2;
+	while (bit) {
+		if (v >= r + bit) {
+			v -= r + bit;
+			r = (r >> 1) + bit;
+		} else {
+			r >>= 1;
+		}
+		bit >>= 2;
+	}
+	return r;
+}
+
+static void isqrt_report(const char *fn, u64 in, u64 got, u64 want)
+{
+	pr_err("isqrt: %s(%llu) = %llu, expected %llu\n", fn, in, got, want);
+	isqrt_selftest_fail = true;
+}
+
+static int __init isqrt_selftest_init(void)
+{
+	u64 v, got, want;
+	u32 i;
+
+	/* 8-bit: exhaustive 0..255 */
+	for (i = 0; i <= 255; i++) {
+		got = isqrt8((u8)i);
+		want = isqrt_ref(i);
+		if (got != want)
+			isqrt_report("isqrt8", i, got, want);
+	}
+
+	/* 16-bit: exhaustive 0..65535 */
+	for (i = 0; i <= 65535; i++) {
+		got = isqrt16((u16)i);
+		want = isqrt_ref(i);
+		if (got != want)
+			isqrt_report("isqrt16", i, got, want);
+	}
+
+	/* 32-bit: prefix sweep + boundary spot checks */
+	for (v = 0; v < 100000; v++) {
+		got = isqrt32((u32)v);
+		want = isqrt_ref(v);
+		if (got != want)
+			isqrt_report("isqrt32", v, got, want);
+	}
+	{
+		static const u32 spots[] = {
+			0U, 1U, 2U, 3U, 4U, 255U, 256U, 65535U, 65536U,
+			1000000000U, 2147483647U, 2147483648U,
+			4294836223U, 4294836224U, 4294836225U, U32_MAX,
+		};
+		for (i = 0; i < ARRAY_SIZE(spots); i++) {
+			got = isqrt32(spots[i]);
+			want = isqrt_ref(spots[i]);
+			if (got != want)
+				isqrt_report("isqrt32", spots[i], got, want);
+		}
+	}
+
+	/* 64-bit: prefix sweep + boundary spot checks */
+	for (v = 0; v < 50000; v++) {
+		got = isqrt64(v);
+		want = isqrt_ref(v);
+		if (got != want)
+			isqrt_report("isqrt64", v, got, want);
+	}
+	{
+		static const u64 spots[] = {
+			0ULL, 1ULL, 2ULL, 3ULL, 4294967295ULL, 4294967296ULL,
+			281474976710655ULL, 281474976710656ULL,
+			18446744056529682432ULL, 18446744056529682433ULL,
+			U64_MAX - 1, U64_MAX,
+		};
+		for (i = 0; i < ARRAY_SIZE(spots); i++) {
+			got = isqrt64(spots[i]);
+			want = isqrt_ref(spots[i]);
+			if (got != want)
+				isqrt_report("isqrt64", spots[i], got, want);
+		}
+	}
+
+	if (isqrt_selftest_fail) {
+		pr_err("isqrt: kernel self test FAILED\n");
+		return 0;
+	}
+	pr_info("isqrt: kernel self test passed\n");
+	return 0;
+}
+late_initcall(isqrt_selftest_init);
diff --git a/lib/isqrt/isqrt_kunit.c b/lib/isqrt/isqrt_kunit.c
new file mode 100644
--- /dev/null
+++ b/lib/isqrt/isqrt_kunit.c
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for the isqrt fast integer square root library.
+ */
+#include <kunit/test.h>
+#include <linux/isqrt.h>
+
+/* Reference: classic binary digit-by-digit sqrt, no multiply overflow. */
+static u64 isqrt_ref(u64 v)
+{
+	u64 r = 0, bit = 1ULL << 62;
+
+	while (bit > v)
+		bit >>= 2;
+	while (bit) {
+		if (v >= r + bit) {
+			v -= r + bit;
+			r = (r >> 1) + bit;
+		} else {
+			r >>= 1;
+		}
+		bit >>= 2;
+	}
+	return r;
+}
+
+static void isqrt8_exhaustive_test(struct kunit *test)
+{
+	u32 i;
+
+	for (i = 0; i <= 255; i++)
+		KUNIT_EXPECT_EQ(test, isqrt8((u8)i), (u8)isqrt_ref(i));
+}
+
+static void isqrt16_exhaustive_test(struct kunit *test)
+{
+	u32 i;
+
+	for (i = 0; i <= 65535; i++)
+		KUNIT_EXPECT_EQ(test, isqrt16((u16)i), (u16)isqrt_ref(i));
+}
+
+static void isqrt32_spot_test(struct kunit *test)
+{
+	static const u32 spots[] = {
+		0U, 1U, 2U, 3U, 4U, 255U, 256U, 65535U, 65536U,
+		1000000000U, 2147483647U, 2147483648U,
+		4294836223U, 4294836224U, 4294836225U, U32_MAX,
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(spots); i++)
+		KUNIT_EXPECT_EQ(test, isqrt32(spots[i]), (u32)isqrt_ref(spots[i]));
+}
+
+static void isqrt64_spot_test(struct kunit *test)
+{
+	static const u64 spots[] = {
+		0ULL, 1ULL, 2ULL, 3ULL, 4294967295ULL, 4294967296ULL,
+		281474976710655ULL, 281474976710656ULL,
+		18446744056529682432ULL, 18446744056529682433ULL,
+		U64_MAX - 1, U64_MAX,
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(spots); i++)
+		KUNIT_EXPECT_EQ(test, isqrt64(spots[i]), isqrt_ref(spots[i]));
+}
+
+static struct kunit_case isqrt_test_cases[] = {
+	KUNIT_CASE(isqrt8_exhaustive_test),
+	KUNIT_CASE(isqrt16_exhaustive_test),
+	KUNIT_CASE(isqrt32_spot_test),
+	KUNIT_CASE(isqrt64_spot_test),
+	{}
+};
+
+static struct kunit_suite isqrt_test_suite = {
+	.name = "isqrt",
+	.test_cases = isqrt_test_cases,
+};
+
+kunit_test_suite(isqrt_test_suite);
