+# SPDX-License-Identifier: GPL-2.0-only
+config ISQRT
+	bool "Fast integer square root (isqrt) library"
+	default y
+	help
+	  Header-only fast integer square root library ported from
+	  firelzrd/isqrt.  Provides exact floor(sqrt(v)) for 8/16/32/64-bit
+	  unsigned integers using CLZ + lookup tables + Newton-Raphson,
+	  several times faster than the loop-based int_sqrt.
+
+	  All functions are static inline and all tables are static const:
+	  the library adds zero runtime cost and zero exported symbols.
+	  Kernel code can use it via #include <linux/isqrt.h>.
+
+config ISQRT_KUNIT_TEST
+	bool "KUnit test for isqrt library"
+	depends on ISQRT && KUNIT
+	default n
+	help
+	  KUnit test coverage for isqrt8/16/32/64 exactness.
