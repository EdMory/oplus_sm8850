+# SPDX-License-Identifier: GPL-2.0
+#
+# isqrt is a header-only library (include/linux/isqrt.h) and has no object of
+# its own: this directory only carries the boot time self-test plus the
+# optional KUnit test cases.
+#
+obj-$(CONFIG_ISQRT) += isqrt.o
+obj-$(CONFIG_ISQRT_KUNIT_TEST) += isqrt_kunit.o
+
diff --git a/lib/isqrt/isqrt.c b/lib/isqrt/isqrt.c
new file mode 100644
--- /dev/null
+++ b/lib/isqrt/isqrt.c
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * isqrt kernel integration unit and boot self-test.
+ *
+ * include/linux/isqrt.h is header-only (static inline functions, static const
+ * tables): nothing is exported and unused code is discarded, so the library
+ * needs no object file of its own.  This file exists so that the port is
+ * really instantiated and validated on this kernel:
+ *
+ *   1. all entry points used below are compiled by the kernel toolchain with
+ *      the very same flags as the rest of the tree, so a broken port fails
+ *      the build instead of failing silently at some later point;
+ *   2. exhaustive 8/16-bit plus 32/64-bit edge and pseudo-random checks are
+ *      run once at late_initcall time.  Failures are only reported with
+ *      pr_err() and never abort the boot; the successful path is silent
+ *      (pr_debug).
+ *
+ * Upstream project: https://github.com/firelzrd/isqrt
+ */
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/isqrt.h>
+#include <linux/kernel.h>
+#include <linux/printk.h>
+#include <linux/types.h>
+
+/*
+ * Overflow-safe floor(sqrt) check: for r > 0 the condition
+ *   r^2 <= v < (r+1)^2
+ * is equivalent to
+ *   v / r >= r   &&   v / (r + 1) < r + 1
+ * which never overflows (r <= 2^32-1 for 64-bit inputs).  r == 0 only
+ * happens for v == 0.
+ */
+static bool __init isqrt_ok(u64 v, u64 r)
+{
+	if (r == 0)
+		return v == 0;
+	if (v / r < r)
+		return false;
+	if (v / (r + 1) >= r + 1)
+		return false;
+	return true;
+}
+
+/* Deterministic xorshift64 PRNG: no external RNG dependency at boot. */
+static u64 __init isqrt_prng(u64 *state)
+{
+	u64 x = *state;
+
+	x ^= x << 13;
+	x ^= x >> 7;
+	x ^= x << 17;
+	*state = x;
+	return x;
+}
+
+static int __init isqrt_selftest_init(void)
+{
+	u64 state = 0x9e3779b97f4a7c15ULL;
+	u64 v, r;
+	unsigned int i;
+	int fails = 0;
+
+	/* u8: exhaustive 0..255 */
+	for (v = 0; v <= 255; v++) {
+		r = isqrt8((u8)v);
+		if (!isqrt_ok(v, r)) {
+			pr_err("isqrt selftest: isqrt8(%llu) = %llu\n", v, r);
+			fails++;
+		}
+	}
+
+	/* u16: exhaustive 0..65535 */
+	for (v = 0; v <= 65535; v++) {
+		r = isqrt16((u16)v);
+		if (!isqrt_ok(v, r)) {
+			pr_err("isqrt selftest: isqrt16(%llu) = %llu\n", v, r);
+			fails++;
+		}
+	}
+
+	/* u32: power-of-two edges + pseudo-random sampling */
+	{
+		static const u32 edges[] = {
+			0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 255, 256,
+			65535, 65536, 16777215, 16777216, U32_MAX,
+		};
+		for (i = 0; i < ARRAY_SIZE(edges); i++) {
+			v = edges[i];
+			r = isqrt32((u32)v);
+			if (!isqrt_ok(v, r)) {
+				pr_err("isqrt selftest: isqrt32(%llu) = %llu\n", v, r);
+				fails++;
+			}
+		}
+		for (i = 0; i < 20000; i++) {
+			v = isqrt_prng(&state) & 0xffffffffULL;
+			r = isqrt32((u32)v);
+			if (!isqrt_ok(v, r)) {
+				pr_err("isqrt selftest: isqrt32(%llu) = %llu\n", v, r);
+				fails++;
+			}
+		}
+	}
+
+	/* u64: edges (incl. ULLONG_MAX and the max-root corner) + sampling */
+	{
+		static const u64 edges[] = {
+			0, 1, 2, 3, 4, 5, 7, 8, 15, 16, 255, 256, 65535, 65536,
+			0xffffffffULL, 0x100000000ULL, 0xfffffffffffffffeULL,
+			0xffffffffffffffffULL,
+			(1ULL << 32) - 1,
+			(1ULL << 32),
+			0xfffffffe00000001ULL, /* (2^32-1)^2 */
+		};
+		for (i = 0; i < ARRAY_SIZE(edges); i++) {
+			v = edges[i];
+			r = isqrt64(v);
+			if (!isqrt_ok(v, r)) {
+				pr_err("isqrt selftest: isqrt64(%llu) = %llu\n", v, r);
+				fails++;
+			}
+		}
+		for (i = 0; i < 5000; i++) {
+			v = isqrt_prng(&state);
+			r = isqrt64(v);
+			if (!isqrt_ok(v, r)) {
+				pr_err("isqrt selftest: isqrt64(%llu) = %llu\n", v, r);
+				fails++;
+			}
+		}
+	}
+
+	if (fails) {
+		pr_err("isqrt selftest: %d FAILURES\n", fails);
+		return -EINVAL;
+	}
+	pr_debug("isqrt selftest: all checks passed (8-bit x256, 16-bit x65536, 32/64-bit edges + 25k samples)\n");
+	return 0;
+}
+late_initcall(isqrt_selftest_init);
+
