+++ b/lib/isqrt/isqrt_selftest_host.c
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Host-side numerical self test for the isqrt kernel port.
+ *
+ * Not part of the kernel image: this file is compiled on the CI runner with
+ * the host toolchain against include/linux/isqrt.h (with a minimal stub for
+ * <linux/types.h>) so the ported numerics are validated without booting a
+ * kernel.  Exhaustive 8/16-bit plus heavily sampled 32/64-bit coverage.
+ *
+ * Upstream project: https://github.com/firelzrd/isqrt
+ */
+#include <stdio.h>
+#include <stdlib.h>
+
+/* stand-in for the kernel's <linux/types.h>, supplied by -I ordering */
+#include <linux/types.h>
+#include <linux/isqrt.h>
+
+static int isqrt_ok(u64 v, u64 r)
+{
+	if (r == 0)
+		return v == 0;
+	if (v / r < r)
+		return 0;
+	if (v / (r + 1) >= r + 1)
+		return 0;
+	return 1;
+}
+
+static u64 prng(u64 *state)
+{
+	u64 x = *state;
+
+	x ^= x << 13;
+	x ^= x >> 7;
+	x ^= x << 17;
+	*state = x;
+	return x;
+}
+
+int main(void)
+{
+	u64 state = 0x9e3779b97f4a7c15ULL;
+	unsigned long long tested = 0;
+	unsigned long long fails = 0;
+	u64 v, r;
+	unsigned int i;
+
+	/* u8 exhaustive */
+	for (v = 0; v <= 255; v++) {
+		r = isqrt8((u8)v);
+		tested++;
+		if (!isqrt_ok(v, r)) { fails++; fprintf(stderr, "isqrt8(%llu)=%llu FAIL\n", v, r); }
+	}
+
+	/* u16 exhaustive */
+	for (v = 0; v <= 65535; v++) {
+		r = isqrt16((u16)v);
+		tested++;
+		if (!isqrt_ok(v, r)) { fails++; fprintf(stderr, "isqrt16(%llu)=%llu FAIL\n", v, r); }
+	}
+
+	/* u32: edges + 200k samples */
+	{
+		static const u32 edges[] = {
+			0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 255, 256,
+			65535, 65536, 16777215, 16777216, 0xffffffffU,
+		};
+		for (i = 0; i < sizeof(edges) / sizeof(edges[0]); i++) {
+			v = edges[i]; r = isqrt32((u32)v);
+			tested++;
+			if (!isqrt_ok(v, r)) { fails++; fprintf(stderr, "isqrt32(%llu)=%llu FAIL\n", v, r); }
+		}
+		for (i = 0; i < 200000; i++) {
+			v = prng(&state) & 0xffffffffULL; r = isqrt32((u32)v);
+			tested++;
+			if (!isqrt_ok(v, r)) { fails++; fprintf(stderr, "isqrt32(%llu)=%llu FAIL\n", v, r); }
+		}
+	}
+
+	/* u64: edges + 100k samples */
+	{
+		static const u64 edges[] = {
+			0, 1, 2, 3, 4, 5, 7, 8, 15, 16, 255, 256, 65535, 65536,
+			0xffffffffULL, 0x100000000ULL, 0xfffffffffffffffeULL,
+			0xffffffffffffffffULL, (1ULL << 32) - 1, (1ULL << 32),
+			0xfffffffe00000001ULL,
+		};
+		for (i = 0; i < sizeof(edges) / sizeof(edges[0]); i++) {
+			v = edges[i]; r = isqrt64(v);
+			tested++;
+			if (!isqrt_ok(v, r)) { fails++; fprintf(stderr, "isqrt64(%llu)=%llu FAIL\n", v, r); }
+		}
+		for (i = 0; i < 100000; i++) {
+			v = prng(&state); r = isqrt64(v);
+			tested++;
+			if (!isqrt_ok(v, r)) { fails++; fprintf(stderr, "isqrt64(%llu)=%llu FAIL\n", v, r); }
+		}
+	}
+
+	printf("isqrt host selftest: %llu cases, %llu failures\n", tested, fails);
+	return fails ? 1 : 0;
+}
+
