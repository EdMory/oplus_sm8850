+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Host-side numeric self test for the isqrt kernel port.
+ *
+ * Compiled and run on the CI runner with the host gcc (never built into
+ * the kernel image).  It includes <linux/isqrt.h> from the kernel tree,
+ * with <linux/types.h> satisfied by a tiny stub placed first in -I.
+ */
+#include <stdio.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <linux/isqrt.h>
+
+/* Reference: classic binary digit-by-digit sqrt, no multiply overflow. */
+static unsigned long long isqrt_ref(unsigned long long v)
+{
+	unsigned long long r = 0, bit = 1ULL << 62;
+
+	while (bit > v)
+		bit >>= 2;
+	while (bit) {
+		if (v >= r + bit) {
+			v -= r + bit;
+			r = (r >> 1) + bit;
+		} else {
+			r >>= 1;
+		}
+		bit >>= 2;
+	}
+	return r;
+}
+
+static unsigned long failures;
+
+static void check_u8(void)
+{
+	unsigned int i;
+
+	for (i = 0; i <= 255; i++)
+		if (isqrt8((u8)i) != (u8)isqrt_ref(i))
+			failures++, printf("FAIL isqrt8(%u)=%u\n", i, isqrt8((u8)i));
+}
+
+static void check_u16(void)
+{
+	unsigned int i;
+
+	for (i = 0; i <= 65535; i++)
+		if (isqrt16((u16)i) != (u16)isqrt_ref(i))
+			failures++, printf("FAIL isqrt16(%u)=%u\n", i, isqrt16((u16)i));
+}
+
+static void check_u32(void)
+{
+	unsigned long long i;
+
+	for (i = 0; i < 2000000ULL; i++)
+		if (isqrt32((u32)i) != (u32)isqrt_ref(i))
+			failures++, printf("FAIL isqrt32(%llu)=%u\n", i, isqrt32((u32)i));
+	{
+		static const u32 spots[] = {
+			0U, 1U, 2U, 3U, 255U, 256U, 65535U, 65536U,
+			4294836223U, 4294836224U, 4294836225U, UINT32_MAX,
+		};
+		unsigned int k;
+
+		for (k = 0; k < sizeof(spots) / sizeof(spots[0]); k++)
+			if (isqrt32(spots[k]) != (u32)isqrt_ref(spots[k]))
+				failures++, printf("FAIL isqrt32(%u)=%u\n",
+						   spots[k], isqrt32(spots[k]));
+	}
+}
+
+static void check_u64(void)
+{
+	unsigned long long i;
+
+	for (i = 0; i < 1000000ULL; i++)
+		if (isqrt64(i) != isqrt_ref(i))
+			failures++, printf("FAIL isqrt64(%llu)=%llu\n", i, isqrt64(i));
+	{
+		static const unsigned long long spots[] = {
+			0ULL, 1ULL, 2ULL, 4294967295ULL, 4294967296ULL,
+			18446744056529682432ULL, 18446744056529682433ULL,
+			~0ULL,
+		};
+		unsigned int k;
+
+		for (k = 0; k < sizeof(spots) / sizeof(spots[0]); k++)
+			if (isqrt64(spots[k]) != isqrt_ref(spots[k]))
+				failures++, printf("FAIL isqrt64(%llu)=%llu\n",
+						   spots[k], isqrt64(spots[k]));
+	}
+}
+
+int main(void)
+{
+	check_u8();
+	check_u16();
+	check_u32();
+	check_u64();
+	if (failures) {
+		printf("isqrt host self test: %lu FAILURES\n", failures);
+		return 1;
+	}
+	printf("isqrt host self test: all passed\n");
+	return 0;
+}
