+/*
+ * Kcompressd-Unofficial, based on work by Masahito Suzuki and Qun-Wei Lin.
+ * Only the node's own kswapd produces work. Its start/stop lock serializes
+ * queue creation and teardown, so the queue outlives its sole producer.
+ */
+#define KCOMPRESS_FIFO_SIZE 256
+
+struct kcompress_queue {
+	DECLARE_KFIFO(folios, struct folio *, KCOMPRESS_FIFO_SIZE);
+	spinlock_t lock;
+	wait_queue_head_t wait;
+	struct task_struct *worker;
+};
+
+static struct kcompress_queue *kcompress_queues[MAX_NUMNODES];
+static int kcompressd_depth __read_mostly = 24;
+
+#ifdef CONFIG_SYSCTL
+static int kcompressd_max_depth = KCOMPRESS_FIFO_SIZE;
+static struct ctl_table kcompressd_sysctls[] = {
+	{
+		.procname	= "kcompressd",
+		.data		= &kcompressd_depth,
+		.maxlen		= sizeof(kcompressd_depth),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= &kcompressd_max_depth,
+	},
+};
+
+static int __init kcompressd_sysctl_init(void)
+{
+	register_sysctl_init("vm", kcompressd_sysctls);
+	return 0;
+}
+late_initcall(kcompressd_sysctl_init);
+#endif
+
+/* Finish a queued write with a fresh wbc: the caller's swap plug is local. */
+static void kcompress_write(struct folio *folio)
+{
+	struct writeback_control wbc = {
+		.sync_mode = WB_SYNC_NONE,
+		.nr_to_write = SWAP_CLUSTER_MAX,
+		.range_end = LLONG_MAX,
+		.for_reclaim = 1,
+	};
+
+	if (zswap_store(folio)) {
+		folio_unlock(folio);
+	} else if (!mem_cgroup_zswap_writeback_enabled(folio_memcg(folio))) {
+		/* The limit may have changed since enqueue. Retry on reclaim. */
+		folio_mark_dirty(folio);
+		folio_unlock(folio);
+	} else {
+		__swap_writepage(folio, &wbc);
+	}
+	folio_put(folio);
+}
+
+static int kcompressd_thread(void *data)
+{
+	struct kcompress_queue *q = data;
+	struct folio *folio;
+
+	current->flags |= PF_MEMALLOC | PF_KSWAPD;
+	for (;;) {
+		wait_event_idle(q->wait, kthread_should_stop() ||
+				!kfifo_is_empty(&q->folios));
+		while (kfifo_out_spinlocked(&q->folios, &folio, 1, &q->lock)) {
+			kcompress_write(folio);
+			cond_resched();
+		}
+		if (kthread_should_stop())
+			break;
+	}
+	return 0;
+}
+
+void kcompressd_start(int nid)
+{
+	struct kcompress_queue *q;
+
+	q = kzalloc_node(sizeof(*q), GFP_KERNEL, nid);
+	if (!q)
+		return;
+	INIT_KFIFO(q->folios);
+	spin_lock_init(&q->lock);
+	init_waitqueue_head(&q->wait);
+	q->worker = kthread_create_on_node(kcompressd_thread, q, nid,
+					  "kcompressd%d", nid);
+	if (IS_ERR(q->worker)) {
+		kfree(q);
+		return;
+	}
+	kcompress_queues[nid] = q;
+	wake_up_process(q->worker);
+}
+
+void kcompressd_stop(int nid)
+{
+	struct kcompress_queue *q = kcompress_queues[nid];
+	struct folio *folio;
+
+	if (!q)
+		return;
+	kthread_stop(q->worker);
+	/* kthread_stop() may have preceded the first run of the worker. */
+	while (kfifo_get(&q->folios, &folio))
+		kcompress_write(folio);
+	kcompress_queues[nid] = NULL;
+	kfree(q);
+}
+
+static bool kcompressd_store(struct folio *folio)
+{
+	unsigned int depth = READ_ONCE(kcompressd_depth);
+	struct kcompress_queue *q;
+	struct folio *head;
+
+	if (!depth || !current_is_kswapd() || !folio_test_anon(folio) ||
+	    current != READ_ONCE(folio_pgdat(folio)->kswapd))
+		return false;
+	q = kcompress_queues[folio_nid(folio)];
+	if (!q || !mem_cgroup_zswap_writeback_enabled(folio_memcg(folio)))
+		return false;
+	if (!zswap_is_enabled() && !(data_race(folio_swap_flags(folio)) &
+				     __SWP_WRITE_SYNCHRONOUS_IO))
+		return false;
+
+	/* On saturation the producer processes older folios before enqueue. */
+	spin_lock(&q->lock);
+	while (kfifo_len(&q->folios) >= depth) {
+		if (WARN_ON_ONCE(!kfifo_get(&q->folios, &head))) {
+			spin_unlock(&q->lock);
+			return false;
+		}
+		spin_unlock(&q->lock);
+		kcompress_write(head);
+		spin_lock(&q->lock);
+	}
+	folio_get(folio);
+	if (WARN_ON_ONCE(!kfifo_put(&q->folios, folio))) {
+		spin_unlock(&q->lock);
+		folio_put(folio);
+		return false;
+	}
+	spin_unlock(&q->lock);
+	wake_up(&q->wait);
+	return true;
+}
+
 /*
  * We may have stale swap cache pages in memory: notice
  * them here and get rid of the unnecessary final write.
@@ -279,6 +436,8 @@ int swap_writepage(struct page *page, struct writeback_control *wbc)
