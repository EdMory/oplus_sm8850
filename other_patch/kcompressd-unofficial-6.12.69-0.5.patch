 }
+
+/*
+ * kcompressd() - Kernel thread performing asynchronous swapout
+ * @unused: unused
+ */
+static int kcompressd(void *unused)
+{
+	struct folio *folio;
+
+	/*
+	 * kcompressd runs with PF_MEMALLOC and PF_KSWAPD set so that it may
+	 * allocate memory for compression, and so that PF_KSWAPD-only
+	 * shrinkers (e.g. i915_gem_shrinker_scan()) behave as expected.
+	 */
+	current->flags |= PF_MEMALLOC | PF_KSWAPD;
+
+	while (!kthread_should_stop()) {
+		wait_event_interruptible(kcompressd_wait,
+				!kfifo_is_empty(&kcompress_fifo));
+
+		while (kfifo_out_locked(&kcompress_fifo, &folio, 1,
+					&kcompress_fifo_lock))
+			do_swapout(folio);
+	}
+
+	return 0;
+}
+
+static int __init kcompressd_init(void)
+{
+	struct task_struct *task;
+
+	task = kthread_run(kcompressd, NULL, "kcompressd");
+	if (IS_ERR(task)) {
+		pr_err("kcompressd: failed to start thread, ret=%ld\n",
+				PTR_ERR(task));
+		return 0;
+	}
+
+	kcompressd_task = task;
+	pr_info("kcompressd: v0.8 ready (KABI-safe, disabled by default)\n");
+	return 0;
+}
+late_initcall(kcompressd_init);
