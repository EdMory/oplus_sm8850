From 58314bb7564b1db6c857681088f080ce46c5a1a4 Mon Sep 17 00:00:00 2001
From: Mory <mory@local>
Date: Sat, 31 Oct 2026 21:35:57 +0800
Subject: [PATCH] kcompressd 0.7b: struct/init only, kfifo as pointer (mmzone.h without kfifo.h)

---
 include/linux/mmzone.h |  8 ++++++++
 kernel/sysctl.c        | 12 ++++++++++++
 mm/mm_init.c           |  1 +
 3 files changed, 21 insertions(+)

diff --git a/include/linux/mmzone.h b/include/linux/mmzone.h
index 37cd759..f765114 100644
--- a/include/linux/mmzone.h
+++ b/include/linux/mmzone.h
@@ -27,6 +27,8 @@
 #include <linux/android_kabi.h>
 #include <asm/page.h>
 
+struct kfifo;
+
 /* Free memory management - zoned buddy allocator.  */
 #ifndef CONFIG_ARCH_FORCE_MAX_ORDER
 #define MAX_PAGE_ORDER 10
@@ -1409,6 +1411,12 @@ typedef struct pglist_data {
 
 	int kswapd_failures;		/* Number of 'reclaimed == 0' runs */
 
+#define KCOMPRESS_FIFO_SIZE 256
+	wait_queue_head_t kcompressd_wait;
+	struct task_struct *kcompressd;
+	struct kfifo *kcompress_fifo;
+	spinlock_t kcompress_fifo_lock;
+
 #ifdef CONFIG_COMPACTION
 	int kcompactd_max_order;
 	enum zone_type kcompactd_highest_zoneidx;
diff --git a/kernel/sysctl.c b/kernel/sysctl.c
index 79e6cb1..5d63de6 100644
--- a/kernel/sysctl.c
+++ b/kernel/sysctl.c
@@ -2031,6 +2031,9 @@ static struct ctl_table kern_table[] = {
 #endif
 };
 
+int vm_kcompressd;	/* diag: default OFF, enable via sysctl vm.kcompressd */
+static int SYSCTL_KCOMPRESS_FIFO_SIZE = KCOMPRESS_FIFO_SIZE;
+
 static struct ctl_table vm_table[] = {
 	{
 		.procname	= "overcommit_memory",
@@ -2081,6 +2084,15 @@ static struct ctl_table vm_table[] = {
 		.extra1		= SYSCTL_ZERO,
 		.extra2		= SYSCTL_TWO_HUNDRED,
 	},
+	{
+		.procname	= "kcompressd",
+		.data		= &vm_kcompressd,
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= &SYSCTL_KCOMPRESS_FIFO_SIZE,
+	},
 #ifdef CONFIG_NUMA
 	{
 		.procname	= "numa_stat",
diff --git a/mm/mm_init.c b/mm/mm_init.c
index e13dce5..7dd634d 100644
--- a/mm/mm_init.c
+++ b/mm/mm_init.c
@@ -1370,6 +1370,7 @@ static void __meminit pgdat_init_internals(struct pglist_data *pgdat)
 	pgdat_init_kcompactd(pgdat);
 
 	init_waitqueue_head(&pgdat->kswapd_wait);
+	init_waitqueue_head(&pgdat->kcompressd_wait);
 	init_waitqueue_head(&pgdat->pfmemalloc_wait);
 
 	for (i = 0; i < NR_VMSCAN_THROTTLE; i++)
-- 
2.55.0.windows.3

