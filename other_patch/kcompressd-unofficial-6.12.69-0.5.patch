 /*
+ * Asynchronous swapout state.
+ *
+ * Kept private to this file as plain globals on purpose: struct pglist_data
+ * belongs to the frozen GKI KABI, so no member may be added to it.  Every
+ * object below is invisible outside this translation unit.
+ */
+static DECLARE_KFIFO(kcompress_fifo, struct folio *, KCOMPRESS_FIFO_SIZE);
+static DEFINE_SPINLOCK(kcompress_fifo_lock);
+static DECLARE_WAIT_QUEUE_HEAD(kcompressd_wait);
+static struct task_struct *kcompressd_task;
+
+/*
+ * do_swapout() - Write a folio to swap space
+ * @folio: The folio to write out
+ *
+ * Writes the folio out, either through zswap or the synchronous write path,
+ * then drops the reference taken when it was queued.
+ */
+static void do_swapout(struct folio *folio)
+{
+	struct writeback_control wbc = {
+		.sync_mode = WB_SYNC_NONE,
+		.nr_to_write = SWAP_CLUSTER_MAX,
+		.range_start = 0,
+		.range_end = LLONG_MAX,
+		.for_reclaim = 1,
+	};
+
+	if (zswap_store(folio)) {
+		folio_unlock(folio);
+	} else {
+		__swap_writepage(folio, &wbc); /* Implies folio_unlock(folio) */
+	}
+
+	folio_put(folio);
+}
+
+/*
+ * kcompressd_store() - Off-load folio compression to kcompressd
+ * @folio: The folio to compress
+ *
+ * Returns true when the folio was handed over to kcompressd, false when the
+ * caller must fall back to the synchronous write path.
+ */
+static bool kcompressd_store(struct folio *folio)
+{
+	unsigned int ret, sysctl_kcompressd = vm_kcompressd;
+	struct folio *head = NULL;
+
+	/* Only kswapd can use kcompressd */
+	if (!current_is_kswapd())
+		return false;
+
+	/* kcompressd must be enabled and running */
+	if (!sysctl_kcompressd || unlikely(!kcompressd_task))
+		return false;
+
+	/* We can only off-load anon folios */
+	if (!folio_test_anon(folio))
+		return false;
+
+	/* Fall back to synchronously return AOP_WRITEPAGE_ACTIVATE */
+	if (!mem_cgroup_zswap_writeback_enabled(folio_memcg(folio)))
+		return false;
+
+	/* Swap device must be sync-efficient */
+	if (!zswap_is_enabled() &&
+	    !data_race(swp_swap_info(folio->swap)->flags & SWP_SYNCHRONOUS_IO))
+		return false;
+
+	/* If the queue is full, swap out the head folio to make space */
+	scoped_guard(spinlock_irqsave, &kcompress_fifo_lock) {
+		if (kfifo_len(&kcompress_fifo) >= sysctl_kcompressd &&
+		    unlikely(!kfifo_out(&kcompress_fifo, &head, 1)))
+			return false;
+	}
+
+	/* Pin the folio until kcompressd has written it out */
+	folio_get(folio);
+
+	ret = kfifo_in(&kcompress_fifo, &folio, 1);
+	if (likely(ret))
+		wake_up_interruptible(&kcompressd_wait);
+	else
+		folio_put(folio);
+
+	if (head)
+		do_swapout(head);
+
+	return ret;
+}
+
