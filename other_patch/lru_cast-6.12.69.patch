@@ -1379,3 +1380,20 @@
 source "mm/damon/Kconfig"
 
 endmenu
+
+config LRU_CAST
+	bool "CAST page replacement"
+	depends on 64BIT && MMU && SPARSEMEM
+	default y
+	help
+	  A replacement for the active/inactive LRU lists: newcomers wait in
+	  a FIFO window, the rest are ranked by their exponentially decayed
+	  read count, kept in buckets of a key that does not change while a
+	  folio is not read (CAST). It keeps a 32-bit word per page
+	  frame, 1/1024 of memory, set up when it first runs.
+
+	  It may be built with the multi-gen LRU; the two are never on at
+	  once. CAST is on at boot unless lru_cast=0 is given, and then the
+	  multi-gen LRU is as LRU_GEN_ENABLED says. At run time, one is
+	  switched off before the other is switched on:
+	  /sys/kernel/mm/lru_cast/enabled, /sys/kernel/mm/lru_gen/enabled.
