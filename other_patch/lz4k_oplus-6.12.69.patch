diff --git a/drivers/block/zram/backend_lz4k_oplus.c b/drivers/block/zram/backend_lz4k_oplus.c
new file mode 100644
--- /dev/null
+++ b/drivers/block/zram/backend_lz4k_oplus.c
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * zram backend for LZ4K_OPLUS (see include/linux/lz4k_oplus.h).
+ *
+ * LZ4K_OPLUS has no dict/level concept, so setup_params/release_params
+ * are no-ops. The per-context mem buffer is the hash table that
+ * lz4k_oplus_compress() works with; it re-zeroes the state on every
+ * call, so there is no cold-start zeroing contract here.
+ */
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/lz4k_oplus.h>
+
+#include "backend_lz4k_oplus.h"
+
+struct lz4k_oplus_ctx {
+	void *mem;
+};
+
+static void lz4k_oplus_release_params(struct zcomp_params *params)
+{
+}
+
+static int lz4k_oplus_setup_params(struct zcomp_params *params)
+{
+	if (params->level == ZCOMP_PARAM_NO_LEVEL)
+		params->level = 0;
+
+	return 0;
+}
+
+static void lz4k_oplus_destroy(struct zcomp_ctx *ctx)
+{
+	struct lz4k_oplus_ctx *zctx = ctx->context;
+
+	if (!zctx)
+		return;
+
+	vfree(zctx->mem);
+	kfree(zctx);
+}
+
+static int lz4k_oplus_create(struct zcomp_params *params, struct zcomp_ctx *ctx)
+{
+	struct lz4k_oplus_ctx *zctx;
+
+	zctx = kzalloc(sizeof(*zctx), GFP_KERNEL);
+	if (!zctx)
+		return -ENOMEM;
+
+	ctx->context = zctx;
+
+	zctx->mem = vmalloc(LZ4K_OPLUS_STATE_BYTES);
+	if (!zctx->mem)
+		goto error;
+
+	return 0;
+
+error:
+	lz4k_oplus_destroy(ctx);
+	return -ENOMEM;
+}
+
+static int lz4kop_compress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			   struct zcomp_req *req)
+{
+	struct lz4k_oplus_ctx *zctx = ctx->context;
+	int ret;
+
+	ret = lz4k_oplus_compress(zctx->mem, req->src, req->dst,
+				  (unsigned int)req->src_len,
+				  (unsigned int)req->dst_len);
+	if (ret < 0) {
+		/*
+		 * Did not fit into the dst budget -- report a full-page length
+		 * so zram_write_page() takes its huge/raw-store path, the same
+		 * not-compressible verdict the other backends give.
+		 */
+		req->dst_len = req->src_len;
+		return 0;
+	}
+	req->dst_len = ret;
+	return 0;
+}
+
+static int lz4kop_decompress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			     struct zcomp_req *req)
+{
+	int ret;
+
+	ret = lz4k_oplus_decompress(req->src, req->dst,
+				    (unsigned int)req->src_len,
+				    (unsigned int)req->dst_len);
+	if (ret <= 0)
+		return -EINVAL;
+	return 0;
+}
+
+const struct zcomp_ops backend_lz4k_oplus = {
+	.compress	= lz4kop_compress,
+	.decompress	= lz4kop_decompress,
+	.create_ctx	= lz4k_oplus_create,
+	.destroy_ctx	= lz4k_oplus_destroy,
+	.setup_params	= lz4k_oplus_setup_params,
+	.release_params	= lz4k_oplus_release_params,
+	.name		= "lz4k_oplus",
+};
