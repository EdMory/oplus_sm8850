diff --git a/include/linux/lz4k_oplus.h b/include/linux/lz4k_oplus.h
new file mode 100644
--- /dev/null
+++ b/include/linux/lz4k_oplus.h
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: Dual BSD/GPL */
+/*
+ * LZ4K_OPLUS compression algorithm -- OPlus's variant of LZ4K.
+ *
+ * Fixed 64KB window, 3-byte token, 5-byte hash and two probes per
+ * skip step: a compression-ratio-oriented encoder that stays in the
+ * same speed class as Huawei's LZ4K. The compressed stream is NOT
+ * compatible with either the lz4k or the lz4kd decoders.
+ *
+ * Imported from SukiSU_patch (other/zram/lz4k_oplus, an OPlus kernel
+ * drop cleaned up by SukiSU) and repackaged as a lib/ library with a
+ * zram backend (drivers/block/zram/backend_lz4k_oplus.c).
+ */
+#ifndef _LZ4K_OPLUS_H
+#define _LZ4K_OPLUS_H
+
+/* scratch (hash table) state lz4k_oplus_compress() needs, in bytes */
+#define LZ4K_OPLUS_STATE_BYTES	(1U << 13)
+
+/**
+ * lz4k_oplus_compress() - Compress data from source to dest
+ * @state: address of the working memory.
+ * @source: source address of the original data
+ * @dest: output buffer address of the compressed data
+ * @source_max: size of the input data. Max supported value is 4KB
+ * @dest_max: full or partial size of buffer 'dest'
+ *	which must be already allocated
+ *
+ * Compresses 'srouce_max' bytes from buffer 'source'
+ * into already allocated 'dest' buffer of size 'maxOutputSize'.
+ * Compression is guaranteed to succeed if
+ * 'dest_max' >= 'source_size'.
+ * If the function cannot compress 'source' into a more limited 'dest' budget,
+ * compression stops *immediately*, and the function result is -1.
+ * As a consequence, 'dest' content is not valid.
+ *
+ * Return: Number of bytes written into buffer 'dest'
+ *	(necessarily <= dest_max) or -1 if compression fails
+ */
+int lz4k_oplus_compress(
+	void *const state,
+	const void *const source,
+	void *dest,
+	unsigned source_max,
+	unsigned dest_max);
+
+/**
+ * LZ4_decompress_safe() - Decompression protected against buffer overflow
+ * @source: source address of the compressed data
+ * @dest: output buffer address of the uncompressed data
+ *	which must be already allocated
+ * @source_max: is the precise full size of the compressed block
+ * @dest_max: is the size of 'dest' buffer
+ *
+ * Decompresses data from 'source' into 'dest'.
+ * If the source stream is detected malformed, the function will
+ * stop decoding and return a negative result.
+ * This function is protected against buffer overflow exploits,
+ * including malicious data packets. It never writes outside output buffer,
+ * nor reads outside input buffer.
+ *
+ * Return: number of bytes decompressed into destination buffer
+ *	(4KB)
+ *	or a negative result in case of error
+ */
+int lz4k_oplus_decompress(
+	const void *const source,
+	void *const dest,
+	unsigned source_max,
+	unsigned dest_max);
+
+#endif /* _LZ4K_OPLUS_H */
