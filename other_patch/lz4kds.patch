+	KUNIT_EXPECT_TRUE(test,
+			crystal_sddc_job_matches_locked(&ctx->sddc, &key, true));
+	crystal_sddc_slot_unlock(&ctx->zram, key.index);
+	KUNIT_EXPECT_FALSE(test, crystal_sddc_state_identity_changed(&ctx->sddc,
