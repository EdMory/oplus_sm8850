+static inline char chs_log_level_char(int level)
+{
+	switch (level) {
+	case CHS_LOG_ERR:
+		return 'E';
+	case CHS_LOG_WARN:
+		return 'W';
+	case CHS_LOG_INFO:
+		return 'I';
+	case CHS_LOG_DEBUG:
+		return 'D';
+	default:
+		return '?';
+	}
+}
