+static int memcg_parse_uint_token(const char *token, unsigned int *val)
+{
+	const char *value;
+
+	if (!token || !val)
+		return -EINVAL;
+
+	value = strchr(token, '=');
+	if (value)
+		value++;
+	else
+		value = token;
+
+	return kstrtouint(value, 0, val);
