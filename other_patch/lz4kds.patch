+	stats->bd_compressed_bytes =
+		atomic64_read(&zram->stats.bd_compr_data_size);
+	stats->bd_read_pages = atomic64_read(&zram->stats.bd_reads);
+	stats->bd_write_pages = atomic64_read(&zram->stats.bd_writes);
