+/* crystal_sddc_zram_memory_limit_ok 实现已归位 sddc/crystal_sddc.c */
+
+static void zram_atomic64_update_max(atomic64_t *max, s64 val)
+{
+	s64 old;
+
+	if (val <= 0)
+		return;
+
+	old = atomic64_read(max);
+	while (old < val) {
+		s64 prev = atomic64_cmpxchg(max, old, val);
+
+		if (prev == old)
+			break;
+		old = prev;
+	}
+}
