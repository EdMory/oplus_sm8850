+	stats->batchin_zms_items =
+		atomic64_read(&zram->stats.batchin_zms_items);
+	stats->batchin_zms_read_ios =
+		atomic64_read(&zram->stats.batchin_zms_read_ios);
+	stats->prefetch_runs = atomic64_read(&zram->stats.prefetch_runs);
