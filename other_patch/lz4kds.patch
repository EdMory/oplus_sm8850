+static inline unsigned int crystal_hybridswap_u64_percent(u64 val, u64 total)
+{
+	u64 percent;
+
+	if (!total)
+		return 0;
+
+	percent = mul_u64_u64_div_u64(val, 100, total);
+	return percent > UINT_MAX ? UINT_MAX : (unsigned int)percent;
+}
