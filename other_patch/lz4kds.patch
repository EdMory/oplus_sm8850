+void zram_memcg_stats_sub_current(struct zram *zram, u32 index)
+{
+	struct zram_memcg_account account;
+
+	zram_memcg_account_snapshot(zram, index, &account);
+	zram_memcg_stats_apply(zram, &account, false);
+}
