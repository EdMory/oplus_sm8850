+	KUNIT_ASSERT_EQ(test, mc16_zh_reserve(s, 1, false), 0);
+	/* A live entry naturally advances the cursor past all used IDs. */
+	KUNIT_EXPECT_EQ(test, mc16_meta_shrinker_scan(NULL, &sc), 0UL);
