+/* Reuse the real slots, resetting observers only, for each exit/flag pair. */
+static void mc16_test_walk_reset(struct mc16_test_walk *f)
+{
+	f->flushes = 0;
+	f->restores = 0;
+	f->yields = 0;
+	f->probes = 0;
+	f->slice = 0;
+	f->scans = 0;
+	f->last_cursor = 0;
+	f->last_token = 0;
+	f->bad_scope = false;
+	f->bad_ref = false;
+	f->bad_budget = false;
+	f->dirty_scan = false;
+	f->interrupted = false;
+	f->stop = MC16_WALK_STOP_NONE;
+	f->fail_flush = 0;
+	f->fail_restore = 0;
+}
+
+static void memcomp_test_swapoff_walk_exits(struct kunit *test)
+{
+	static const struct {
+		unsigned int flush, restore;
+		enum mc16_test_walk_stop stop;
+		int result;
+		unsigned int probes, restores, flushes, yields;
+	} cases[] = {
+		{ 1, 0, MC16_WALK_STOP_NONE, -EIO, 0, 0, 1, 0 },
+		{ 2, 0, MC16_WALK_STOP_NONE, -EIO, 32, 32, 2, 1 },
+		{ 0, 3, MC16_WALK_STOP_NONE, -ENOMEM, 3, 3, 1, 0 },
+		{ 1, 0, MC16_WALK_STOP_BEFORE_SCAN, -EIO, 0, 0, 1, 0 },
+		{ 0, 1, MC16_WALK_STOP_AFTER_RESTORE, -ENOMEM, 1, 1, 1, 0 },
+		{ 0, 0, MC16_WALK_STOP_BEFORE_SCAN, -EINTR, 0, 0, 1, 0 },
+		{ 0, 0, MC16_WALK_STOP_AFTER_SCAN, -EINTR, 1, 0, 1, 0 },
+		{ 0, 0, MC16_WALK_STOP_AFTER_RESTORE, -EINTR, 1, 1, 1, 0 },
+		{ 0, 0, MC16_WALK_STOP_UNLOCKED, -EINTR, 32, 32, 2, 1 },
+		{ 0, 0, MC16_WALK_STOP_NONE, 0, 33, 33, 2, 1 },
+		{ 0, 0, MC16_WALK_STOP_EOF, 0, 33, 33, 2, 1 },
+	};
+	static const unsigned int nested[] = {
+		0, PF_MEMALLOC_NOFS, PF_MEMALLOC, MC16_WALK_TEST_FLAGS,
+	};
+	struct mc16_test_walk *f = mc16_test_walk_begin(test);
+	unsigned int i, j;
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_EQ(test, mc16_test_walk_reserve(f, 33), 0);
+	for (i = 0; i < ARRAY_SIZE(nested); i++) {
+		for (j = 0; j < ARRAY_SIZE(cases); j++) {
+			mc16_test_walk_reset(f);
+			f->fail_flush = cases[j].flush;
+			f->fail_restore = cases[j].restore;
+			f->stop = cases[j].stop;
+			f->interrupted = f->stop == MC16_WALK_STOP_BEFORE_SCAN;
+			ret = mc16_test_walk_run(test, f, nested[i]);
+			KUNIT_EXPECT_EQ(test, ret, cases[j].result);
+			KUNIT_EXPECT_EQ(test, f->probes, cases[j].probes);
+			KUNIT_EXPECT_EQ(test, f->restores, cases[j].restores);
+			KUNIT_EXPECT_EQ(test, f->flushes, cases[j].flushes);
+			KUNIT_EXPECT_EQ(test, f->yields, cases[j].yields);
+		}
+	}
+}
+#endif /* CONFIG_MEMCG && CONFIG_SWAP */
+#endif /* _MM_MEMCOMP_TESTS_SWAPOFF_WALK_TEST_H */
diff --git a/mm/memcomp/tests/swapoff_yield_test.h b/mm/memcomp/tests/swapoff_yield_test.h
new file mode 100644
index 0000000..ea5f714
--- /dev/null
+++ b/mm/memcomp/tests/swapoff_yield_test.h
@@ -0,0 +1,532 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_SWAPOFF_YIELD_TEST_H
+#define _MM_MEMCOMP_TESTS_SWAPOFF_YIELD_TEST_H
+
+#if defined(CONFIG_SWAP) && defined(CONFIG_MEMCOMP_KUNIT_TEST)
+#include <kunit/resource.h>
+#include <kunit/test.h>
+#include <linux/completion.h>
+#include <linux/kthread.h>
+#include <linux/rcupdate.h>
+#include <linux/sched/signal.h>
+
+/*
+ * Include after memcomp_swapoff(), independently of suite.h. Exercise
+ * the production walk with real XA lookups, temporary krefs and mutexes. Only
+ * the device flush/restore edges use fixture callbacks. STORED misses still
+ * run memcomp_swapoff_entry(); no synthetic backing reaches physical IO.
+ *
+ * The writer actually acquires W. It checks refs before replacing future and
+ * already-scanned objects, then leaves both staging and plugged IO pending.
+ * Every subsequent lookup must observe a flush. Disabling the unlock, skipping
+ * the flush, resetting the cursor, counting only conversions, or retaining a
+ * temporary reference must fail these assertions, independently of a counter
+ * that merely claims that a yield happened.
+ */
+#define MEMCOMP_YIELD_TEST_OBJECTS 72
+#define MEMCOMP_YIELD_TEST_FLAGS (PF_MEMALLOC_NOFS | PF_MEMALLOC)
+
+struct memcomp_yield_test {
+	struct xarray tree;
+	/* Serializes the tree walker with fixture object updates. */
+	struct mutex lock;
+	struct memcomp_entry objects[MEMCOMP_YIELD_TEST_OBJECTS];
+	unsigned long keys[MEMCOMP_YIELD_TEST_OBJECTS];
+	unsigned int visits[MEMCOMP_YIELD_TEST_OBJECTS];
+	unsigned int nr;
+	struct memcomp_swapoff_yield_hooks hooks;
+	struct completion writer_start;
+	struct completion writer_attempting;
+	struct completion writer_done;
+	struct completion walker_done;
+	struct task_struct *writer;
+	struct task_struct *walker;
+	unsigned int scans;
+	unsigned int restores;
+	unsigned int yields;
+	unsigned int flushes;
+	unsigned int settlements;
+	unsigned int writer_at_scan;
+	unsigned int flags_before;
+	unsigned int flags_after;
+	unsigned int fail_flush;
+	unsigned int fail_restore;
+	unsigned int signal_flush;
+	unsigned int signal_scan;
+	unsigned long last_key;
+	int restore_result;
+	int result;
+	int writer_error;
+	bool want_writer;
+	bool dying;
+	bool sparse;
+	bool nested;
+	bool signal_writer;
+	bool cancel;
+	bool timed_out;
+	bool bad_ref;
+	bool bad_scope;
+	bool dirty_scan;
+	bool staging;
+	bool plugged;
+	bool writer_acquired;
+};
+
+static void memcomp_yield_test_destroy(void *data)
+{
+	struct memcomp_yield_test *f = data;
+
+	xa_destroy(&f->tree);
+}
+
+static struct memcomp_yield_test *
+memcomp_yield_test_alloc(struct kunit *test, unsigned int nr, bool dying)
+{
+	struct memcomp_yield_test *f;
+	unsigned int i;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	xa_init(&f->tree);
+	mutex_init(&f->lock);
+	init_completion(&f->writer_start);
+	init_completion(&f->writer_attempting);
+	init_completion(&f->writer_done);
+	init_completion(&f->walker_done);
+	if (kunit_add_action_or_reset(test, memcomp_yield_test_destroy, f))
+		return NULL;
+	f->nr = nr;
+	f->dying = dying;
+	/* The initial acquisition also has to flush, even on an empty index. */
+	f->staging = true;
+	f->plugged = true;
+	for (i = 0; i < ARRAY_SIZE(f->objects); i++) {
+		struct memcomp_entry *entry = &f->objects[i];
+
+		f->keys[i] = 1 + 3 * i;
+		entry->token = f->keys[i];
+		entry->state = MC_STORED;
+		kref_init(&entry->refcount);
+		if (dying)
+			refcount_set(&entry->refcount.refcount, 0);
+	}
+	for (i = 0; i < nr; i++) {
+		if (xa_err(xa_store(&f->tree, f->keys[i], &f->objects[i],
+				    GFP_KERNEL)))
+			return NULL;
+	}
+	return f;
+}
+
+static int memcomp_yield_test_flush(void *data)
+{
+	struct memcomp_yield_test *f = data;
+
+	lockdep_assert_held(&f->lock);
+	f->flushes++;
+	if (f->staging || f->plugged)
+		f->settlements++;
+	f->staging = false;
+	f->plugged = false;
+	if (f->signal_flush == f->flushes)
+		send_sig(SIGUSR1, current, 0);
+	return f->fail_flush == f->flushes ? -EIO : 0;
+}
+
+static int memcomp_yield_test_restore(struct memcomp_entry *entry,
+				      unsigned int type, void *data)
+{
+	struct memcomp_yield_test *f = data;
+	unsigned int object = entry - f->objects;
+	int ret;
+
+	lockdep_assert_held(&f->lock);
+	f->restores++;
+	if (object >= ARRAY_SIZE(f->objects))
+		return -EINVAL;
+	f->visits[object]++;
+	if (f->fail_restore == f->restores)
+		return -ENOMEM;
+	/* All-miss cases execute the actual entry restore's state rejection. */
+	ret = memcomp_swapoff_entry(entry, type, &memcomp_swapoff_ops);
+	return ret ? ret : f->restore_result;
+}
+
+static void memcomp_yield_test_scanned(struct memcomp_entry *entry,
+				       unsigned long key, void *data)
+{
+	struct memcomp_yield_test *f = data;
+
+	lockdep_assert_held(&f->lock);
+	WRITE_ONCE(f->scans, f->scans + 1);
+	f->last_key = key;
+	if (f->staging || f->plugged)
+		f->dirty_scan = true;
+	if ((current->flags & MEMCOMP_YIELD_TEST_FLAGS) !=
+	    MEMCOMP_YIELD_TEST_FLAGS)
+		f->bad_scope = true;
+	if (entry && kref_read(&entry->refcount) != 2)
+		f->bad_ref = true;
+	if (f->signal_scan == f->scans)
+		send_sig(SIGUSR1, current, 0);
+	if (f->want_writer && f->scans == 32) {
+		complete(&f->writer_start);
+		/* The writer must try W while the scanner still owns it. */
+		if (!wait_for_completion_timeout(&f->writer_attempting, 2 * HZ)) {
+			f->timed_out = true;
+			send_sig(SIGUSR1, current, 0);
+		}
+	}
+}
+
+static void memcomp_yield_test_unlocked(void *data)
+{
+	struct memcomp_yield_test *f = data;
+
+	f->yields++;
+	if ((current->flags & MEMCOMP_YIELD_TEST_FLAGS) !=
+	    MEMCOMP_YIELD_TEST_FLAGS)
+		f->bad_scope = true;
+	/* Observe real writer progress before the scanner reacquires W. */
+	if (f->want_writer && f->yields == 1 &&
+	    !wait_for_completion_timeout(&f->writer_done, 2 * HZ)) {
+		f->timed_out = true;
+		send_sig(SIGUSR1, current, 0);
+	}
+}
+
+static int memcomp_yield_test_writer(void *data)
+{
+	struct memcomp_yield_test *f = data;
+	unsigned int i;
+
+	wait_for_completion(&f->writer_start);
+	if (READ_ONCE(f->cancel))
+		goto done;
+	complete(&f->writer_attempting);
+	mutex_lock(&f->lock);
+	f->writer_acquired = true;
+	f->writer_at_scan = READ_ONCE(f->scans);
+	for (i = 0; i < f->nr; i++) {
+		if (kref_read(&f->objects[i].refcount) != !f->dying)
+			f->bad_ref = true;
+	}
+	if (f->sparse) {
+		/* Reuse a visited key, replace a future object, remove the tail. */
+		f->writer_error = xa_err(xa_store(&f->tree, 16,
+						  &f->objects[34], GFP_KERNEL));
+		if (!f->writer_error)
+			f->writer_error = xa_err(xa_store(&f->tree, 4096,
+							  &f->objects[35], GFP_KERNEL));
+		xa_erase(&f->tree, f->keys[31]);
+	}
+	f->staging = true;
+	f->plugged = true;
+	if (f->signal_writer)
+		send_sig(SIGUSR1, f->walker, 0);
+	mutex_unlock(&f->lock);
+done:
+	complete(&f->writer_done);
+	return 0;
+}
+
+static int memcomp_yield_test_walker(void *data)
+{
+	struct memcomp_yield_test *f = data;
+	unsigned int nofs = 0, noreclaim = 0;
+
+	allow_signal(SIGUSR1);
+	if (f->nested) {
+		nofs = memalloc_nofs_save();
+		noreclaim = memalloc_noreclaim_save();
+	}
+	f->flags_before = current->flags & MEMCOMP_YIELD_TEST_FLAGS;
+	f->hooks.task = current;
+	rcu_assign_pointer(memcomp_swapoff_yield_active, &f->hooks);
+	f->result = memcomp_swapoff(0);
+	rcu_assign_pointer(memcomp_swapoff_yield_active, NULL);
+	f->flags_after = current->flags & MEMCOMP_YIELD_TEST_FLAGS;
+	if (f->nested) {
+		memalloc_noreclaim_restore(noreclaim);
+		memalloc_nofs_restore(nofs);
+	}
+	flush_signals(current);
+	/* Retire readers that fetched active before the task identity check. */
+	synchronize_rcu();
+	complete(&f->walker_done);
+	return 0;
+}
+
+/* No assertion may abort this helper while either thread still owns f. */
+static void memcomp_yield_test_run(struct kunit *test,
+				   struct memcomp_yield_test *f)
+{
+	unsigned int i;
+
+	KUNIT_ASSERT_PTR_EQ(test,
+			    rcu_access_pointer(memcomp_swapoff_yield_active), NULL);
+	f->hooks = (struct memcomp_swapoff_yield_hooks) {
+		.entries = &f->tree,
+		.lock = &f->lock,
+		.flush = memcomp_yield_test_flush,
+		.restore = memcomp_yield_test_restore,
+		.scanned = memcomp_yield_test_scanned,
+		.unlocked = memcomp_yield_test_unlocked,
+		.ctx = f,
+	};
+	if (f->want_writer) {
+		f->writer = kthread_create(memcomp_yield_test_writer, f,
+					   "mc-swapoff-writer");
+		if (IS_ERR(f->writer)) {
+			KUNIT_FAIL(test, "cannot create writer: %ld",
+				   PTR_ERR(f->writer));
+			return;
+		}
+		get_task_struct(f->writer);
+		wake_up_process(f->writer);
+	}
+	f->walker = kthread_create(memcomp_yield_test_walker, f,
+				   "mc-swapoff-walker");
+	if (IS_ERR(f->walker)) {
+		KUNIT_FAIL(test, "cannot create walker: %ld", PTR_ERR(f->walker));
+		goto stop_writer;
+	}
+	get_task_struct(f->walker);
+	wake_up_process(f->walker);
+	if (!wait_for_completion_timeout(&f->walker_done, 6 * HZ)) {
+		f->timed_out = true;
+		send_sig(SIGUSR1, f->walker, 0);
+	}
+	kthread_stop(f->walker);
+	put_task_struct(f->walker);
+stop_writer:
+	WRITE_ONCE(f->cancel, true);
+	complete_all(&f->writer_start);
+	if (f->want_writer) {
+		kthread_stop(f->writer);
+		put_task_struct(f->writer);
+	}
+	KUNIT_EXPECT_PTR_EQ(test,
+			    rcu_access_pointer(memcomp_swapoff_yield_active), NULL);
+	KUNIT_EXPECT_FALSE(test, f->timed_out);
+	KUNIT_EXPECT_FALSE(test, f->bad_ref);
+	KUNIT_EXPECT_FALSE(test, f->bad_scope);
+	KUNIT_EXPECT_FALSE(test, f->dirty_scan);
+	KUNIT_EXPECT_EQ(test, f->writer_error, 0);
+	KUNIT_EXPECT_EQ(test, f->flags_before, f->flags_after);
+	KUNIT_EXPECT_FALSE(test, mutex_is_locked(&f->lock));
+	for (i = 0; i < ARRAY_SIZE(f->objects); i++)
+		KUNIT_EXPECT_EQ_MSG(test, kref_read(&f->objects[i].refcount),
+				    (unsigned int)!f->dying, "object %u", i);
+}
+
+static void memcomp_test_swapoff_yield_all_miss(struct kunit *test)
+{
+	struct memcomp_yield_test *f = memcomp_yield_test_alloc(test, 65, false);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	f->want_writer = true;
+	memcomp_yield_test_run(test, f);
+	KUNIT_EXPECT_EQ(test, f->result, 0);
+	KUNIT_EXPECT_EQ(test, f->scans, 65U);
+	KUNIT_EXPECT_EQ(test, f->restores, 65U);
+	KUNIT_EXPECT_EQ(test, f->yields, 2U);
+	KUNIT_EXPECT_EQ(test, f->flushes, 3U);
+	KUNIT_EXPECT_EQ(test, f->settlements, 2U);
+	KUNIT_EXPECT_TRUE(test, f->writer_acquired);
+	KUNIT_EXPECT_EQ(test, f->writer_at_scan, 32U);
+}
+
+static void memcomp_test_swapoff_yield_dying(struct kunit *test)
+{
+	struct memcomp_yield_test *f = memcomp_yield_test_alloc(test, 65, true);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	f->want_writer = true;
+	memcomp_yield_test_run(test, f);
+	KUNIT_EXPECT_EQ(test, f->result, 0);
+	KUNIT_EXPECT_EQ(test, f->scans, 65U);
+	KUNIT_EXPECT_EQ(test, f->restores, 0U);
+	KUNIT_EXPECT_EQ(test, f->yields, 2U);
+	KUNIT_EXPECT_EQ(test, f->flushes, 3U);
+	KUNIT_EXPECT_TRUE(test, f->writer_acquired);
+	KUNIT_EXPECT_EQ(test, f->writer_at_scan, 32U);
+}
+
+static void memcomp_test_swapoff_yield_cursor(struct kunit *test)
+{
+	struct memcomp_yield_test *f = memcomp_yield_test_alloc(test, 34, false);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	xa_erase(&f->tree, f->keys[32]);
+	xa_erase(&f->tree, f->keys[33]);
+	f->objects[32].token = 4096;
+	f->keys[32] = 4096;
+	f->objects[33].token = UINT_MAX;
+	f->keys[33] = UINT_MAX;
+	f->objects[34].token = 16;
+	f->objects[35].token = 4096;
+	KUNIT_ASSERT_EQ(test, xa_err(xa_store(&f->tree, 4096,
+					      &f->objects[32], GFP_KERNEL)), 0);
+	KUNIT_ASSERT_EQ(test, xa_err(xa_store(&f->tree, UINT_MAX,
+					      &f->objects[33], GFP_KERNEL)), 0);
+	f->want_writer = true;
+	f->sparse = true;
+	memcomp_yield_test_run(test, f);
+	KUNIT_EXPECT_EQ(test, f->result, 0);
+	KUNIT_EXPECT_EQ(test, f->scans, 34U);
+	KUNIT_EXPECT_EQ(test, f->yields, 1U);
+	KUNIT_EXPECT_EQ(test, f->last_key, (unsigned long)UINT_MAX);
+	KUNIT_EXPECT_EQ(test, f->visits[5], 1U);
+	KUNIT_EXPECT_EQ(test, f->visits[32], 0U);
+	KUNIT_EXPECT_EQ(test, f->visits[33], 1U);
+	KUNIT_EXPECT_EQ(test, f->visits[34], 0U);
+	KUNIT_EXPECT_EQ(test, f->visits[35], 1U);
+	KUNIT_EXPECT_TRUE(test, f->writer_acquired);
+	KUNIT_EXPECT_EQ(test, f->writer_at_scan, 32U);
+}
+
+static void memcomp_test_swapoff_yield_flush_error(struct kunit *test)
+{
+	unsigned int flush;
+
+	for (flush = 1; flush <= 2; flush++) {
+		struct memcomp_yield_test *f =
+			memcomp_yield_test_alloc(test, 65, false);
+
+		KUNIT_ASSERT_NOT_NULL(test, f);
+		f->fail_flush = flush;
+		f->want_writer = flush == 2;
+		f->nested = flush == 2;
+		memcomp_yield_test_run(test, f);
+		KUNIT_EXPECT_EQ(test, f->result, -EIO);
+		KUNIT_EXPECT_EQ(test, f->flushes, flush);
+		KUNIT_EXPECT_EQ(test, f->scans, flush == 1 ? 0U : 32U);
+		KUNIT_EXPECT_EQ(test, f->yields, flush - 1);
+		KUNIT_EXPECT_FALSE(test, f->staging);
+		KUNIT_EXPECT_FALSE(test, f->plugged);
+	}
+}
+
+static void memcomp_test_swapoff_yield_signal(struct kunit *test)
+{
+	unsigned int phase;
+
+	for (phase = 0; phase < 4; phase++) {
+		struct memcomp_yield_test *f =
+			memcomp_yield_test_alloc(test, phase == 3 ? 0 : 65, false);
+
+		KUNIT_ASSERT_NOT_NULL(test, f);
+		if (phase == 0 || phase == 3) {
+			f->signal_flush = 1;
+		} else if (phase == 1) {
+			f->signal_scan = 1;
+		} else {
+			f->want_writer = true;
+			f->signal_writer = true;
+		}
+		memcomp_yield_test_run(test, f);
+		KUNIT_EXPECT_EQ(test, f->result, -EINTR);
+		KUNIT_EXPECT_EQ(test, f->scans,
+				phase == 1 ? 1U : phase == 2 ? 32U : 0U);
+		if (phase == 2) {
+			KUNIT_EXPECT_TRUE(test, f->writer_acquired);
+			KUNIT_EXPECT_EQ(test, f->flushes, 2U);
+			KUNIT_EXPECT_FALSE(test, f->staging);
+			KUNIT_EXPECT_FALSE(test, f->plugged);
+		}
+	}
+}
+
+static void memcomp_test_swapoff_yield_positive_status(struct kunit *test)
+{
+	struct memcomp_yield_test *f = memcomp_yield_test_alloc(test, 33, false);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	f->restore_result = 1;
+	memcomp_yield_test_run(test, f);
+	KUNIT_EXPECT_EQ(test, f->result, 0);
+	KUNIT_EXPECT_EQ(test, f->restores, 33U);
+	KUNIT_EXPECT_EQ(test, f->yields, 1U);
+}
+
+static void memcomp_test_swapoff_yield_restore_error(struct kunit *test)
+{
+	struct memcomp_yield_test *f = memcomp_yield_test_alloc(test, 33, false);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	f->fail_restore = 12;
+	f->restore_result = 1;
+	memcomp_yield_test_run(test, f);
+	KUNIT_EXPECT_EQ(test, f->result, -ENOMEM);
+	KUNIT_EXPECT_EQ(test, f->scans, 12U);
+	KUNIT_EXPECT_EQ(test, f->restores, 12U);
+	KUNIT_EXPECT_EQ(test, f->yields, 0U);
+}
+
+static void memcomp_test_swapoff_yield_budget(struct kunit *test)
+{
+	static const unsigned int counts[] = { 0, 31, 32, 33 };
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(counts); i++) {
+		struct memcomp_yield_test *f =
+			memcomp_yield_test_alloc(test, counts[i], false);
+
+		KUNIT_ASSERT_NOT_NULL(test, f);
+		f->nested = i & 1;
+		memcomp_yield_test_run(test, f);
+		KUNIT_EXPECT_EQ(test, f->result, 0);
+		KUNIT_EXPECT_EQ(test, f->scans, counts[i]);
+		KUNIT_EXPECT_EQ(test, f->yields, counts[i] / 32);
+		KUNIT_EXPECT_EQ(test, f->flushes, 1 + counts[i] / 32);
+	}
+}
+
+static void memcomp_test_swapoff_yield_uint_max(struct kunit *test)
+{
+	unsigned int signal;
+
+	for (signal = 0; signal <= 1; signal++) {
+		struct memcomp_yield_test *f =
+			memcomp_yield_test_alloc(test, 32, false);
+
+		KUNIT_ASSERT_NOT_NULL(test, f);
+		xa_erase(&f->tree, f->keys[31]);
+		f->objects[31].token = UINT_MAX;
+		f->keys[31] = UINT_MAX;
+		KUNIT_ASSERT_EQ(test, xa_err(xa_store(&f->tree, UINT_MAX,
+						      &f->objects[31], GFP_KERNEL)), 0);
+		f->restore_result = 1;
+		f->signal_scan = signal ? 32 : 0;
+		memcomp_yield_test_run(test, f);
+		KUNIT_EXPECT_EQ(test, f->result, signal ? -EINTR : 0);
+		KUNIT_EXPECT_EQ(test, f->scans, 32U);
+		KUNIT_EXPECT_EQ(test, f->last_key, (unsigned long)UINT_MAX);
+		KUNIT_EXPECT_EQ(test, f->yields, 0U);
+		KUNIT_EXPECT_EQ(test, f->flushes, 1U);
+	}
+}
+
+static struct kunit_case memcomp_swapoff_yield_test_cases[] = {
+	KUNIT_CASE(memcomp_test_swapoff_yield_all_miss),
+	KUNIT_CASE(memcomp_test_swapoff_yield_dying),
+	KUNIT_CASE(memcomp_test_swapoff_yield_cursor),
+	KUNIT_CASE(memcomp_test_swapoff_yield_flush_error),
+	KUNIT_CASE(memcomp_test_swapoff_yield_signal),
+	KUNIT_CASE(memcomp_test_swapoff_yield_positive_status),
+	KUNIT_CASE(memcomp_test_swapoff_yield_restore_error),
+	KUNIT_CASE(memcomp_test_swapoff_yield_budget),
+	KUNIT_CASE(memcomp_test_swapoff_yield_uint_max),
+	{}
+};
+
+static struct kunit_suite memcomp_swapoff_yield_test_suite = {
+	.name = "memcomp-swapoff-yield",
+	.test_cases = memcomp_swapoff_yield_test_cases,
+};
+
+kunit_test_suite(memcomp_swapoff_yield_test_suite);
+#endif /* CONFIG_SWAP && CONFIG_MEMCOMP_KUNIT_TEST */
+#endif /* _MM_MEMCOMP_TESTS_SWAPOFF_YIELD_TEST_H */
diff --git a/mm/memcomp/tests/test_api.h b/mm/memcomp/tests/test_api.h
new file mode 100644
index 0000000..712e1e3
--- /dev/null
+++ b/mm/memcomp/tests/test_api.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_TEST_API_H
+#define _MM_MEMCOMP_TESTS_TEST_API_H
+
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+struct memcomp_record_info {
+	u64 allocated_bytes;
+	u64 charged_bytes;
+	unsigned int members;
+};
+
+static inline void *
+memcomp_test_record_alloc(struct folio *folio, unsigned int nr_pages)
+{
+	return mc16_record_alloc(folio, nr_pages, false);
+}
+
+static inline struct memcomp_record_info
+memcomp_test_record_info(void *handle)
+{
+	struct mc16_record *record = handle;
+
+	return (struct memcomp_record_info) {
+		.allocated_bytes = record->alloc_bytes,
+		.charged_bytes = record->charge_bytes,
+		.members = refcount_read(&record->members),
+	};
+}
+
+static inline void memcomp_test_record_put(void *handle)
+{
+	mc16_record_member_put(handle);
+}
+
+static inline void memcomp_test_record_handle_abort(void *handle)
+{
+	mc16_record_abort(handle);
+}
+#endif
+
+#endif /* _MM_MEMCOMP_TESTS_TEST_API_H */
diff --git a/mm/memcomp/tests/transport_reclaim_test.h b/mm/memcomp/tests/transport_reclaim_test.h
new file mode 100644
index 0000000..b9cba41
--- /dev/null
+++ b/mm/memcomp/tests/transport_reclaim_test.h
@@ -0,0 +1,298 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included once inside workingset_load_test.h's existing swap/scope guard. */
+struct mc16_tr {
+	struct kunit *test;
+	struct folio *folio[2]; /* Allocation refs only; [1] is the keeper. */
+	struct swap_info_struct *si[2];
+	swp_entry_t swap[2];
+	struct xa_node *leaf; /* Compare only; dereference current cursors under XA. */
+	bool reserved[2], held[2], handed;
+	bool shadow, empty;
+};
+
+static void mc16_tr_cleanup(void *data)
+{
+	struct mc16_tr *f = data;
+	unsigned char map[2] = { };
+	bool checked[2] = { }, marked[2] = { };
+	unsigned int i;
+
+	if (!f->swap[0].val && !f->swap[1].val)
+		return;
+	lru_add_drain_all();
+	disable_swap_slots_cache_lock();
+	/* Target first: keep the keeper and its slot alive through the oracle. */
+	for (i = 0; i < 2; i++) {
+		struct folio *folio = f->folio[i];
+		swp_entry_t entry = f->swap[i];
+
+		f->folio[i] = NULL;
+		/* Reclaim consumed the old isolation ref, even on putback. */
+		if (!folio && !i && f->handed)
+			folio = swap_cache_get_folio(entry, NULL, 0);
+		if (folio) {
+			folio_lock(folio);
+			folio_wait_writeback(folio);
+			if (folio_test_swapcache(folio))
+				delete_from_swap_cache(folio);
+			folio_unlock(folio);
+			folio_put(folio);
+		}
+		if (f->reserved[i])
+			swapcache_free_entries(&entry, 1);
+		if (f->held[i])
+			swap_free(f->swap[i]);
+		if (f->si[i]) {
+			map[i] = READ_ONCE(f->si[i]->swap_map[swp_offset(f->swap[i])]);
+			marked[i] = swap_memcomp_transport_test(f->si[i],
+								swp_offset(f->swap[i]));
+			checked[i] = true;
+			put_swap_device(f->si[i]);
+			f->si[i] = NULL;
+		}
+		f->reserved[i] = false;
+		f->held[i] = false;
+		f->swap[i].val = 0;
+	}
+	f->handed = false;
+	reenable_swap_slots_cache_unlock();
+	for (i = 0; i < 2; i++) {
+		if (!checked[i])
+			continue;
+		kunit_info(f->test, "transport reclaim cleanup: index=%u map=%u marked=%d",
+			   i, map[i], marked[i]);
+		KUNIT_EXPECT_EQ(f->test, map[i], (unsigned char)0);
+		KUNIT_EXPECT_FALSE(f->test, marked[i]);
+	}
+}
+
+static int mc16_tr_alloc(struct mc16_tr *f, bool transport)
+{
+	unsigned int i;
+	int nr, ret = 0;
+
+	if (!READ_ONCE(mc16_kunit_real_swap))
+		return -EINVAL;
+	if (transport) {
+		mutex_lock(&memcomp_writeback_lock);
+		if (memcomp_writeback_slots_free) {
+			mutex_unlock(&memcomp_writeback_lock);
+			return -EBUSY;
+		}
+		for (i = 0; i < 2; i++) {
+			ret = memcomp_swap_folio_alloc(&f->folio[i], &f->swap[i]);
+			if (ret)
+				break;
+			f->held[i] = true;
+		}
+		memcomp_writeback_slots_return();
+		mutex_unlock(&memcomp_writeback_lock);
+		for (i = 0; i < 2; i++)
+			if (f->folio[i])
+				folio_unlock(f->folio[i]);
+		if (ret)
+			return ret;
+	} else {
+		nr = get_swap_pages(2, f->swap, 0);
+		for (i = 0; i < nr; i++)
+			f->reserved[i] = true;
+		if (nr != 2)
+			return -ENOSPC;
+	}
+	for (i = 0; i < 2; i++) {
+		f->si[i] = get_swap_device(f->swap[i]);
+		if (!f->si[i])
+			return -ENODEV;
+		if (transport)
+			continue;
+		f->folio[i] = folio_alloc(GFP_HIGHUSER_MOVABLE, 0);
+		if (!f->folio[i])
+			return -ENOMEM;
+		folio_lock(f->folio[i]);
+		__folio_set_swapbacked(f->folio[i]);
+		ret = add_to_swap_cache(f->folio[i], f->swap[i], GFP_KERNEL, NULL);
+		if (!ret) {
+			f->reserved[i] = false;
+			ret = swap_duplicate(f->swap[i]);
+			if (!ret)
+				f->held[i] = true;
+		}
+		folio_unlock(f->folio[i]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int mc16_tr_prepare(struct mc16_tr *f, const void *src, unsigned int i)
+{
+	struct folio *folio = f->folio[i];
+	struct writeback_control wbc = { .sync_mode = WB_SYNC_ALL };
+	void *dst;
+	int ret;
+
+	folio_lock(folio);
+	/* Balance the initial uncharged cache stats before charging. */
+	delete_from_swap_cache(folio); /* The held slot ref stays live. */
+	ret = mem_cgroup_charge(folio, &init_mm, GFP_KERNEL);
+	if (ret)
+		goto unlock;
+	if (!mem_cgroup_disabled() && folio_memcg(folio) != root_mem_cgroup) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+	ret = mem_cgroup_try_charge_swap(folio, f->swap[i]);
+	if (ret)
+		goto unlock;
+	ret = swapcache_prepare(f->swap[i], 1);
+	if (ret)
+		goto unlock;
+	ret = add_to_swap_cache(folio, f->swap[i], GFP_KERNEL, NULL);
+	if (ret) {
+		put_swap_folio(folio, f->swap[i]);
+		goto unlock;
+	}
+	dst = kmap_local_folio(folio, 0);
+	memcpy(dst, src, PAGE_SIZE);
+	kunmap_local(dst);
+	__folio_mark_uptodate(folio);
+	if (i)
+		goto unlock;
+	ret = swap_writepage(&folio->page, &wbc);
+	if (ret) {
+		if (folio_test_locked(folio))
+			folio_unlock(folio);
+		return ret;
+	}
+	folio_lock(folio);
+	folio_wait_writeback(folio);
+	if (folio_test_dirty(folio) || !folio_test_swapcache(folio) ||
+	    !folio_test_uptodate(folio))
+		ret = -EIO;
+unlock:
+	folio_unlock(folio);
+	return ret;
+}
+
+/* Actual cursors, not just adjacent offsets; never write XA internals. */
+static bool mc16_tr_leaf(struct mc16_tr *f, bool after)
+{
+	struct address_space *mapping = swap_address_space(f->swap[0]);
+	XA_STATE(target, &mapping->i_pages, swap_cache_index(f->swap[0]));
+	XA_STATE(keeper, &mapping->i_pages, swap_cache_index(f->swap[1]));
+	void *entry, *kept;
+	bool same;
+
+	if (mapping != swap_address_space(f->swap[1]))
+		return false;
+	xa_lock_irq(&mapping->i_pages);
+	entry = xas_load(&target);
+	kept = xas_load(&keeper);
+	same = xas_is_node(&target) && xas_is_node(&keeper) &&
+	       target.xa_node == keeper.xa_node && !target.xa_node->shift &&
+	       kept == f->folio[1] &&
+	       target.xa_node->count > target.xa_node->nr_values &&
+	       list_empty(&target.xa_node->private_list) && !mapping_exiting(mapping);
+	if (after) {
+		same = same && target.xa_node == f->leaf;
+		f->shadow = xa_is_value(entry);
+		f->empty = !entry;
+	} else {
+		same = same && entry == f->folio[0];
+		if (same)
+			f->leaf = target.xa_node;
+	}
+	xa_unlock_irq(&mapping->i_pages);
+	return same;
+}
+
+static void mc16_tr_one(struct kunit *test, const void *src, bool transport)
+{
+	struct mc16_tr *f;
+	struct folio *folio;
+	unsigned long reclaimed = 0;
+	unsigned int i;
+	unsigned char target_map = 0;
+	int ret, refs = 0;
+	bool before = false, after = false, marked;
+	LIST_HEAD(list);
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	f->test = test;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, mc16_tr_cleanup, f), 0);
+	ret = mc16_tr_alloc(f, transport);
+	if (ret)
+		goto out;
+	ret = mc16_tr_prepare(f, src, 0);
+	if (!ret)
+		ret = mc16_tr_prepare(f, src, 1);
+	if (ret)
+		goto out;
+	for (i = 0; i < 2; i++) {
+		if (READ_ONCE(f->si[i]->swap_map[swp_offset(f->swap[i])]) !=
+		    (SWAP_HAS_CACHE | 1)) {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+	marked = swap_memcomp_transport_test(f->si[0], swp_offset(f->swap[0]));
+	if (marked != transport) {
+		ret = -EINVAL;
+		goto out;
+	}
+	before = mc16_tr_leaf(f, false);
+	kunit_info(test,
+		   "transport reclaim pair: transport=%d target=%#lx keeper=%#lx leaf=%p same=%d",
+		   transport, f->swap[0].val, f->swap[1].val, f->leaf, before);
+	kunit_info(test, "transport reclaim indexes: target=%lu keeper=%lu marked=%d",
+		   swap_cache_index(f->swap[0]), swap_cache_index(f->swap[1]), marked);
+	if (!before) {
+		ret = -EXDEV;
+		goto out;
+	}
+	folio = f->folio[0];
+	folio_add_lru(folio);
+	lru_add_drain_all();
+	if (!folio_isolate_lru(folio)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	/* Allocation + cache + isolation. No extra target pin may survive. */
+	refs = folio_ref_count(folio);
+	if (refs != 3) {
+		folio_putback_lru(folio);
+		ret = -EBUSY;
+		goto out;
+	}
+	f->folio[0] = NULL;
+	f->handed = true;
+	list_add(&folio->lru, &list);
+	folio_put(folio); /* Drop only allocation; list owns isolation. */
+	folio = NULL;
+	reclaimed = reclaim_pages(&list);
+	/* Neither success nor putback leaves a fixture-owned target pointer. */
+	after = mc16_tr_leaf(f, true);
+	target_map = READ_ONCE(f->si[0]->swap_map[swp_offset(f->swap[0])]);
+	if (reclaimed != 1 || !after || target_map != 1) {
+		ret = -ESTALE;
+		goto out;
+	}
+	kunit_info(test, "transport reclaim transfer: refs=%d leaf=%d map=%u",
+		   refs, after, target_map);
+	kunit_info(test,
+		   "transport reclaim oracle: transport=%d reclaimed=%lu shadow=%d empty=%d",
+		   transport, reclaimed, f->shadow, f->empty);
+	if (transport) {
+		KUNIT_EXPECT_FALSE(test, f->shadow);
+		KUNIT_EXPECT_TRUE(test, f->empty);
+	} else {
+		KUNIT_EXPECT_TRUE(test, f->shadow);
+		KUNIT_EXPECT_FALSE(test, f->empty);
+	}
+out:
+	kunit_info(test, "transport reclaim result: transport=%d ret=%d reclaimed=%lu",
+		   transport, ret, reclaimed);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	kunit_release_action(test, mc16_tr_cleanup, f);
+}
diff --git a/mm/memcomp/tests/transport_test.h b/mm/memcomp/tests/transport_test.h
new file mode 100644
index 0000000..362ba74
--- /dev/null
+++ b/mm/memcomp/tests/transport_test.h
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_TRANSPORT_TEST_H
+#define _MM_MEMCOMP_TESTS_TRANSPORT_TEST_H
+
+#include <linux/bitmap.h>
+
+#ifdef CONFIG_SWAP
+static void mc16_test_transport_cleanup(void *data)
+{
+	swap_memcomp_transport_free(data);
+}
+
+/* Exercise the same allocation and bit operations as swapon/reclaim/free. */
+static struct swap_info_struct *
+mc16_test_transport_info(struct kunit *test, unsigned int max)
+{
+	struct swap_info_struct *si;
+
+	si = kunit_kzalloc(test, sizeof(*si), GFP_KERNEL);
+	if (!si)
+		return NULL;
+	si->max = max;
+	if (kunit_add_action_or_reset(test, mc16_test_transport_cleanup, si))
+		return NULL;
+	if (swap_memcomp_transport_alloc(si))
+		return NULL;
+	return si;
+}
+
+static bool mc16_test_transport_empty(struct swap_info_struct *si)
+{
+	unsigned long offset;
+
+	for (offset = 0; offset < si->max; offset++)
+		if (swap_memcomp_transport_test(si, offset))
+			return false;
+	return true;
+}
+
+static void memcomp_test_transport_bitmap_lifecycle(struct kunit *test)
+{
+	struct swap_info_struct *si;
+	unsigned long last = BITS_PER_LONG + 2;
+
+	si = mc16_test_transport_info(test, last + 1);
+	KUNIT_ASSERT_NOT_NULL(test, si);
+	KUNIT_EXPECT_TRUE(test, mc16_test_transport_empty(si));
+	swap_memcomp_transport_set(si, 1);
+	swap_memcomp_transport_set(si, last);
+	KUNIT_EXPECT_TRUE(test, swap_memcomp_transport_test(si, 1));
+	KUNIT_EXPECT_TRUE(test, swap_memcomp_transport_test(si, last));
+	KUNIT_EXPECT_FALSE(test, swap_memcomp_transport_test(si, 2));
+
+	swap_memcomp_transport_clear(si, 1, 1);
+	KUNIT_EXPECT_FALSE(test, swap_memcomp_transport_test(si, 1));
+	KUNIT_EXPECT_TRUE(test, swap_memcomp_transport_test(si, last));
+	/* A slot returned unused must not mark its next, ordinary owner. */
+	swap_memcomp_transport_set(si, 1);
+	swap_memcomp_transport_clear(si, 1, 1);
+	KUNIT_EXPECT_FALSE(test, swap_memcomp_transport_test(si, 1));
+
+	/* Teardown and reactivation of the same device start with an empty map. */
+	swap_memcomp_transport_free(si);
+	/* Cleanup is idempotent, including failed swapon before allocation. */
+	swap_memcomp_transport_free(si);
+	KUNIT_ASSERT_EQ(test, swap_memcomp_transport_alloc(si), 0);
+	KUNIT_EXPECT_TRUE(test, mc16_test_transport_empty(si));
+}
+
+static void memcomp_test_transport_bitmap_range(struct kunit *test)
+{
+	struct swap_info_struct *si;
+	unsigned long first = BITS_PER_LONG - 1;
+	unsigned int i;
+
+	si = mc16_test_transport_info(test, 2 * BITS_PER_LONG + 5);
+	KUNIT_ASSERT_NOT_NULL(test, si);
+	swap_memcomp_transport_set(si, first - 1);
+	for (i = 0; i < 4; i++)
+		swap_memcomp_transport_set(si, first + i);
+	swap_memcomp_transport_set(si, first + 4);
+	swap_memcomp_transport_clear(si, first, 0);
+	KUNIT_EXPECT_TRUE(test, swap_memcomp_transport_test(si, first));
+	swap_memcomp_transport_clear(si, first, 4);
+	for (i = 0; i < 4; i++)
+		KUNIT_EXPECT_FALSE(test, swap_memcomp_transport_test(si, first + i));
+	KUNIT_EXPECT_TRUE(test, swap_memcomp_transport_test(si, first - 1));
+	KUNIT_EXPECT_TRUE(test, swap_memcomp_transport_test(si, first + 4));
+}
+
+static void memcomp_test_transport_bitmap_devices(struct kunit *test)
+{
+	struct swap_info_struct *a, *b;
+
+	a = mc16_test_transport_info(test, BITS_PER_LONG + 1);
+	KUNIT_ASSERT_NOT_NULL(test, a);
+	b = mc16_test_transport_info(test, BITS_PER_LONG + 1);
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	/* Equal (synthetic) types must not alias independent pointer-keyed maps. */
+	KUNIT_ASSERT_EQ(test, a->type, b->type);
+	swap_memcomp_transport_set(a, BITS_PER_LONG);
+	KUNIT_EXPECT_EQ(test, swap_memcomp_transport_alloc(a), -EEXIST);
+	KUNIT_EXPECT_TRUE(test, swap_memcomp_transport_test(a, BITS_PER_LONG));
+	KUNIT_EXPECT_FALSE(test, swap_memcomp_transport_test(b, BITS_PER_LONG));
+	swap_memcomp_transport_set(b, BITS_PER_LONG);
+	swap_memcomp_transport_clear(a, BITS_PER_LONG, 1);
+	KUNIT_EXPECT_FALSE(test, swap_memcomp_transport_test(a, BITS_PER_LONG));
+	KUNIT_EXPECT_TRUE(test, swap_memcomp_transport_test(b, BITS_PER_LONG));
+	/* Reusing one si must neither retain old marks nor clear another map. */
+	swap_memcomp_transport_free(a);
+	KUNIT_ASSERT_EQ(test, swap_memcomp_transport_alloc(a), 0);
+	KUNIT_EXPECT_FALSE(test, swap_memcomp_transport_test(a, BITS_PER_LONG));
+	KUNIT_EXPECT_TRUE(test, swap_memcomp_transport_test(b, BITS_PER_LONG));
+}
+
+static void memcomp_test_transport_bitmap_budget(struct kunit *test)
+{
+	struct swap_info_struct *si;
+	unsigned long bytes;
+
+	/* 1 GiB / 4 KiB is 262144 offsets, independent of this kernel's PAGE_SIZE. */
+	si = mc16_test_transport_info(test, 1U << 18);
+	KUNIT_ASSERT_NOT_NULL(test, si);
+	bytes = BITS_TO_LONGS((unsigned long)si->max) * sizeof(unsigned long);
+	KUNIT_EXPECT_EQ(test, bytes, 32UL * 1024);
+	swap_memcomp_transport_set(si, si->max - 1);
+	KUNIT_EXPECT_TRUE(test, swap_memcomp_transport_test(si, si->max - 1));
+	KUNIT_EXPECT_FALSE(test, swap_memcomp_transport_test(si, si->max - 2));
+	swap_memcomp_transport_clear(si, si->max - 1, 1);
+	KUNIT_EXPECT_TRUE(test, mc16_test_transport_empty(si));
+}
+#endif /* CONFIG_SWAP */
+#endif /* _MM_MEMCOMP_TESTS_TRANSPORT_TEST_H */
diff --git a/mm/memcomp/tests/workingset_load_test.h b/mm/memcomp/tests/workingset_load_test.h
new file mode 100644
index 0000000..70d178f
--- /dev/null
+++ b/mm/memcomp/tests/workingset_load_test.h
@@ -0,0 +1,1095 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_WORKINGSET_LOAD_TEST_H
+#define _MM_MEMCOMP_TESTS_WORKINGSET_LOAD_TEST_H
+
+/*
+ * Author: nakixii
+ *
+ * Include after fault_test.h. Real MM, payload, charge and stock workingset.
+ * Required observation seam: at the start of mc16_load_page(), after local
+ * declarations, under CONFIG_MEMCOMP_KUNIT_TEST:
+ *	KUNIT_STATIC_STUB_REDIRECT(mc16_load_page, ref, dst);
+ * The observer calls the original function, not a second implementation.
+ * Its hit count is asserted; omitting this seam cannot silently pass.
+ */
+#ifdef MC16_FAULT_MM_TEST_ENABLED
+#define MC16_WORKINGSET_LOAD_TEST_ENABLED
+
+#include <kunit/static_stub.h>
+#include <linux/cgroup.h>
+#include <linux/mm_inline.h>
+#include <linux/swap_slots.h>
+#include <linux/vmstat.h>
+#include "../../memcontrol-v1.h"
+
+#if defined(CONFIG_PSI) && defined(CONFIG_TASK_DELAY_ACCT)
+#define MC16_WORKINGSET_SCOPE_TEST_ENABLED
+#endif
+
+struct mc16_wl {
+	struct kunit *test;
+	struct mc16_ft *fault;
+	struct memcomp_ref refs[MC16_FT_PAGES];
+	struct folio *dst[2];
+	unsigned int nr;
+	unsigned int reads;
+	int read_error;
+	bool observe_scope;
+	unsigned int scope_reads;
+};
+
+/* Test-task-local static stub; KUnit never redirects another task's reads. */
+static struct mc16_wl *mc16_wl_current;
+
+static void mc16_wl_cleanup(void *data)
+{
+	struct mc16_wl *f = data;
+	unsigned int i;
+
+	mc16_wl_current = NULL;
+	for (i = 0; i < ARRAY_SIZE(f->dst); i++) {
+		if (!f->dst[i])
+			continue;
+		if (folio_test_locked(f->dst[i]))
+			folio_unlock(f->dst[i]);
+		folio_clear_active(f->dst[i]);
+		folio_put(f->dst[i]);
+	}
+	for (i = 0; i < f->nr; i++)
+		mc16_ref_put(&f->refs[i]);
+}
+
+static struct mc16_wl *mc16_wl_begin(struct kunit *test, unsigned int nr,
+				     bool attached)
+{
+	struct mc16_wl *f;
+	unsigned int i;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->test = test;
+	f->fault = mc16_ft_begin(test, nr, false, !attached);
+	if (!f->fault)
+		return NULL;
+	if (kunit_add_action_or_reset(test, mc16_wl_cleanup, f))
+		return NULL;
+	for (i = 0; i < nr; i++) {
+		if (!mc16_get(f->fault->tokens[i], &f->refs[i]))
+			return NULL;
+		f->nr++;
+	}
+	return f;
+}
+
+static struct folio *mc16_wl_destination(struct mc16_wl *f, unsigned int index,
+					 unsigned int order)
+{
+	struct folio *folio;
+	int nid = folio_nid(f->fault->refs->storage->owner->folio);
+
+	folio = __folio_alloc_node(GFP_KERNEL, order, nid);
+	if (!folio)
+		return NULL;
+	f->dst[index] = folio;
+	folio_lock(folio);
+	if (mc16_user_charge(&f->refs[0], folio, f->fault->mm, GFP_KERNEL))
+		return NULL;
+	__folio_set_swapbacked(folio);
+	return folio;
+}
+
+/* Produce a native shadow: never encode generation, memcg or distance bits. */
+static unsigned long mc16_wl_shadow(struct mc16_wl *f, bool hot)
+{
+	struct folio *source;
+	struct mem_cgroup *memcg;
+	unsigned long shadow = 0;
+	int nid = folio_nid(f->fault->refs->storage->owner->folio);
+
+	source = __folio_alloc_node(GFP_KERNEL, 0, nid);
+	if (!source)
+		return 0;
+	folio_lock(source);
+	if (mc16_user_charge(&f->refs[0], source, f->fault->mm, GFP_KERNEL))
+		goto out;
+	__folio_set_swapbacked(source);
+	if (hot) {
+		folio_set_workingset(source);
+#ifdef CONFIG_LRU_GEN
+		/* Model a frequently accessed source using stock's flag format. */
+		source->flags |= LRU_REFS_MASK;
+#endif
+	}
+	memcg = folio_memcg(source);
+	if (!memcg && !mem_cgroup_disabled())
+		memcg = root_mem_cgroup;
+	shadow = (unsigned long)workingset_memcomp_eviction(source, memcg);
+out:
+	folio_clear_workingset(source);
+#ifdef CONFIG_LRU_GEN
+	source->flags &= ~LRU_REFS_MASK;
+#endif
+	folio_unlock(source);
+	folio_put(source);
+	return shadow;
+}
+
+static void mc16_wl_set_shadow(struct memcomp_ref *ref, unsigned long shadow)
+{
+	mutex_lock(memcomp_lock_of(ref->token));
+	*mc16_shadow_ptr(ref) = shadow;
+	mutex_unlock(memcomp_lock_of(ref->token));
+}
+
+static u64 mc16_wl_get_shadow(struct memcomp_ref *ref)
+{
+	u64 shadow;
+
+	mutex_lock(memcomp_lock_of(ref->token));
+	shadow = *mc16_shadow_ptr(ref);
+	mutex_unlock(memcomp_lock_of(ref->token));
+	return shadow;
+}
+
+/*
+ * Include pending per-CPU node deltas, not just the periodically folded
+ * counter. These cases run serially in the isolated KUnit guest.
+ */
+static long mc16_wl_refaults(void)
+{
+	long count = atomic_long_read(&vm_node_stat[WORKINGSET_REFAULT_ANON]);
+#ifdef CONFIG_SMP
+	int nid, cpu;
+
+	for_each_online_node(nid) {
+		struct pglist_data *pgdat = NODE_DATA(nid);
+
+		for_each_online_cpu(cpu)
+			count += READ_ONCE(per_cpu_ptr(pgdat->per_cpu_nodestats,
+					cpu)->vm_node_stat_diff[WORKINGSET_REFAULT_ANON]);
+	}
+#endif
+	return count;
+}
+
+/* Match handle_mm_fault()'s context without replacing stock's policy. */
+static vm_fault_t mc16_wl_fault(struct mc16_ft *f, unsigned int index)
+{
+	vm_fault_t ret;
+#ifdef CONFIG_LRU_GEN
+	bool saved = current->in_lru_fault;
+
+	current->in_lru_fault = true;
+#endif
+	ret = mc16_ft_fault(f->test, f->mm, f->addr + index * PAGE_SIZE,
+			    mc16_ft_orig(f, index), FAULT_FLAG_WRITE);
+#ifdef CONFIG_LRU_GEN
+	current->in_lru_fault = saved;
+#endif
+	return ret;
+}
+
+#ifdef CONFIG_VM_EVENT_COUNTERS
+struct mc16_wl_major {
+	unsigned long global;
+	unsigned long memcg;
+	bool has_memcg;
+};
+
+static struct mc16_wl_major mc16_wl_major_read(struct mm_struct *mm)
+{
+	struct mc16_wl_major count = { };
+	struct mem_cgroup *memcg;
+	int cpu;
+
+	for_each_possible_cpu(cpu)
+		count.global += READ_ONCE(per_cpu(vm_event_states, cpu).event[PGMAJFAULT]);
+	if (mem_cgroup_disabled())
+		return count;
+	rcu_read_lock();
+	memcg = mem_cgroup_from_task(rcu_dereference(mm->owner));
+	if (memcg)
+		css_get(&memcg->css);
+	rcu_read_unlock();
+	if (memcg) {
+		/* The public rate-limited flush need not flush a single event. */
+		cgroup_rstat_flush(memcg->css.cgroup);
+		count.memcg = memcg_events(memcg, PGMAJFAULT);
+		count.has_memcg = true;
+		css_put(&memcg->css);
+	}
+	return count;
+}
+
+static void mc16_wl_major_expect(struct kunit *test, struct mm_struct *mm,
+				 struct mc16_wl_major before, unsigned int nr)
+{
+	struct mc16_wl_major after = mc16_wl_major_read(mm);
+
+	KUNIT_EXPECT_EQ(test, after.global - before.global, (unsigned long)nr);
+	KUNIT_EXPECT_EQ(test, after.has_memcg, before.has_memcg);
+	if (before.has_memcg)
+		KUNIT_EXPECT_EQ(test, after.memcg - before.memcg, (unsigned long)nr);
+}
+#endif
