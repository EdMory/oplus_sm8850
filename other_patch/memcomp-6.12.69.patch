+static void memcomp_test_writeback_revert(struct kunit *test)
+{
+	struct mc16_test_writeback *f = mc16_test_writeback_begin(test, false);
+	struct mc16_test_storage *s;
+	struct mc16_writeback snapshot;
+	struct memcomp_lru *fifo;
+	long charged, eligible;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	s = f->refs->storage;
+	fifo = mc16_fifo_of(&f->writer);
+	eligible = atomic_long_read(&fifo->nr_entries);
+	charged = atomic_long_read(&s->owner->model.charged);
+	KUNIT_ASSERT_TRUE(test, mc16_test_writeback_claim(f));
+	snapshot = f->snapshot;
+	KUNIT_EXPECT_FALSE(test, mc16_test_writeback_claim(f));
+	KUNIT_EXPECT_PTR_EQ(test, f->snapshot.slot, snapshot.slot);
+	KUNIT_EXPECT_EQ(test, f->snapshot.word, snapshot.word);
+	KUNIT_EXPECT_EQ(test, f->snapshot.length, snapshot.length);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&fifo->nr_entries), eligible - 1);
+	KUNIT_EXPECT_TRUE(test, mc16_test_writeback_revert(f));
+	KUNIT_EXPECT_FALSE(test, mc16_test_writeback_revert(f));
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&fifo->nr_entries), eligible);
+	KUNIT_EXPECT_EQ(test, f->writer.cluster->eligible_slots, (u16)1);
+	KUNIT_EXPECT_EQ(test, f->writer.slot->word, snapshot.word);
+	KUNIT_EXPECT_EQ(test, f->writer.slot->length, snapshot.length);
+	KUNIT_EXPECT_EQ(test, s->payload.frees, 0U);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged), charged);
+	mc16_test_writeback_load(test, f);
+}
+
+/* Mutate the staged identity, keeping the actual zs handle valid throughout. */
+static void memcomp_test_writeback_mismatch(struct kunit *test)
+{
+	struct mc16_test_writeback *f = mc16_test_writeback_begin(test, false);
+	struct mc16_test_storage *s;
+	struct mc16_swap_fields swap;
+	int puts, dups, uncharges;
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	s = f->refs->storage;
+	swap = mc16_test_writeback_backing(f, true);
+	puts = atomic_read(&memcomp_kunit_slot_puts);
+	dups = atomic_read(&memcomp_kunit_slot_dups);
+	uncharges = atomic_read(&s->owner->model.uncharge_calls);
+	for (i = 0; i < 3; i++) {
+		KUNIT_ASSERT_TRUE(test, mc16_test_writeback_claim(f));
+		if (i == 0)
+			f->snapshot.word ^= 1;
+		else if (i == 1)
+			f->snapshot.length ^= 1;
+		else
+			KUNIT_ASSERT_TRUE(test, mc16_test_writeback_revert(f));
+		KUNIT_EXPECT_EQ(test, mc16_test_writeback_settle(f, &swap), -ESTALE);
+		KUNIT_EXPECT_TRUE(test, f->backing_owned);
+		KUNIT_EXPECT_EQ(test, f->tail.word, 0ULL);
+		KUNIT_EXPECT_EQ(test, f->tail.charge, 0U);
+		KUNIT_EXPECT_EQ(test, f->writer.cluster->eligible_slots, (u16)1);
+		mc16_test_writeback_load(test, f);
+	}
+	KUNIT_EXPECT_EQ(test, s->payload.frees, 0U);
+	KUNIT_EXPECT_EQ(test, atomic_read(&s->owner->model.uncharge_calls), uncharges);
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_kunit_slot_puts), puts);
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_kunit_slot_dups), dups);
+	/* Caller can still return exactly its own unconsumed reference. */
+	memcomp_slot_put(f->backing);
+	f->backing_owned = false;
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_kunit_slot_puts), puts + 1);
+}
+
+static void memcomp_test_writeback_encoding(struct kunit *test)
+{
+	struct mc16_test_writeback *f = mc16_test_writeback_begin(test, false);
+	struct mc16_swap_fields swap, bad;
+	unsigned int i;
+	int puts;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_TRUE(test, mc16_test_writeback_claim(f));
+	swap = mc16_test_writeback_backing(f, true);
+	puts = atomic_read(&memcomp_kunit_slot_puts);
+	for (i = 0; i < 8; i++) {
+		bad = swap;
+		switch (i) {
+		case 0:
+			bad.swap_offset++;
+			break;
+		case 1:
+			bad.type = MAX_SWAPFILES;
+			break;
+		case 2:
+			bad.byte_offset = PAGE_SIZE;
+			break;
+		case 3:
+			bad.byte_offset++; /* packed payload crosses backing page */
+			break;
+		case 4:
+			bad.packed = false; /* raw requires byte_offset == 0 */
+			break;
+		case 5:
+			bad.length = 0;
+			break;
+		case 6:
+			bad.length = PAGE_SIZE;
+			break;
+		default:
+			bad.type = 0;
+			bad.swap_offset = 0; /* zero backing is never transferable */
+			break;
+		}
+		KUNIT_EXPECT_EQ(test, mc16_test_writeback_settle(f, &bad), -EINVAL);
+		KUNIT_EXPECT_TRUE(test, f->backing_owned);
+		KUNIT_EXPECT_EQ(test, f->tail.word, 0ULL);
+		KUNIT_EXPECT_EQ(test, f->writer.slot->word, f->snapshot.word);
+		KUNIT_EXPECT_EQ(test, mc16_flags_state(f->writer.slot->flags),
+				(unsigned int)MC16_WRITEBACK);
+	}
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_kunit_slot_puts), puts);
+	KUNIT_EXPECT_EQ(test, f->refs->storage->payload.frees, 0U);
+	/* Maximum type/offset and a payload ending exactly at PAGE_SIZE. */
+	KUNIT_ASSERT_EQ(test, mc16_test_writeback_settle(f, &swap), 0);
+	mc16_test_writeback_swapped(test, f, &swap, false);
+}
+
+/* OWNER normalization frees the record before WB settles using the guard. */
+static void memcomp_test_writeback_last_pte(struct kunit *test)
+{
+	struct mc16_test_writeback *f = mc16_test_writeback_begin(test, true);
+	struct mc16_test_storage *s;
+	struct mc16_swap_fields swap;
+	struct mc16_view view;
+	long charged;
+	u64 record_charge;
+	u32 token;
+	int reclaims, uncharges;
+	bool dropped;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	s = f->refs->storage;
+	token = f->writer.token;
+	KUNIT_ASSERT_TRUE(test, mc16_get(token, &f->pte));
+	KUNIT_ASSERT_TRUE(test, mc16_get(token, &f->lookup));
+	KUNIT_ASSERT_TRUE(test, mc16_test_writeback_claim(f));
+	mutex_lock(memcomp_lock_of(token));
+	mc16_view_locked(&f->writer, &view);
+	record_charge = view.record->charge_bytes;
+	mutex_unlock(memcomp_lock_of(token));
+	charged = atomic_long_read(&s->owner->model.charged);
+	dropped = mc16_owner_drop_folio_held(&f->lookup, s->owner->folio, 1, 0);
+	if (dropped)
+		s->refs[0] = (struct memcomp_ref) { };
+	KUNIT_ASSERT_TRUE(test, dropped);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged),
+			charged - record_charge);
+	/* This is the last persistent PTE reference; writer is still live. */
+	mc16_ref_put(&f->pte);
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->writer.slot->refs), 1U);
+	KUNIT_EXPECT_EQ(test, f->writer.slot->word, f->snapshot.word);
+	KUNIT_EXPECT_EQ(test, s->payload.frees, 0U);
+	mc16_test_writeback_load(test, f);
+	swap = mc16_test_writeback_backing(f, true);
+	reclaims = atomic_read(&memcomp_kunit_slot_reclaims);
+	uncharges = atomic_read(&s->owner->model.uncharge_calls);
+	KUNIT_ASSERT_EQ(test, mc16_test_writeback_settle(f, &swap), 0);
+	mc16_test_writeback_swapped(test, f, &swap, false);
+	mc16_writeback_finish(&f->writer, &f->tail);
+	mc16_writeback_finish(&f->writer, &f->tail);
+	KUNIT_EXPECT_EQ(test, atomic_read(&s->owner->model.uncharge_calls),
+			uncharges + 1);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged),
+			charged - record_charge - f->bytes);
+	mc16_ref_put(&f->writer);
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_kunit_slot_reclaims), reclaims + 1);
+	KUNIT_EXPECT_EQ(test, s->payload.frees, 1U);
+	KUNIT_EXPECT_FALSE(test, s->payload.bad_lifetime);
+	KUNIT_EXPECT_FALSE(test, mc16_get(token, &f->lookup));
+}
+#endif /* CONFIG_MEMCG && CONFIG_SWAP */
+#endif /* _MM_MEMCOMP_TESTS_WRITEBACK_TEST_H */
diff --git a/mm/memcomp/tests/zero_callers_test.h b/mm/memcomp/tests/zero_callers_test.h
new file mode 100644
index 0000000..fd2d5ec
--- /dev/null
+++ b/mm/memcomp/tests/zero_callers_test.h
@@ -0,0 +1,717 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_ZERO_CALLERS_TEST_H
+#define _MM_MEMCOMP_TESTS_ZERO_CALLERS_TEST_H
+
+#include <kunit/resource.h>
+#include <kunit/test.h>
+#include <linux/highmem.h>
+#include <linux/mman.h>
+#include <linux/sched/mm.h>
+
+/*
+ * Include in suite.h AFTER BOTH zero_load_test.h and
+ * writeback_batch_test.h. The first supplies real MM actors;
+ * under MEMCG the second supplies an unlocked, real zs/accounting sentinel.
+ * Public APIs and stat_show() must already be visible from memcomp.c.
+ *
+ * Register ALL cases under MC16_ZERO_CALLERS_TEST_ENABLED, outside any
+ * CONFIG_MEMCG-only block. It requires MEMCOMP_KUNIT_TEST, MMU, SWAP and
+ * ADVISE_SYSCALLS, and supports MEMCG=n/y. Optional PTE protection bits skip
+ * only their corresponding cases when the architecture/config lacks them.
+ *
+ * Requires zero-callers.patch plus the transport-release fix in live source.
+ * get(0) adds a PTE owner; get_ref(0)/cache pin(0) reject with an empty ref.
+ * Cache zero uses memcomp_load_folio_zero() and a later explicit cache drop;
+ * there is no sentinel guard. No fallback public dispatch is supplied here.
+ * Public get/put actors model fork/zap ownership under a PTL. Fault actors use
+ * real MM/PTE/rmap/memcg through memcomp_load(), not the internal zero loader.
+ */
+#if defined(MC16_ZERO_LOAD_MM_TEST_ENABLED) && defined(CONFIG_SWAP)
+#define MC16_ZERO_CALLERS_TEST_ENABLED
+
+struct mc16_test_zcall {
+	struct kunit *test;
+	struct mc16_zl_mm watch;
+	struct mc16_zero_owners owners;
+	struct memcomp_ref guard;
+	unsigned long unexpected_cache[2];
+	struct folio *transport;
+	struct folio *large;
+	char *stat;
+#ifdef CONFIG_MEMCG
+	struct mc16_test_wbb *wb;
+#endif
+};
+
+/*
+ * Tests own a private delta in a quiescent ledger. Unwind that actual delta
+ * after an early assertion, even if a broken public API failed to account.
+ * Negative deltas are failures too; repair them so later cases stay isolated.
+ * No production reset, global atomic, or inherited test-task lock is used.
+ */
+static void mc16_test_zcall_cleanup(void *data)
+{
+	struct mc16_test_zcall *f = data;
+	struct mc16_zero_owners after;
+	s64 pte, cache;
+	unsigned int i;
+
+	memcomp_load_folio_abort(&f->guard);
+	for (i = 0; i < ARRAY_SIZE(f->unexpected_cache); i++) {
+		if (f->unexpected_cache[i])
+			memcomp_invalidate_cache(f->unexpected_cache[i]);
+	}
+	mc16_zero_owners_read(&after);
+	pte = after.pte_pages - f->owners.pte_pages;
+	cache = after.cache_pages - f->owners.cache_pages;
+	KUNIT_EXPECT_GE(f->test, pte, 0LL);
+	KUNIT_EXPECT_GE(f->test, cache, 0LL);
+	if (pte > 0)
+		mc16_zero_pte_put(pte);
+	else if (pte < 0)
+		mc16_zero_pte_init(-pte);
+	if (cache > 0)
+		mc16_zero_cache_put(cache);
+	else if (cache < 0)
+		mc16_zero_cache_get(-cache);
+	mc16_zero_owners_read(&after);
+	KUNIT_EXPECT_EQ(f->test, after.pte_pages, f->owners.pte_pages);
+	KUNIT_EXPECT_EQ(f->test, after.cache_pages, f->owners.cache_pages);
+	mc16_zl_storage_unchanged(&f->watch);
+	if (f->large) {
+		KUNIT_EXPECT_FALSE(f->test, folio_test_locked(f->large));
+		f->large->swap.val = 0;
+		folio_put(f->large);
+	}
+	if (f->transport) {
+		KUNIT_EXPECT_FALSE(f->test, folio_test_locked(f->transport));
+		f->transport->swap.val = 0;
+		folio_put(f->transport);
+	}
+	if (f->stat)
+		free_page((unsigned long)f->stat);
+}
+
+static struct mc16_test_zcall *mc16_test_zcall_begin(struct kunit *test)
+{
+	struct mc16_test_zcall *f;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->test = test;
+	f->watch.test = test;
+#ifdef CONFIG_MEMCG
+	/* This fixture returns its source folio unlocked, including on error. */
+	f->wb = mc16_test_wbb_begin(test, false);
+	if (!f->wb)
+		return NULL;
+	f->watch.refs = f->wb->refs;
+#endif
+	mc16_zero_owners_read(&f->owners);
+	mc16_zl_storage_read(&f->watch, &f->watch.storage);
+	if (kunit_add_action_or_reset(test, mc16_test_zcall_cleanup, f))
+		return NULL;
+	return f;
+}
+
+static void mc16_test_zcall_counts(struct mc16_test_zcall *f, s64 pte, s64 cache)
+{
+	struct mc16_zero_owners after;
+
+	mc16_zero_owners_read(&after);
+	KUNIT_EXPECT_EQ(f->test, after.pte_pages, f->owners.pte_pages + pte);
+	KUNIT_EXPECT_EQ(f->test, after.cache_pages, f->owners.cache_pages + cache);
+	mc16_zl_storage_unchanged(&f->watch);
+}
+
+static void memcomp_test_zero_callers_fork_get(struct kunit *test)
+{
+	struct mc16_test_zcall *f = mc16_test_zcall_begin(test);
+	struct mc16_zero_diagnostics before, after;
+	spinlock_t ptl; /* Models parent/child publication, not a fork syscall. */
+	unsigned long flags;
+	bool first, second;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	mc16_zero_diagnostics_read(&before);
+	KUNIT_ASSERT_TRUE(test, mc16_zero_pte_init(1));
+	KUNIT_ASSERT_TRUE(test, mc16_zero_cache_get(2));
+	spin_lock_init(&ptl);
+	spin_lock_irqsave(&ptl, flags);
