+	raw_candidate_ge_page =
+		atomic64_read(&memcomp_raw_candidate_ge_page);
+	raw_reject_huge = atomic64_read(&memcomp_raw_reject_huge);
+	raw_reject_ge_page = atomic64_read(&memcomp_raw_reject_ge_page);
