+#if (defined(CONFIG_SWAP))
+static void memcomp_test_writeback_pack_fits(struct kunit *test)
+{
+	const unsigned int max = MEMCOMP_WRITEBACK_PACK_MAX;
+
+	KUNIT_EXPECT_TRUE(test, memcomp_writeback_pack_fits(0, 0, 1));
