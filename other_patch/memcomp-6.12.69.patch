+	KUNIT_EXPECT_TRUE(test, pte_same(mc16_ft_read(f, 0), mc16_ft_orig(f, 0)));
+	mc16_ft_token_refs(f, 0, 1);
+	mc16_ft_counts(f, 1, 0);
