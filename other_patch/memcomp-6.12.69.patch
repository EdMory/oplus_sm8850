+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+static u64 mc16_test_refresh_cross_node_read(void)
+{
+	u64 pages = 0;
+	int cpu;
+
+	for_each_possible_cpu(cpu)
+		pages += READ_ONCE(per_cpu(mc16_refresh_cross_node_pages, cpu));
+	return pages;
+}
