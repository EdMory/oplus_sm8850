+static void memcomp_test_fault_softdirty(struct kunit *test)
+{
+	if (!IS_ENABLED(CONFIG_MEM_SOFT_DIRTY)) {
+		kunit_skip(test, "soft-dirty tracking disabled");
+		return;
+	}
+	mc16_ft_protection(test, 0);
+}
