+	for (i = 0; i < MEMCOMP_MAX_COMPRESS_PAGES; i++)
+		lengths[i] = PAGE_SIZE;
+	reclaimable = memcomp_payloads_net_reclaimable(lengths,
+						       ARRAY_SIZE(lengths));
+	KUNIT_EXPECT_FALSE(test, reclaimable);
+}
