+	mc16_fault_probe.fail_small_alloc = !charge;
+	mc16_fault_probe.fail_small_charge = charge;
+	ret = mc16_ft_fault(test, f->mm, f->addr, mc16_ft_orig(f, 0), 0);
+	WRITE_ONCE(mc16_fault_probe.task, NULL);
