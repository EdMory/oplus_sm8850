+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_CACHE_RESERVE_TEST_H
+#define _MM_MEMCOMP_TESTS_CACHE_RESERVE_TEST_H
+
+/* Include after storage_test.h; this header does not register any test cases. */
+#ifdef CONFIG_MEMCG
+struct mc16_test_cache_reserve {
+	struct mc16_test_storage *storage;
+	struct mc16_initial_payload initial[MC16_MAX_PAGES];
+	bool owned[MC16_MAX_PAGES];
+};
+
+static void mc16_test_cache_drop(struct mc16_test_storage *s);
+
+/* Prepared charges are private; stable slots use the storage cleanup action. */
+static void mc16_test_cache_cleanup(void *data)
+{
+	struct mc16_test_cache_reserve *f = data;
+	struct obj_cgroup *objcg = &f->storage->owner->model.objcg;
+	unsigned int i;
+
+	/* Teardown must not re-enter the fixture's allocation-window callback. */
+	f->storage->probe.fail_at = 0;
+	f->storage->probe.fail_descriptor = false;
+	f->storage->probe.allocation_window = NULL;
+
+	for (i = 0; i < MC16_MAX_PAGES; i++) {
+		if (!f->owned[i])
+			continue;
+		if (f->initial[i].bytes) {
+			memcomp_zs_free(0, f->initial[i].word);
+			memcomp_objcg_uncharge(objcg, f->initial[i].bytes);
+		}
+	}
+	mc16_test_cache_drop(f->storage);
+	/* Return the independent source hold after private storage cleanup. */
+	memcomp_objcg_put(objcg);
+}
+
+static struct mc16_test_cache_reserve *
+mc16_test_cache_begin(struct kunit *test)
+{
+	struct mc16_test_cache_reserve *f;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->storage = mc16_test_storage_begin(test);
+	if (!f->storage)
+		return NULL;
+	/* Explicitly model the source hold required across the allocation window. */
+	memcomp_objcg_get_ref(&f->storage->owner->model.objcg);
+	if (kunit_add_action_or_reset(test, mc16_test_cache_cleanup, f))
+		return NULL;
+	return f;
+}
+
+static int mc16_test_cache_prepare(struct mc16_test_cache_reserve *f,
+				   unsigned int index, u32 bytes, u64 word)
+{
+	struct obj_cgroup *objcg = &f->storage->owner->model.objcg;
+	unsigned long handle;
+	void *mapped;
+	int ret;
+
+	if (index >= MC16_MAX_PAGES || f->owned[index] || bytes > PAGE_SIZE)
+		return -EINVAL;
+	if (bytes) {
+		ret = memcomp_zs_malloc(memcomp_pools[0], bytes, &handle, false);
+		if (ret)
+			return ret;
+		ret = memcomp_objcg_charge(objcg, GFP_NOWAIT | __GFP_NOWARN, bytes);
+		if (ret) {
+			memcomp_zs_free(0, handle);
+			return ret;
+		}
+		mapped = zs_map_object(memcomp_pools[0], handle, ZS_MM_WO);
+		memset(mapped, 0x5a, bytes);
+		zs_unmap_object(memcomp_pools[0], handle);
+		word = handle;
+	}
+	f->initial[index] = (struct mc16_initial_payload) {
+		.word = word, .bytes = bytes,
+	};
+	f->owned[index] = true;
+	return 0;
+}
+
+static int mc16_test_cache_reserve(struct mc16_test_cache_reserve *f,
+				   unsigned int nr)
+{
+	struct mc16_test_storage *s = f->storage;
+	unsigned int i;
+	int ret;
+
+	if (nr > MC16_MAX_PAGES || s->nr + nr > MC16_TEST_REFS)
+		return -ENOSPC;
+	ret = mc16_reserve_cache(&s->owner->model.objcg,
+				 folio_nid(s->owner->folio), f->initial, nr,
+				&s->refs[s->nr]);
+	if (!ret) {
+		for (i = 0; i < nr; i++)
+			f->owned[i] = false;
+		s->nr += nr;
+	}
+	return ret;
+}
+
+static void mc16_test_cache_drop(struct mc16_test_storage *s)
+{
+	unsigned int i;
+
+	/* No pending/stat/FIFO publication occurred in this storage-only fixture. */
+	for (i = 0; i < s->nr; i++) {
+		struct memcomp_ref *ref = &s->refs[i];
+
+		if (!ref->slot)
+			continue;
+		/* Private reservations never acquired an initial counted ref. */
+		mc16_release_resources(ref);
+		mc16_retire_slot(ref);
+	}
+	rcu_barrier();
+}
+
+static void memcomp_test_cache_reserve_payloads(struct kunit *test)
+{
+	const u64 fill = 0xfedcba9876543210ULL;
+	struct mc16_test_cache_reserve *f = mc16_test_cache_begin(test);
+	struct mc16_test_storage *s;
+	struct mc16_initial_payload saved[4];
+	struct mc16_view view;
+	unsigned int i, state;
+	u32 bytes;
+	long charge;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	s = f->storage;
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_prepare(f, 0, PAGE_SIZE, 0), 0);
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_prepare(f, 1, 0, fill), 0);
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_prepare(f, 2, 128, 0), 0);
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_prepare(f, 3, 0, 0), 0);
+	memcpy(saved, f->initial, sizeof(saved));
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_reserve(f, 4), 0);
+	for (i = 0; i < ARRAY_SIZE(saved); i++) {
+		struct memcomp_ref *ref = &s->refs[i];
+
+		state = saved[i].bytes ? MC16_STORED : MC16_SAMEFILL;
+		KUNIT_EXPECT_EQ(test, ref->slot->word, saved[i].word);
+		KUNIT_EXPECT_EQ(test, f->initial[i].word, saved[i].word);
+		KUNIT_EXPECT_EQ(test, f->initial[i].bytes, saved[i].bytes);
+		KUNIT_EXPECT_EQ(test, refcount_read(&ref->slot->refs), 0);
+		KUNIT_EXPECT_EQ(test, ref->slot->flags,
+				(u16)(state | (2 << MC16_ORDER_SHIFT)));
+		KUNIT_EXPECT_TRUE(test, mc16_payload_length_decode(state,
+								   ref->slot->length, &bytes));
+		KUNIT_EXPECT_EQ(test, bytes, saved[i].bytes);
+		KUNIT_ASSERT_TRUE(test, mc16_view_owned(ref, &view));
+		KUNIT_EXPECT_PTR_EQ(test, view.record, NULL);
+		KUNIT_EXPECT_PTR_EQ(test, view.member, NULL);
+		KUNIT_EXPECT_PTR_EQ(test, ref->cluster, s->refs[0].cluster);
+		KUNIT_EXPECT_EQ(test, ref->token, s->refs[0].token + i);
+	}
+	KUNIT_EXPECT_EQ(test, s->refs[0].token & 3U, 0U);
+	KUNIT_EXPECT_EQ(test, s->refs[0].cluster->key->kind, (u8)MC16_KEY_SHMEM);
+	KUNIT_EXPECT_PTR_EQ(test, s->refs[0].cluster->key->objcg,
+			    &s->owner->model.objcg);
+	KUNIT_EXPECT_EQ(test, s->refs[0].cluster->eligible_slots, (u16)0);
+	charge = PAGE_SIZE + 128 + s->refs[0].cluster->key->metadata_bytes;
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged), charge);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(s->owner->folio), 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&s->owner->model.get_calls), 2);
+	s->payload.task = current;
+	s->payload.pool = memcomp_pools[0];
+	s->payload.handle = saved[0].word;
+	s->payload.live = true;
+	rcu_assign_pointer(memcomp_kunit_async_probe, &s->payload);
+	mc16_test_cache_drop(s);
+	KUNIT_EXPECT_EQ(test, s->payload.frees, 1U);
+	KUNIT_EXPECT_FALSE(test, s->payload.live);
+	KUNIT_EXPECT_FALSE(test, s->payload.bad_lifetime);
+	KUNIT_EXPECT_FALSE(test, xa_empty(&mc16_clusters));
+	KUNIT_EXPECT_FALSE(test, hash_empty(mc16_keys));
+	/* Source and key remain independent until explicit pressure reclaim. */
+	mc16_test_reclaim_retained();
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged), 0L);
+	/* Only the caller's explicit source hold remains. */
+	KUNIT_EXPECT_EQ(test, atomic_read(&s->owner->model.get_calls) -
+			atomic_read(&s->owner->model.put_calls), 1);
+}
+
+static void memcomp_test_cache_reserve_boundaries(struct kunit *test)
+{
+	struct mc16_test_cache_reserve *f = mc16_test_cache_begin(test);
+	struct mc16_test_storage *s;
+	struct mc16_cluster *first;
+	struct memcomp_ref guard;
+	u32 base;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	s = f->storage;
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_reserve(f, 1), 0);
+	first = s->refs[0].cluster;
+	base = s->refs[0].token;
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_reserve(f, 2), 0);
+	KUNIT_EXPECT_EQ(test, s->refs[1].token, base + 2);
+	KUNIT_EXPECT_FALSE(test, mc16_get(base + 1, &guard));
+	/* Segment, shadow array and cluster; the second reserve reuses them. */
+	KUNIT_EXPECT_EQ(test, s->probe.allocations, 3U);
+	while (first->next < MC16_SEGMENT_SLOTS)
+		KUNIT_ASSERT_EQ(test, mc16_test_cache_reserve(f, 1), 0);
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_reserve(f, MC16_MAX_PAGES), 0);
+	KUNIT_EXPECT_EQ(test, s->refs[s->nr - MC16_MAX_PAGES].token, base + 64);
+	KUNIT_EXPECT_EQ(test, s->refs[s->nr - 1].slot->flags,
+			(u16)(MC16_SAMEFILL |
+			      (MC16_MAX_ORDER << MC16_ORDER_SHIFT)));
+	while (first->next < MC16_CLUSTER_SLOTS)
+		KUNIT_ASSERT_EQ(test, mc16_test_cache_reserve(f, 1), 0);
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_reserve(f, 1), 0);
+	KUNIT_EXPECT_PTR_NE(test, s->refs[s->nr - 1].cluster, first);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(s->owner->folio), 1);
+}
+
+static void memcomp_test_cache_reserve_invalid(struct kunit *test)
+{
+	struct mc16_test_cache_reserve *f = mc16_test_cache_begin(test);
+	const unsigned int bad_nr[] = { 0, 3, MC16_MAX_PAGES + 1, 65537, UINT_MAX };
+	const unsigned int bad_nid[] = { MAX_NUMNODES, 65536, UINT_MAX };
+	struct memcomp_ref refs[MC16_MAX_PAGES];
+	struct mc16_test_storage *s;
+	struct obj_cgroup *objcg;
+	unsigned int i;
+	u64 handle;
+	long charge;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	s = f->storage;
+	objcg = &s->owner->model.objcg;
+	for (i = 0; i < ARRAY_SIZE(refs); i++)
+		refs[i] = (struct memcomp_ref) { .token = U32_MAX };
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_prepare(f, 0, 128, 0), 0);
+	handle = f->initial[0].word;
+	charge = atomic_long_read(&s->owner->model.charged);
+	for (i = 0; i < ARRAY_SIZE(bad_nr); i++)
+		KUNIT_EXPECT_EQ(test, mc16_reserve_cache(objcg, 0, f->initial,
+							 bad_nr[i], refs), -EINVAL);
+	for (i = 0; i < ARRAY_SIZE(bad_nid); i++)
+		KUNIT_EXPECT_EQ(test, mc16_reserve_cache(objcg, bad_nid[i],
+							 f->initial, 1, refs), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mc16_reserve_cache(objcg, 0, NULL, 1, refs), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mc16_reserve_cache(objcg, 0, f->initial, 1, NULL),
+			-EINVAL);
+	/* The last bad element must prevent publication of every earlier one. */
+	f->initial[MC16_MAX_PAGES - 1].bytes = PAGE_SIZE + 1;
+	f->initial[MC16_MAX_PAGES - 1].word = 1;
+	KUNIT_EXPECT_EQ(test, mc16_reserve_cache(objcg, 0, f->initial,
+						 MC16_MAX_PAGES, refs), -EINVAL);
+	f->initial[MC16_MAX_PAGES - 1].bytes = U32_MAX;
+	KUNIT_EXPECT_EQ(test, mc16_reserve_cache(objcg, 0, f->initial,
+						 MC16_MAX_PAGES, refs), -EINVAL);
+	f->initial[MC16_MAX_PAGES - 1].bytes = 1;
+	f->initial[MC16_MAX_PAGES - 1].word = 0;
+	KUNIT_EXPECT_EQ(test, mc16_reserve_cache(objcg, 0, f->initial,
+						 MC16_MAX_PAGES, refs), -EINVAL);
+	for (i = 0; i < ARRAY_SIZE(refs); i++) {
+		KUNIT_EXPECT_EQ(test, refs[i].token, U32_MAX);
+		KUNIT_EXPECT_PTR_EQ(test, refs[i].slot, NULL);
+	}
+	KUNIT_EXPECT_EQ(test, f->initial[0].word, handle);
+	KUNIT_EXPECT_TRUE(test, f->owned[0]);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged), charge);
+	KUNIT_EXPECT_EQ(test, s->probe.allocations, 0U);
+	KUNIT_EXPECT_TRUE(test, xa_empty(&mc16_clusters));
+	KUNIT_EXPECT_TRUE(test, hash_empty(mc16_keys));
+}
+
+static int mc16_test_cache_id_fail(u32 *id)
+{
+	return -ENOSPC;
+}
+
+static struct mc16_key *mc16_test_cache_key_fail(void)
+{
+	return NULL;
+}
+
+static void memcomp_test_cache_reserve_nomem(struct kunit *test)
+{
+	struct mc16_test_cache_reserve *f = mc16_test_cache_begin(test);
+	struct mc16_test_storage *s;
+	unsigned int at;
+	u64 handle;
+	long charge;
+	u8 *mapped, first, last;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	s = f->storage;
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_prepare(f, 0, 128, 0), 0);
+	handle = f->initial[0].word;
+	charge = atomic_long_read(&s->owner->model.charged);
+	/* Keep header failure coverage after adding the shadow allocation. */
+	for (at = 1; at <= 3; at++) {
+		s->probe.fail_at = s->probe.allocations + at;
+		KUNIT_EXPECT_EQ(test, mc16_test_cache_reserve(f, 1), -ENOMEM);
+		s->probe.fail_at = 0;
+		KUNIT_EXPECT_TRUE(test, xa_empty(&mc16_clusters));
+		KUNIT_EXPECT_TRUE(test, hash_empty(mc16_keys));
+		KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged),
+				charge);
+	}
+	kunit_activate_static_stub(test, mc16_key_zalloc, mc16_test_cache_key_fail);
+	KUNIT_EXPECT_EQ(test, mc16_test_cache_reserve(f, 1), -ENOMEM);
+	kunit_deactivate_static_stub(test, mc16_key_zalloc);
+	s->owner->model.fail_at = atomic_read(&s->owner->model.charge_calls) + 1;
+	KUNIT_EXPECT_EQ(test, mc16_test_cache_reserve(f, 1), -ENOMEM);
+	s->owner->model.fail_at = 0;
+	kunit_activate_static_stub(test, mc16_private_id_alloc, mc16_test_cache_id_fail);
+	KUNIT_EXPECT_EQ(test, mc16_test_cache_reserve(f, 1), -ENOSPC);
+	kunit_deactivate_static_stub(test, mc16_private_id_alloc);
+	KUNIT_EXPECT_EQ(test, f->initial[0].word, handle);
+	KUNIT_EXPECT_EQ(test, f->initial[0].bytes, 128U);
+	KUNIT_EXPECT_TRUE(test, f->owned[0]);
+	KUNIT_EXPECT_EQ(test, s->nr, 0U);
+	KUNIT_EXPECT_PTR_EQ(test, s->refs[0].slot, NULL);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged), charge);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(s->owner->folio), 1);
+	KUNIT_EXPECT_TRUE(test, xa_empty(&mc16_clusters));
+	KUNIT_EXPECT_TRUE(test, hash_empty(mc16_keys));
+	/* A rejected reserve must leave the real zs object mapped and intact. */
+	mapped = zs_map_object(memcomp_pools[0], handle, ZS_MM_RO);
+	first = mapped[0];
+	last = mapped[127];
+	zs_unmap_object(memcomp_pools[0], handle);
+	KUNIT_EXPECT_EQ(test, first, (u8)0x5a);
+	KUNIT_EXPECT_EQ(test, last, (u8)0x5a);
+}
+
+struct mc16_test_cache_window {
+	struct mc16_test_storage *storage;
+	int result;
+	int source_holds;
+};
+
+static void mc16_test_cache_compete(void *data)
+{
+	struct mc16_test_cache_window *window = data;
+	struct mc16_test_storage *s = window->storage;
+	struct mc16_initial_payload initial = { .word = U64_MAX };
+
+	window->source_holds = atomic_read(&s->owner->model.get_calls) -
+		atomic_read(&s->owner->model.put_calls);
+	window->result = mc16_reserve_cache(&s->owner->model.objcg,
+					    folio_nid(s->owner->folio), &initial, 1,
+					    &s->refs[s->nr]);
+	if (!window->result)
+		s->nr++;
+}
+
+static void memcomp_test_cache_reserve_race(struct kunit *test)
+{
+	struct mc16_test_cache_reserve *f = mc16_test_cache_begin(test);
+	struct mc16_test_cache_window window;
+	struct mc16_test_storage *s;
+	long charge;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	s = f->storage;
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_prepare(f, 0, 128, 0), 0);
+	window = (struct mc16_test_cache_window) { .storage = s };
+	s->probe.allocation_window = mc16_test_cache_compete;
+	s->probe.window_data = &window;
+	KUNIT_EXPECT_EQ(test, mc16_test_cache_reserve(f, 1), -EAGAIN);
+	KUNIT_EXPECT_EQ(test, window.result, 0);
+	KUNIT_EXPECT_EQ(test, window.source_holds, 1);
+	KUNIT_EXPECT_EQ(test, s->nr, 1U);
+	KUNIT_EXPECT_EQ(test, s->refs[0].slot->word, U64_MAX);
+	KUNIT_EXPECT_TRUE(test, f->owned[0]);
+	charge = 128 + s->refs[0].cluster->key->metadata_bytes;
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged), charge);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(s->owner->folio), 1);
+}
+
+static void mc16_test_cache_retire_window(void *data)
+{
+	struct mc16_test_cache_window *window = data;
+	struct mc16_test_storage *s = window->storage;
+
+	mc16_test_cache_drop(s);
+	window->source_holds = atomic_read(&s->owner->model.get_calls) -
+		atomic_read(&s->owner->model.put_calls);
+}
+
+static void memcomp_test_cache_reserve_retire(struct kunit *test)
+{
+	struct mc16_test_cache_reserve *f = mc16_test_cache_begin(test);
+	struct mc16_test_cache_window window;
+	struct mc16_test_storage *s;
+	struct mc16_cluster *cluster;
+	unsigned int i;
+	u32 base;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	s = f->storage;
+	for (i = 0; i < MC16_SEGMENT_SLOTS; i++)
+		KUNIT_ASSERT_EQ(test, mc16_test_cache_reserve(f, 1), 0);
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_prepare(f, 0, 128, 0), 0);
+	cluster = s->refs[0].cluster;
+	base = s->refs[0].token;
+	window = (struct mc16_test_cache_window) { .storage = s };
+	s->probe.allocation_window = mc16_test_cache_retire_window;
+	s->probe.window_data = &window;
+	/* Last-live retirement preserves X1 geometry, so X2 can append. */
+	KUNIT_ASSERT_EQ(test, mc16_test_cache_reserve(f, 1), 0);
+	KUNIT_EXPECT_EQ(test, window.source_holds, 2);
+	KUNIT_EXPECT_FALSE(test, f->owned[0]);
+	KUNIT_EXPECT_EQ(test, s->nr, MC16_SEGMENT_SLOTS + 1U);
+	KUNIT_EXPECT_PTR_EQ(test, s->refs[MC16_SEGMENT_SLOTS].cluster, cluster);
+	KUNIT_EXPECT_EQ(test, s->refs[MC16_SEGMENT_SLOTS].token,
+			base + MC16_SEGMENT_SLOTS);
+	KUNIT_EXPECT_EQ(test, cluster->live_slots, 1U);
+	KUNIT_EXPECT_EQ(test, cluster->next, MC16_SEGMENT_SLOTS + 1U);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged),
+			128L + cluster->key->metadata_bytes);
+	KUNIT_EXPECT_FALSE(test, xa_empty(&mc16_clusters));
+	KUNIT_EXPECT_FALSE(test, hash_empty(mc16_keys));
+}
+
+static void memcomp_test_cache_reserve_root(struct kunit *test)
+{
+	struct mc16_test_cache_reserve *f = mc16_test_cache_begin(test);
+	struct mc16_initial_payload initial = { .word = U64_MAX };
+	struct mc16_test_storage *s;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	s = f->storage;
+	KUNIT_ASSERT_EQ(test, mc16_reserve_cache(NULL, folio_nid(s->owner->folio),
+						 &initial, 1, s->refs), 0);
+	s->nr = 1;
+	KUNIT_EXPECT_PTR_EQ(test, s->refs[0].cluster->key->objcg, NULL);
+			    KUNIT_EXPECT_EQ(test, s->refs[0].slot->word, U64_MAX);
+	KUNIT_EXPECT_EQ(test, s->refs[0].slot->length, (u16)0);
+	KUNIT_EXPECT_EQ(test, s->refs[0].slot->flags, (u16)MC16_SAMEFILL);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged), 0L);
+	mc16_test_cache_drop(s);
+}
+#endif /* CONFIG_MEMCG */
+#endif /* _MM_MEMCOMP_TESTS_CACHE_RESERVE_TEST_H */
diff --git a/mm/memcomp/tests/cache_store_test.h b/mm/memcomp/tests/cache_store_test.h
new file mode 100644
index 0000000..1aefd8e
--- /dev/null
+++ b/mm/memcomp/tests/cache_store_test.h
@@ -0,0 +1,216 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_CACHE_STORE_TEST_H
+#define _MM_MEMCOMP_TESTS_CACHE_STORE_TEST_H
+#ifdef CONFIG_MEMCG
+struct mc16_test_cache_producer {
+	struct mc16_test_refs *refs;
+	struct memcomp_ref cache;
+	struct memcomp_ref private;
+};
+
+static void mc16_test_cache_producer_cleanup(void *data)
+{
+	struct mc16_test_cache_producer *f = data;
+
+	if (f->private.slot) {
+		mc16_release_resources(&f->private);
+		mc16_retire_slot(&f->private);
+	}
+	if (f->cache.slot)
+		mc16_ref_put(&f->cache);
+}
+
+static struct mc16_test_cache_producer *
+mc16_test_cache_producer_begin(struct kunit *test)
+{
+	struct mc16_test_cache_producer *f;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->refs = mc16_test_refs_begin(test);
+	if (!f->refs || kunit_add_action_or_reset(test,
+						  mc16_test_cache_producer_cleanup, f))
+		return NULL;
+	return f;
+}
+
+static void mc16_test_cache_roundtrip(struct kunit *test, bool samefill)
+{
+	const unsigned long pattern = 0x9876543210fedcbaUL;
+	struct mc16_test_cache_producer *f = mc16_test_cache_producer_begin(test);
+	struct mc16_test_storage *storage;
+	void *src, *dst;
+	unsigned int i;
+	int folio_refs;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	storage = f->refs->storage;
+	src = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	dst = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	KUNIT_ASSERT_NOT_NULL(test, dst);
+	if (samefill)
+		memset_l(src, pattern, PAGE_SIZE / sizeof(unsigned long));
+	else
+		for (i = 0; i < PAGE_SIZE; i++)
+			((u8 *)src)[i] = i % 53;
+	folio_refs = folio_ref_count(storage->owner->folio);
+	KUNIT_ASSERT_EQ(test, mc16_cache_store(src, storage->owner->folio,
+					       &f->cache), 0);
+	KUNIT_EXPECT_EQ(test, mc16_flags_state(f->cache.slot->flags),
+			(unsigned int)(samefill ? MC16_SAMEFILL : MC16_STORED));
+	KUNIT_EXPECT_FALSE(test, f->cache.slot->flags &
+				 (MC16_F_OWNER | MC16_F_RESIDENT));
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->cache.slot->refs), 1U);
+	KUNIT_EXPECT_EQ(test, f->cache.cluster->key->kind, (u8)MC16_KEY_SHMEM);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(storage->owner->folio), folio_refs);
+	KUNIT_EXPECT_EQ(test, f->cache.cluster->eligible_slots,
+			(u16)(samefill ? 0 : 1));
+	KUNIT_ASSERT_EQ(test, mc16_load_page(&f->cache, dst), 0);
+	KUNIT_EXPECT_EQ(test, memcmp(src, dst, PAGE_SIZE), 0);
+	mc16_ref_put(&f->cache);
+	/* Payload release precedes explicit reclaim of the retained header. */
+	mc16_test_reclaim_retained();
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&storage->owner->model.charged), 0L);
+	KUNIT_EXPECT_TRUE(test, xa_empty(&mc16_clusters));
+}
+
+static void memcomp_test_cache_store_samefill(struct kunit *test)
+{
+	mc16_test_cache_roundtrip(test, true);
+}
+
+static void memcomp_test_cache_store_compressed(struct kunit *test)
+{
+	mc16_test_cache_roundtrip(test, false);
+}
+
+static void mc16_test_cache_prepare_failure(struct kunit *test, bool charge)
+{
+	struct mc16_test_cache_producer *f = mc16_test_cache_producer_begin(test);
+	struct mc16_test_storage *storage;
+	u8 *src;
+	unsigned int i;
+	int folio_refs;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	storage = f->refs->storage;
+	src = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	for (i = 0; i < PAGE_SIZE; i++)
+		src[i] = i % 53;
+	folio_refs = folio_ref_count(storage->owner->folio);
+	if (charge)
+		storage->owner->model.fail_at =
+			atomic_read(&storage->owner->model.charge_calls) + 1;
+	else
+		storage->probe.fail_at = storage->probe.allocations + 1;
+	KUNIT_EXPECT_EQ(test, mc16_cache_store(src, storage->owner->folio,
+					       &f->cache), -ENOMEM);
+	storage->owner->model.fail_at = 0;
+	storage->probe.fail_at = 0;
+	KUNIT_EXPECT_PTR_EQ(test, f->cache.slot, NULL);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(storage->owner->folio), folio_refs);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&storage->owner->model.charged), 0L);
+	KUNIT_EXPECT_TRUE(test, xa_empty(&mc16_clusters));
+	KUNIT_EXPECT_TRUE(test, hash_empty(mc16_keys));
+	KUNIT_EXPECT_EQ(test, atomic_read(&storage->owner->model.get_calls),
+			atomic_read(&storage->owner->model.put_calls));
+}
+
+static void memcomp_test_cache_store_charge_failure(struct kunit *test)
+{
+	mc16_test_cache_prepare_failure(test, true);
+}
+
+static void memcomp_test_cache_store_reserve_failure(struct kunit *test)
+{
+	mc16_test_cache_prepare_failure(test, false);
+}
+
+/* Schedule the publication-window interleaving on an already linked cluster. */
+static void memcomp_test_cache_publish_window(struct kunit *test)
+{
+	struct mc16_test_cache_producer *f = mc16_test_cache_producer_begin(test);
+	struct mc16_initial_payload initial = { .bytes = 128 };
+	struct memcomp_ref guard, active;
+	struct mc16_test_storage *s;
+	struct memcomp_lru *fifo;
+	struct mc16_view view;
+	unsigned long handle;
+	unsigned int budget, i;
+	unsigned short owner_id;
+	u8 *src;
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	s = f->refs->storage;
+	src = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	for (i = 0; i < PAGE_SIZE; i++)
+		src[i] = i % 53;
+	KUNIT_ASSERT_EQ(test, mc16_cache_store(src, s->owner->folio, &f->cache), 0);
+	fifo = mc16_fifo_of(&f->cache);
+	KUNIT_ASSERT_EQ(test, memcomp_zs_malloc(memcomp_pools[0], initial.bytes,
+						&handle, false), 0);
+	initial.word = handle;
+	ret = memcomp_objcg_charge(&s->owner->model.objcg,
+				   GFP_NOWAIT | __GFP_NOWARN, initial.bytes);
+	if (ret) {
+		memcomp_zs_free(0, handle);
+		KUNIT_FAIL(test, "payload charge failed: %d", ret);
+		return;
+	}
+	ret = mc16_source_id_get(s->owner->folio, &owner_id);
+	if (!ret) {
+		ret = mc16_reserve_cache_id(&s->owner->model.objcg, owner_id,
+					    folio_nid(s->owner->folio), &initial, 1,
+					    &f->private);
+		mem_cgroup_memcomp_id_put(owner_id);
+	}
+	if (ret) {
+		memcomp_objcg_uncharge(&s->owner->model.objcg, initial.bytes);
+		memcomp_zs_free(0, handle);
+		KUNIT_FAIL(test, "private reserve failed: %d", ret);
+		return;
+	}
+	KUNIT_EXPECT_PTR_EQ(test, f->private.cluster, f->cache.cluster);
+	KUNIT_EXPECT_EQ(test, f->private.cluster->live_slots, 2U);
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->private.slot->refs), 0U);
+	KUNIT_EXPECT_FALSE(test, mc16_get(f->private.token, &guard));
+	f->private.cluster->wb_cursor = f->private.token & (MC16_CLUSTER_SLOTS - 1);
+	budget = 1;
+	KUNIT_EXPECT_FALSE(test, mc16_fifo_select(fifo, &budget, &guard));
+	KUNIT_EXPECT_EQ(test, budget, 0U);
+	KUNIT_EXPECT_EQ(test, f->private.cluster->eligible_slots, (u16)1);
+	/* The old last STORED may disappear before new eligibility is recorded. */
+	mc16_ref_put(&f->cache);
+	KUNIT_EXPECT_TRUE(test, list_empty(&fifo->entries));
+	KUNIT_EXPECT_EQ(test, f->private.cluster->live_slots, 1U);
+	mc16_cache_publish(&f->private, initial.bytes);
+	active = f->private;
+	f->private = (struct memcomp_ref) { };
+	f->cache = active;
+	KUNIT_EXPECT_EQ(test, active.cluster->eligible_slots, (u16)1);
+	active.cluster->wb_cursor = active.token & (MC16_CLUSTER_SLOTS - 1);
+	budget = 1;
+	KUNIT_ASSERT_TRUE(test, mc16_fifo_select(fifo, &budget, &guard));
+	KUNIT_EXPECT_PTR_EQ(test, guard.slot, active.slot);
+	mutex_lock(memcomp_lock_of(guard.token));
+	if (mc16_view_locked(&guard, &view)) {
+		mc16_fifo_transition(&guard, MC16_STORED, MC16_WRITEBACK);
+		*view.flags = MC16_WRITEBACK;
+	}
+	mutex_unlock(memcomp_lock_of(guard.token));
+	KUNIT_EXPECT_EQ(test, active.cluster->eligible_slots, (u16)0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&fifo->entries));
+	mc16_ref_put(&guard);
+	mc16_ref_put(&f->cache);
+	/* Payload release precedes explicit reclaim of the retained header. */
+	mc16_test_reclaim_retained();
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&s->owner->model.charged), 0L);
+	KUNIT_EXPECT_TRUE(test, xa_empty(&mc16_clusters));
+}
+#endif /* CONFIG_MEMCG */
+#endif /* _MM_MEMCOMP_TESTS_CACHE_STORE_TEST_H */
diff --git a/mm/memcomp/tests/cache_xarray_race_test.h b/mm/memcomp/tests/cache_xarray_race_test.h
new file mode 100644
index 0000000..4b6ff05
--- /dev/null
+++ b/mm/memcomp/tests/cache_xarray_race_test.h
@@ -0,0 +1,193 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_CACHE_XARRAY_RACE_TEST_H
+#define _MM_MEMCOMP_TESTS_CACHE_XARRAY_RACE_TEST_H
+
+/* Include after shmem_retry_test.h. No load/error return is synthesized. */
+#ifdef MC16_SHMEM_RETRY_TEST_ENABLED
+struct mc16_cxr {
+	struct mc16_sr_test *sr;
+	struct folio *lost;
+	unsigned int calls, refs_before, refs_truncated;
+	u64 before[2], after[2], truncated_word;
+	int errors[2];
+	bool locked, unmapped, uptodate, bytes, entry_matched, emptied;
+};
+
+static struct mc16_cxr *mc16_cxr_current;
+
+static bool mc16_cxr_bytes(struct folio *folio, struct folio *source)
+{
+	void *a = kmap_local_folio(source, 0);
+	void *b = kmap_local_folio(folio, 0);
+	bool same = !memcmp(a, b, PAGE_SIZE);
+
+	kunmap_local(b);
+	kunmap_local(a);
+	return same;
+}
+
+static void mc16_cxr_cleanup(void *data)
+{
+	struct mc16_cxr *p = data;
+
+	mc16_cxr_current = NULL;
+	if (p->lost) {
+		/* The original outer call owns unlock/put; retain only our pin. */
+		KUNIT_EXPECT_FALSE(p->sr->test, folio_test_locked(p->lost));
+		if (folio_test_locked(p->lost))
+			folio_unlock(p->lost);
+		folio_clear_active(p->lost);
+		folio_put(p->lost);
+	}
+	/* A failed native-state assertion must not leave active on final put. */
+	folio_clear_active(p->sr->probe);
+}
+
+static int mc16_cxr_load(struct memcomp_ref *ref, struct folio *folio)
+{
+	struct mc16_cxr *p = mc16_cxr_current;
+	struct mc16_sr_test *f = p->sr;
+	struct address_space *mapping = f->file->f_mapping;
+	unsigned int call = p->calls++;
+	void *entry;
+	int ret;
+
+	if (call < ARRAY_SIZE(p->before))
+		p->before[call] = mc16_sr_shadow(ref);
+	if (!call)
+		p->refs_before = refcount_read(&ref->slot->refs);
+	kunit_deactivate_static_stub(f->test, mc16_cache_load);
+	ret = mc16_cache_load(ref, folio);
+	if (call < ARRAY_SIZE(p->after)) {
+		p->after[call] = mc16_sr_shadow(ref);
+		p->errors[call] = ret;
+	}
+	if (!call && !ret) {
+		/* Native read/refault finished; this private folio is not in XA. */
+		folio_get(folio);
+		p->lost = folio;
+		p->locked = folio_test_locked(folio);
+		p->unmapped = !folio->mapping;
+		p->uptodate = folio_test_uptodate(folio);
+		p->bytes = mc16_cxr_bytes(folio, f->cache->src);
+		rcu_read_lock();
+		entry = xa_load(&mapping->i_pages, 0);
+		rcu_read_unlock();
+		p->entry_matched = entry == f->entry;
+		/* No T/XA/PTL/RCU section or local mapping survives this point. */
+		shmem_truncate_range(file_inode(f->file), 0, (loff_t)-1);
+		rcu_read_lock();
+		entry = xa_load(&mapping->i_pages, 0);
+		rcu_read_unlock();
+		p->emptied = !entry;
+		p->truncated_word = mc16_sr_shadow(ref);
+		p->refs_truncated = refcount_read(&ref->slot->refs);
+	}
+	kunit_activate_static_stub(f->test, mc16_cache_load, mc16_cxr_load);
+	return ret;
+}
+
+static void memcomp_test_cache_xarray_race_no_restore(struct kunit *test)
+{
+	struct mc16_sr_test *f = mc16_sr_begin(test);
+	struct mc16_cxr *p;
+	struct memcomp_ref stale = { };
+	struct address_space *mapping;
+	struct shmem_inode_info *info;
+	unsigned long token;
+	blkcnt_t blocks;
+	void *data, *entry;
+	bool zero, found;
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	p = kunit_kzalloc(test, sizeof(*p), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, p);
+	p->sr = f;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, mc16_cxr_cleanup, p), 0);
+	mc16_cxr_current = p;
+	/* Use real eviction/publication; no PUBLISHING-delay or read-error stub. */
+	KUNIT_ASSERT_EQ(test, mc16_sr_pageout(f), 0);
+	mapping = f->file->f_mapping;
+	info = SHMEM_I(file_inode(f->file));
+	rcu_read_lock();
+	f->entry = xa_load(&mapping->i_pages, 0);
+	rcu_read_unlock();
+	KUNIT_ASSERT_TRUE(test, xa_is_value(f->entry));
+	KUNIT_ASSERT_TRUE(test, is_memcomp_entry(radix_to_swp_entry(f->entry)));
+	token = swp_offset(radix_to_swp_entry(f->entry));
+	f->cache->token = token;
+	KUNIT_ASSERT_NE(test, token, 0UL);
+	KUNIT_ASSERT_TRUE(test, mc16_get(token, &f->cache->guard));
+	KUNIT_ASSERT_TRUE(test, xa_is_value((void *)(unsigned long)
+			mc16_sr_shadow(&f->cache->guard)));
+	KUNIT_ASSERT_NE(test, mc16_sr_shadow(&f->cache->guard),
+			(u64)MC16_SHADOW_PUBLISHING);
+	KUNIT_ASSERT_EQ(test, refcount_read(&f->cache->guard.slot->refs), 2U);
+	blocks = file_inode(f->file)->i_blocks;
+	kunit_activate_static_stub(test, mc16_cache_load, mc16_cxr_load);
+	ret = mc16_sr_outer(f);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	KUNIT_ASSERT_EQ(test, p->calls, 1U);
+	KUNIT_ASSERT_NOT_NULL(test, p->lost);
+	KUNIT_ASSERT_NOT_NULL(test, f->result);
+	KUNIT_EXPECT_EQ(test, p->errors[0], 0);
+	KUNIT_EXPECT_TRUE(test, xa_is_value((void *)(unsigned long)p->before[0]));
+	KUNIT_EXPECT_EQ(test, p->after[0], 0ULL);
+	KUNIT_EXPECT_EQ(test, p->truncated_word, 0ULL);
+	KUNIT_EXPECT_TRUE(test, p->locked);
+	KUNIT_EXPECT_TRUE(test, p->unmapped);
+	KUNIT_EXPECT_TRUE(test, p->uptodate);
+	KUNIT_EXPECT_TRUE(test, p->bytes);
+	KUNIT_EXPECT_TRUE(test, p->entry_matched);
+	KUNIT_EXPECT_TRUE(test, p->emptied);
+	KUNIT_EXPECT_EQ(test, p->refs_before, 3U);
+	KUNIT_EXPECT_EQ(test, p->refs_truncated, 2U);
+	KUNIT_EXPECT_PTR_EQ(test, p->lost->mapping, NULL);
+	KUNIT_EXPECT_FALSE(test, folio_test_locked(p->lost));
+	KUNIT_EXPECT_EQ(test, folio_ref_count(p->lost), 1);
+	KUNIT_EXPECT_PTR_NE(test, p->lost, f->result);
+	KUNIT_EXPECT_TRUE(test, f->result_locked);
+	KUNIT_EXPECT_TRUE(test, f->result_uptodate);
+	KUNIT_EXPECT_TRUE(test, f->result_mapping);
+	KUNIT_EXPECT_EQ(test, folio_order(f->result), 0U);
+	data = kmap_local_folio(f->result, 0);
+	zero = !memchr_inv(data, 0, PAGE_SIZE);
+	kunmap_local(data);
+	KUNIT_EXPECT_TRUE(test, zero);
+	rcu_read_lock();
+	entry = xa_load(&mapping->i_pages, 0);
+	rcu_read_unlock();
+	KUNIT_EXPECT_PTR_EQ(test, entry, f->result);
+	KUNIT_EXPECT_EQ(test, info->alloced, 1UL);
+	KUNIT_EXPECT_EQ(test, info->swapped, 0UL);
+	KUNIT_EXPECT_EQ(test, mapping->nrpages, 1UL);
+	KUNIT_EXPECT_EQ(test, file_inode(f->file)->i_blocks, blocks);
+	KUNIT_EXPECT_EQ(test, mc16_sr_shadow(&f->cache->guard), 0ULL);
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->cache->guard.slot->refs), 1U);
+	/* Old XA owner is gone; the retained real guard still pins its payload. */
+	ret = mc16_user_charge(&f->cache->guard, f->probe, NULL, GFP_KERNEL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	folio_lock(f->probe);
+	folio_set_swapbacked(f->probe);
+	ret = mc16_cache_load(&f->cache->guard, f->probe);
+	folio_unlock(f->probe);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, p->calls, 2U);
+	KUNIT_EXPECT_EQ(test, p->errors[1], 0);
+	KUNIT_EXPECT_EQ(test, p->before[1], 0ULL);
+	KUNIT_EXPECT_EQ(test, p->after[1], 0ULL);
+	KUNIT_EXPECT_TRUE(test, folio_test_uptodate(f->probe));
+	KUNIT_EXPECT_TRUE(test, mc16_cxr_bytes(f->probe, f->cache->src));
+	KUNIT_EXPECT_FALSE(test, folio_test_workingset(f->probe));
+	KUNIT_EXPECT_FALSE(test, folio_test_active(f->probe));
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->cache->guard.slot->refs), 1U);
+	mc16_ref_put(&f->cache->guard);
+	KUNIT_EXPECT_PTR_EQ(test, f->cache->guard.slot, NULL);
+	found = mc16_get(token, &stale);
+	KUNIT_EXPECT_FALSE(test, found);
+	if (found)
+		mc16_ref_put(&stale);
+}
+#endif /* MC16_SHMEM_RETRY_TEST_ENABLED */
+#endif /* _MM_MEMCOMP_TESTS_CACHE_XARRAY_RACE_TEST_H */
diff --git a/mm/memcomp/tests/codec_scope_test.h b/mm/memcomp/tests/codec_scope_test.h
new file mode 100644
index 0000000..5f1732f
--- /dev/null
+++ b/mm/memcomp/tests/codec_scope_test.h
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_CODEC_SCOPE_TEST_H
+#define _MM_MEMCOMP_TESTS_CODEC_SCOPE_TEST_H
+
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+#include <kunit/test.h>
+
+/* Include after the production async and store-precomp definitions. */
+static void memcomp_test_async_error_recycled(struct kunit *test)
+{
+	const int errors[] = { -EIO, -EHWPOISON };
+	struct memcomp_store_ctx store = {};
+	struct memcomp_async_pool *pool;
+	struct memcomp_async *batch, *got;
+	struct memcomp_async_req *r;
+	unsigned int i, wait_first;
+
+	pool = kunit_kzalloc(test, sizeof(*pool), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, pool);
+	batch = kunit_kzalloc(test, sizeof(*batch), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, batch);
+	r = &batch->reqs[0];
+	r->req = kunit_kzalloc(test, sizeof(*r->req), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, r->req);
+	r->async = batch;
+	/* Failed output must never become an accepted precomputed payload. */
+	r->buf = NULL;
+	store.precomp = r;
+	spin_lock_init(&pool->lock);
+	init_completion(&batch->done);
+	pool->nr = 1;
+	pool->free = BIT(0);
+	pool->batches[0] = batch;
+
+	for (i = 0; i < ARRAY_SIZE(errors); i++) {
+		for (wait_first = 0; wait_first < 2; wait_first++) {
+			got = memcomp_async_take(pool, 0);
+			KUNIT_ASSERT_PTR_EQ(test, got, batch);
+			KUNIT_EXPECT_EQ(test, got->nr, 0U);
+			KUNIT_EXPECT_EQ(test, pool->free, 0UL);
+			got->nr = 1;
+			r->ret = -EAGAIN;
+			r->len = 0;
+			r->req->dlen = PAGE_SIZE;
+			atomic_inc(&got->pending);
+			/* Model a waiter dropping its sentinel before completion. */
+			if (wait_first)
+				atomic_dec(&got->pending);
+
+			/* A backlog notification neither finishes nor frees a batch. */
+			memcomp_async_done(r, -EINPROGRESS);
+			KUNIT_ASSERT_EQ(test, atomic_read(&got->pending),
+					wait_first ? 1 : 2);
+			KUNIT_EXPECT_EQ(test, r->ret, -EAGAIN);
+			KUNIT_EXPECT_EQ(test, r->len, 0U);
+			KUNIT_EXPECT_FALSE(test, completion_done(&got->done));
+			KUNIT_EXPECT_EQ(test, pool->free, 0UL);
+
+			memcomp_async_done(r, errors[i]);
+			KUNIT_EXPECT_EQ(test, r->ret, errors[i]);
+			KUNIT_EXPECT_EQ(test, r->len, (unsigned int)PAGE_SIZE);
+			KUNIT_EXPECT_NULL(test, memcomp_store_precomp(&store, 0));
+			KUNIT_ASSERT_EQ(test, atomic_read(&got->pending),
+					wait_first ? 0 : 1);
+			KUNIT_EXPECT_EQ(test, completion_done(&got->done),
+					(bool)wait_first);
+			memcomp_async_give(pool, got);
+			KUNIT_EXPECT_EQ(test, atomic_read(&got->pending), 0);
+			KUNIT_ASSERT_EQ(test, pool->free, BIT(0));
+		}
+	}
+
+	/* The last error must leave the same batch available for another run. */
+	got = memcomp_async_take(pool, 0);
+	KUNIT_ASSERT_PTR_EQ(test, got, batch);
+	KUNIT_EXPECT_EQ(test, got->nr, 0U);
+	KUNIT_EXPECT_FALSE(test, completion_done(&got->done));
+	memcomp_async_give(pool, got);
+	KUNIT_EXPECT_EQ(test, pool->free, BIT(0));
+}
+
+static struct kunit_case memcomp_codec_scope_test_cases[] = {
+	KUNIT_CASE(memcomp_test_async_error_recycled),
+	{}
+};
+
+static struct kunit_suite memcomp_codec_scope_test_suite = {
+	.name = "memcomp-codec-scope",
+	.test_cases = memcomp_codec_scope_test_cases,
+};
+
+kunit_test_suite(memcomp_codec_scope_test_suite);
+#endif /* CONFIG_MEMCOMP_KUNIT_TEST */
+#endif /* _MM_MEMCOMP_TESTS_CODEC_SCOPE_TEST_H */
diff --git a/mm/memcomp/tests/consumers_test.h b/mm/memcomp/tests/consumers_test.h
new file mode 100644
index 0000000..e7dbf30
--- /dev/null
+++ b/mm/memcomp/tests/consumers_test.h
@@ -0,0 +1,478 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_CONSUMERS_TEST_H
+#define _MM_MEMCOMP_TESTS_CONSUMERS_TEST_H
+
+#include <kunit/test.h>
+#include "../consumers.h"
+
+/*
+ * Include in suite.h after the storage probe implementation. Register
+ * the cases in the enclosing suite. Load-touch assertions exercise the shared
+ * load helper used by the public clustered-slot dispatch.
+ */
+#ifdef CONFIG_MEMCG
+struct mc16_consumer_test {
+	struct kunit *test;
+	struct memcomp_kunit_objcg model;
+	struct mc16_storage_fixture probe;
+	struct folio *account;
+	struct folio *dst;
+	struct folio *large;
+	struct memcomp_ref owners[3];
+	struct memcomp_ref guard;
+	unsigned long tokens[3];
+	unsigned int pte_refs[3];
+	unsigned int zero_pte;
+	unsigned int zero_cache;
+	s64 stored_before;
+	s64 compressed_before;
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	s64 pending_before;
+#endif
+};
+
+/* No test-task context, folio lock, T or local mapping survives an actor. */
+static void mc16_consumer_test_cleanup(void *data)
+{
+	struct mc16_consumer_test *f = data;
+	unsigned int i;
+
+	f->probe.fail_at = 0;
+	f->probe.fail_descriptor = false;
+	f->probe.allocation_window = NULL;
+	f->model.fail_at = 0;
+	mc16_cache_abort(&f->guard);
+	for (i = 0; i < ARRAY_SIZE(f->owners); i++) {
+		while (f->pte_refs[i]) {
+			mc16_pte_put_nr(f->tokens[i], 1);
+			f->pte_refs[i]--;
+		}
+		if (f->owners[i].slot)
+			mc16_ref_put(&f->owners[i]);
+	}
+	mc16_zero_pte_put(f->zero_pte);
+	mc16_zero_cache_put(f->zero_cache);
+	mc16_test_drain_segments(&f->probe);
+	mc16_test_reclaim_retained();
+	KUNIT_EXPECT_TRUE(f->test, xa_empty(&mc16_clusters));
+	KUNIT_EXPECT_TRUE(f->test, hash_empty(mc16_keys));
+	KUNIT_EXPECT_EQ(f->test, atomic_long_read(&f->model.charged), 0L);
+	KUNIT_EXPECT_EQ(f->test, atomic_read(&f->model.get_calls),
+			atomic_read(&f->model.put_calls));
+	KUNIT_EXPECT_EQ(f->test, atomic64_read(&memcomp_stored_bytes),
+			f->stored_before);
+	KUNIT_EXPECT_EQ(f->test, atomic64_read(&memcomp_compressed_bytes),
+			f->compressed_before);
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	KUNIT_EXPECT_EQ(f->test, atomic64_read(&memcomp_pending_pages),
+			f->pending_before);
+#endif
+	if (rcu_access_pointer(mc16_storage_fixture) == &f->probe)
+		rcu_assign_pointer(mc16_storage_fixture, NULL);
+	if (rcu_access_pointer(memcomp_kunit_objcg) == &f->model)
+		rcu_assign_pointer(memcomp_kunit_objcg, NULL);
+	synchronize_rcu();
+	if (f->large) {
+		KUNIT_EXPECT_FALSE(f->test, folio_test_locked(f->large));
+		folio_put(f->large);
+	}
+	if (f->dst) {
+		KUNIT_EXPECT_FALSE(f->test, folio_test_locked(f->dst));
+		folio_put(f->dst);
+	}
+	if (f->account) {
+		KUNIT_EXPECT_FALSE(f->test, folio_test_locked(f->account));
+		KUNIT_EXPECT_EQ(f->test, folio_ref_count(f->account), 1);
+		folio_put(f->account);
+	}
+}
+
+/* Unlike the older objcg fixture, account/dst remain unlocked on return. */
+static struct mc16_consumer_test *mc16_consumer_test_begin(struct kunit *test)
+{
+	struct mc16_consumer_test *f;
+
+	if (!memcomp_is_enabled()) {
+		kunit_skip(test, "memcomp initialization failed");
+		return NULL;
+	}
+	rcu_barrier();
+	if (rcu_access_pointer(memcomp_kunit_objcg) ||
+	    rcu_access_pointer(mc16_storage_fixture) || !xa_empty(&mc16_clusters)) {
+		KUNIT_FAIL(test, "consumer fixture requires an idle registry/model");
+		return NULL;
+	}
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->test = test;
+	f->stored_before = atomic64_read(&memcomp_stored_bytes);
+	f->compressed_before = atomic64_read(&memcomp_compressed_bytes);
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	f->pending_before = atomic64_read(&memcomp_pending_pages);
+#endif
+	f->model.task = current;
+	f->model.error = -ENOMEM;
+	f->probe.task = current;
+	if (kunit_add_action_or_reset(test, mc16_consumer_test_cleanup, f))
+		return NULL;
+	f->account = folio_alloc(GFP_KERNEL, 0);
+	f->dst = folio_alloc(GFP_KERNEL, 0);
+	if (!f->account || !f->dst)
+		return NULL;
+	/* Native eviction uses source-folio charge, not the objcg model. */
+	if (mem_cgroup_charge(f->account, NULL, GFP_KERNEL)) {
+		KUNIT_FAIL(test, "consumer source memcg charge failed");
+		return NULL;
+	}
+	f->model.folio = f->account;
+	rcu_assign_pointer(memcomp_kunit_objcg, &f->model);
+	rcu_assign_pointer(mc16_storage_fixture, &f->probe);
+	return f;
+}
+
+static int mc16_consumer_test_reserve(struct mc16_consumer_test *f,
+				      unsigned int index)
+{
+	struct mc16_record *record;
+	int ret;
+
+	record = mc16_record_alloc(f->account, 1, false);
+	if (IS_ERR(record))
+		return PTR_ERR(record);
+	ret = mc16_reserve(record, 1, MC16_KEY_ANON, &f->owners[index]);
+	if (ret) {
+		mc16_record_abort(record);
+		return ret;
+	}
+	mc16_account_reservation(&f->owners[index]);
+	f->tokens[index] = f->owners[index].token;
+	return 0;
+}
+
+static int mc16_consumer_test_store(struct mc16_consumer_test *f,
+				    const void *src)
+{
+	int ret = mc16_cache_store(src, f->account, &f->owners[0]);
+
+	if (!ret)
+		f->tokens[0] = f->owners[0].token;
+	return ret;
+}
+
+/* Every lock/mapping is released before returning to KUnit assertions. */
+static int mc16_consumer_test_load(struct memcomp_ref *ref, struct folio *folio,
+				   bool zero)
+{
+	int ret;
+
+	folio_lock(folio);
+	ret = zero ? mc16_cache_load_zero(folio) : mc16_cache_load(ref, folio);
+	folio_unlock(folio);
+	return ret;
+}
+
+static void mc16_consumer_test_fill(struct folio *folio, u8 byte)
+{
+	void *dst = kmap_local_folio(folio, 0);
+
+	memset(dst, byte, PAGE_SIZE);
+	kunmap_local(dst);
+	folio_clear_uptodate(folio);
+}
+
+static bool mc16_consumer_test_bytes(struct folio *folio, u8 byte)
+{
+	void *dst = kmap_local_folio(folio, 0);
+	bool same = !memchr_inv(dst, byte, PAGE_SIZE);
+
+	kunmap_local(dst);
+	return same;
+}
+
+static bool mc16_consumer_test_matches(struct folio *folio, const void *src)
+{
+	void *dst = kmap_local_folio(folio, 0);
+	bool same = !memcmp(dst, src, PAGE_SIZE);
+
+	kunmap_local(dst);
+	return same;
+}
+
+static bool mc16_consumer_test_touch(struct memcomp_ref *ref, bool set)
+{
+	struct mc16_view view;
+	bool touched = false;
+
+	mutex_lock(memcomp_lock_of(ref->token));
+	if (mc16_view_locked(ref, &view)) {
+		if (set)
+			*view.flags |= MC16_F_REFRESH_PENDING;
+		touched = !!(*view.flags & MC16_F_REFERENCED);
+	}
+	mutex_unlock(memcomp_lock_of(ref->token));
+	return touched;
+}
+
+static void memcomp_test_consumer_pte_shared(struct kunit *test)
+{
+	struct mc16_consumer_test *f = mc16_consumer_test_begin(test);
+	struct memcomp_ref *owner;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_EQ(test, mc16_consumer_test_reserve(f, 0), 0);
+	owner = &f->owners[0];
+	KUNIT_ASSERT_TRUE(test, mc16_pte_get(f->tokens[0]));
+	f->pte_refs[0]++;
+	KUNIT_ASSERT_TRUE(test, mc16_pte_get(f->tokens[0]));
+	f->pte_refs[0]++;
+	KUNIT_EXPECT_EQ(test, refcount_read(&owner->slot->refs), 3U);
+	mc16_pte_put_nr(f->tokens[0], 1);
+	f->pte_refs[0]--;
+	KUNIT_EXPECT_EQ(test, refcount_read(&owner->slot->refs), 2U);
+	mc16_pte_put_nr(f->tokens[0], 1);
+	f->pte_refs[0]--;
+	KUNIT_EXPECT_EQ(test, refcount_read(&owner->slot->refs), 1U);
+	KUNIT_EXPECT_TRUE(test, owner->slot->flags & MC16_F_OWNER);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(f->account), 2);
+}
+
+static void memcomp_test_consumer_pte_bounds(struct kunit *test)
+{
+	struct mc16_consumer_test *f = mc16_consumer_test_begin(test);
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	for (i = 0; i < ARRAY_SIZE(f->owners); i++) {
+		KUNIT_ASSERT_EQ(test, mc16_consumer_test_reserve(f, i), 0);
+		KUNIT_ASSERT_TRUE(test, mc16_pte_get(f->tokens[i]));
+		f->pte_refs[i]++;
+		KUNIT_ASSERT_EQ(test, f->tokens[i], f->tokens[0] + i);
+	}
+	mc16_pte_put_nr(f->tokens[0], 0);
+	mc16_pte_put_nr(U32_MAX, 2);
+	mc16_pte_put_nr(U32_MAX, UINT_MAX);
+	mc16_pte_put_nr(ULONG_MAX, 0);
+#if BITS_PER_LONG > 32
+	KUNIT_EXPECT_FALSE(test, mc16_pte_get(BIT_ULL(32) | f->tokens[0]));
+	mc16_pte_put_nr(BIT_ULL(32) | f->tokens[0], 3);
+	mc16_cache_drop(BIT_ULL(32) | f->tokens[0]);
+	KUNIT_EXPECT_FALSE(test, mc16_cache_pin(BIT_ULL(32) | f->tokens[0],
+						&f->guard));
+#endif
+	for (i = 0; i < ARRAY_SIZE(f->owners); i++)
+		KUNIT_EXPECT_EQ(test, refcount_read(&f->owners[i].slot->refs), 2U);
+	mc16_pte_put_nr(f->tokens[0], ARRAY_SIZE(f->owners));
+	for (i = 0; i < ARRAY_SIZE(f->owners); i++) {
+		f->pte_refs[i]--;
+		KUNIT_EXPECT_EQ(test, refcount_read(&f->owners[i].slot->refs), 1U);
+	}
+}
+
+static void mc16_consumer_test_roundtrip(struct kunit *test, bool samefill,
+					 bool commit)
+{
+	const unsigned long pattern = 0x9876543210fedcbaUL;
+	struct mc16_consumer_test *f = mc16_consumer_test_begin(test);
+	struct mc16_slot *slot;
+	unsigned int i;
+	u8 *src;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	src = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	if (samefill)
+		memset_l((unsigned long *)src, pattern,
+			 PAGE_SIZE / sizeof(unsigned long));
+	else
+		for (i = 0; i < PAGE_SIZE; i++)
+			src[i] = i % 53;
+	KUNIT_ASSERT_EQ(test, mc16_consumer_test_store(f, src), 0);
+	slot = f->owners[0].slot;
+	KUNIT_EXPECT_EQ(test, mc16_flags_state(slot->flags),
+			(unsigned int)(samefill ? MC16_SAMEFILL : MC16_STORED));
+	if (commit) {
+		KUNIT_ASSERT_TRUE(test, mc16_pte_get(f->tokens[0]));
+		f->pte_refs[0]++;
+	}
+	KUNIT_ASSERT_TRUE(test, mc16_cache_pin(f->tokens[0], &f->guard));
+	KUNIT_EXPECT_PTR_EQ(test, f->guard.slot, slot);
+	mc16_consumer_test_fill(f->dst, 0xa5);
+	KUNIT_ASSERT_EQ(test, mc16_consumer_test_load(&f->guard, f->dst, false), 0);
+	KUNIT_EXPECT_PTR_EQ(test, f->guard.slot, slot);
+	KUNIT_EXPECT_TRUE(test, folio_test_uptodate(f->dst));
+	KUNIT_EXPECT_TRUE(test, mc16_consumer_test_matches(f->dst, src));
+	KUNIT_EXPECT_TRUE(test, mc16_consumer_test_touch(&f->guard, false));
+	if (!commit) {
+		mc16_cache_abort(&f->guard);
+		KUNIT_EXPECT_PTR_EQ(test, f->guard.slot, NULL);
+		KUNIT_EXPECT_EQ(test, refcount_read(&slot->refs), 1U);
+		/* Abort retained the cache owner and its complete payload. */
+		KUNIT_ASSERT_TRUE(test, mc16_cache_pin(f->tokens[0], &f->guard));
+		mc16_consumer_test_fill(f->dst, 0x5a);
+		KUNIT_ASSERT_EQ(test,
+				mc16_consumer_test_load(&f->guard, f->dst, false), 0);
+		KUNIT_EXPECT_TRUE(test, mc16_consumer_test_matches(f->dst, src));
+		mc16_cache_abort(&f->guard);
+		mc16_cache_drop(f->tokens[0]);
+		f->owners[0] = (struct memcomp_ref) { };
+	} else {
+		KUNIT_EXPECT_EQ(test, refcount_read(&slot->refs), 3U);
+		/* Model the winner of the expected-shadow xarray replacement. */
+		mc16_cache_commit(&f->guard);
+		f->owners[0] = (struct memcomp_ref) { };
+		KUNIT_EXPECT_PTR_EQ(test, f->guard.slot, NULL);
+		KUNIT_ASSERT_TRUE(test, mc16_get(f->tokens[0], &f->guard));
+		KUNIT_EXPECT_EQ(test, refcount_read(&f->guard.slot->refs), 2U);
+		mc16_cache_abort(&f->guard);
+		/* Only the shared PTE remains; its put releases the real zs payload. */
+		mc16_pte_put_nr(f->tokens[0], 1);
+		f->pte_refs[0]--;
+	}
+	KUNIT_EXPECT_FALSE(test, mc16_get(f->tokens[0], &f->guard));
+	/* Already-absent numeric tokens acquire no guard and consume nothing. */
+	mc16_cache_drop(f->tokens[0]);
+	mc16_pte_put_nr(f->tokens[0], 1);
+	/* Absent tokens do not imply the current header has been reclaimed. */
+	KUNIT_EXPECT_FALSE(test, xa_empty(&mc16_clusters));
+	mc16_test_reclaim_retained();
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&f->model.charged), 0L);
+}
+
+static void memcomp_test_consumer_cache_abort(struct kunit *test)
+{
+	mc16_consumer_test_roundtrip(test, false, false);
+}
+
+static void memcomp_test_consumer_cache_samefill(struct kunit *test)
+{
+	mc16_consumer_test_roundtrip(test, true, false);
+}
+
+static void memcomp_test_consumer_cache_commit(struct kunit *test)
+{
+	mc16_consumer_test_roundtrip(test, false, true);
+}
+
+static void memcomp_test_consumer_cache_retry(struct kunit *test)
+{
+	const unsigned long pattern = 0x0123456789abcdefUL;
+	struct mc16_consumer_test *f = mc16_consumer_test_begin(test);
+	unsigned long *src;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	src = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	memset_l(src, pattern, PAGE_SIZE / sizeof(*src));
+	KUNIT_ASSERT_EQ(test, mc16_consumer_test_store(f, src), 0);
+	KUNIT_ASSERT_TRUE(test, mc16_cache_pin(f->tokens[0], &f->guard));
+	mc16_consumer_test_touch(&f->guard, true);
+	mc16_consumer_test_fill(f->dst, 0x5a);
+	KUNIT_EXPECT_EQ(test, mc16_consumer_test_load(&f->guard, f->dst, false),
+			-EAGAIN);
+	KUNIT_EXPECT_FALSE(test, folio_test_uptodate(f->dst));
+	KUNIT_EXPECT_TRUE(test, mc16_consumer_test_bytes(f->dst, 0x5a));
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->guard.slot->refs), 2U);
+	mc16_cache_abort(&f->guard);
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->owners[0].slot->refs), 1U);
+}
+
+static void memcomp_test_consumer_zero_domains(struct kunit *test)
+{
+	struct mc16_consumer_test *f = mc16_consumer_test_begin(test);
+	struct mc16_zero_owners before, after;
+	struct mc16_zero_diagnostics events, end;
+	unsigned int allocations;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	mc16_zero_owners_read(&before);
+	mc16_zero_diagnostics_read(&events);
+	allocations = f->probe.allocations;
+	KUNIT_ASSERT_TRUE(test, mc16_zero_pte_init(2));
+	f->zero_pte += 2;
+	KUNIT_ASSERT_TRUE(test, mc16_pte_get(0));
+	f->zero_pte++;
+	KUNIT_ASSERT_TRUE(test, mc16_zero_cache_get(2));
+	f->zero_cache += 2;
+	KUNIT_EXPECT_FALSE(test, mc16_cache_pin(0, &f->guard));
+	KUNIT_EXPECT_PTR_EQ(test, f->guard.slot, NULL);
+	KUNIT_EXPECT_PTR_EQ(test, f->guard.cluster, NULL);
+	mc16_cache_abort(&f->guard);
+	mc16_cache_commit(&f->guard);
+	mc16_pte_put_nr(0, 0);
+	mc16_consumer_test_fill(f->dst, 0x5a);
+	KUNIT_EXPECT_EQ(test, mc16_consumer_test_load(NULL, f->dst, true), 0);
+	KUNIT_EXPECT_TRUE(test, folio_test_uptodate(f->dst));
+	KUNIT_EXPECT_TRUE(test, mc16_consumer_test_bytes(f->dst, 0));
+	mc16_zero_owners_read(&after);
+	KUNIT_EXPECT_EQ(test, after.pte_pages, before.pte_pages + 3);
+	KUNIT_EXPECT_EQ(test, after.cache_pages, before.cache_pages + 2);
+	/* A failed xa replacement consumes neither zero owner. */
+	KUNIT_EXPECT_EQ(test, mc16_consumer_test_load(NULL, f->dst, true), 0);
+	mc16_pte_put_nr(0, 2);
+	f->zero_pte -= 2;
+	mc16_zero_owners_read(&after);
+	KUNIT_EXPECT_EQ(test, after.pte_pages, before.pte_pages + 1);
+	KUNIT_EXPECT_EQ(test, after.cache_pages, before.cache_pages + 2);
+	/* Replacement and truncate each explicitly drop one cache owner. */
+	mc16_cache_drop(0);
+	f->zero_cache--;
+	mc16_cache_drop(0);
+	f->zero_cache--;
+	mc16_zero_owners_read(&after);
+	KUNIT_EXPECT_EQ(test, after.pte_pages, before.pte_pages + 1);
+	KUNIT_EXPECT_EQ(test, after.cache_pages, before.cache_pages);
+	mc16_pte_put_nr(0, 1);
+	f->zero_pte--;
+	mc16_zero_owners_read(&after);
+	KUNIT_EXPECT_EQ(test, after.pte_pages, before.pte_pages);
+	KUNIT_EXPECT_EQ(test, after.cache_pages, before.cache_pages);
+	KUNIT_EXPECT_EQ(test, f->probe.allocations, allocations);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->model.charge_calls), 0);
+	KUNIT_EXPECT_TRUE(test, xa_empty(&mc16_clusters));
+	mc16_zero_diagnostics_read(&end);
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	KUNIT_EXPECT_EQ(test, end.calls[MC16_ZERO_PTE_GET] -
+			events.calls[MC16_ZERO_PTE_GET], 1ULL);
+	KUNIT_EXPECT_EQ(test, end.pages[MC16_ZERO_PTE_PUT] -
+			events.pages[MC16_ZERO_PTE_PUT], 3ULL);
+	KUNIT_EXPECT_EQ(test, end.pages[MC16_ZERO_CACHE_PUT] -
+			events.pages[MC16_ZERO_CACHE_PUT], 2ULL);
+#endif
+}
+
+static void memcomp_test_consumer_load_bounds(struct kunit *test)
+{
+	struct mc16_consumer_test *f = mc16_consumer_test_begin(test);
+	const unsigned long pattern = 0x1234567812345678UL;
+	unsigned long *src;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_EXPECT_FALSE(test, mc16_cache_pin(0, NULL));
+	KUNIT_EXPECT_FALSE(test, mc16_cache_pin(ULONG_MAX, &f->guard));
+	KUNIT_EXPECT_EQ(test, mc16_cache_load(NULL, f->dst), -ENOENT);
+	KUNIT_EXPECT_EQ(test, mc16_cache_load(&f->guard, f->dst), -ENOENT);
+	KUNIT_EXPECT_EQ(test, mc16_cache_load_zero(NULL), -EINVAL);
+	mc16_consumer_test_fill(f->dst, 0xa5);
+	KUNIT_EXPECT_EQ(test, mc16_cache_load_zero(f->dst), -EINVAL);
+	KUNIT_EXPECT_TRUE(test, mc16_consumer_test_bytes(f->dst, 0xa5));
+	f->large = folio_alloc(GFP_KERNEL, 1);
+	KUNIT_ASSERT_NOT_NULL(test, f->large);
+	KUNIT_EXPECT_EQ(test, mc16_consumer_test_load(NULL, f->large, true), -EINVAL);
+	src = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	memset_l(src, pattern, PAGE_SIZE / sizeof(*src));
+	KUNIT_ASSERT_EQ(test, mc16_consumer_test_store(f, src), 0);
+	KUNIT_ASSERT_TRUE(test, mc16_cache_pin(f->tokens[0], &f->guard));
+	KUNIT_EXPECT_EQ(test, mc16_cache_load(&f->guard, NULL), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mc16_cache_load(&f->guard, f->dst), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mc16_consumer_test_load(&f->guard, f->large, false),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->guard.slot->refs), 2U);
+	mc16_cache_abort(&f->guard);
+	mc16_cache_abort(&f->guard);
+	mc16_cache_commit(&f->guard);
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->owners[0].slot->refs), 1U);
+}
+#endif /* CONFIG_MEMCG */
+#endif /* _MM_MEMCOMP_TESTS_CONSUMERS_TEST_H */
diff --git a/mm/memcomp/tests/core_test.h b/mm/memcomp/tests/core_test.h
new file mode 100644
index 0000000..86764e0
--- /dev/null
+++ b/mm/memcomp/tests/core_test.h
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_CORE_TEST_H
+#define _MM_MEMCOMP_TESTS_CORE_TEST_H
+
+#include "test_api.h"
+
+#ifdef CONFIG_MEMCG
+struct memcomp_test_owner {
+	void *record;
+	unsigned int remaining;
+};
+
+static void memcomp_test_cleanup(void *data)
+{
+	struct memcomp_test_owner *owner = data;
+
+	while (owner->remaining) {
+		owner->remaining--;
+		memcomp_test_record_put(owner->record);
+	}
+	owner->record = NULL;
+}
+
+static struct memcomp_test_owner *
+memcomp_test_new(struct kunit *test, struct folio *folio,
+		 unsigned int nr_pages)
+{
+	struct memcomp_test_owner *owner;
+	int ret;
+
+	owner = kunit_kzalloc(test, sizeof(*owner), GFP_KERNEL);
+	if (!owner)
+		return NULL;
+	owner->record = memcomp_test_record_alloc(folio, nr_pages);
+	if (IS_ERR(owner->record)) {
+		KUNIT_FAIL(test, "record allocation failed: %ld",
+			   PTR_ERR(owner->record));
+		return NULL;
+	}
+	owner->remaining = nr_pages;
+	ret = kunit_add_action_or_reset(test, memcomp_test_cleanup,
+					owner);
+	return ret ? NULL : owner;
+}
+
+static void memcomp_test_record_members(struct kunit *test)
+{
+	struct memcomp_test_objcg_fixture *f;
+	struct memcomp_test_owner *owner;
+	struct memcomp_record_info info;
+	spinlock_t lock; /* Models an atomic final-put caller. */
+	unsigned long flags;
+
+	f = memcomp_test_objcg_begin(test, 2);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	owner = memcomp_test_new(test, f->folio, 2);
+	KUNIT_ASSERT_NOT_NULL(test, owner);
+	info = memcomp_test_record_info(owner->record);
+	KUNIT_EXPECT_EQ(test, info.members, 2U);
+	KUNIT_EXPECT_EQ(test, info.charged_bytes, info.allocated_bytes);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&f->model.charged),
+			(long)info.charged_bytes);
+
+	owner->remaining--;
+	memcomp_test_record_put(owner->record);
+	info = memcomp_test_record_info(owner->record);
+	KUNIT_EXPECT_EQ(test, info.members, 1U);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->model.put_calls), 0);
+
+	/* Last member release must be valid in the atomic final-put context. */
+	spin_lock_init(&lock);
+	spin_lock_irqsave(&lock, flags);
+	owner->remaining--;
+	memcomp_test_record_put(owner->record);
+	owner->record = NULL;
+	spin_unlock_irqrestore(&lock, flags);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&f->model.charged), 0L);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->model.get_calls), 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->model.put_calls), 1);
+}
+
+static void memcomp_test_record_abort(struct kunit *test)
+{
+	struct memcomp_test_objcg_fixture *f;
+	struct memcomp_test_owner *owner;
+
+	f = memcomp_test_objcg_begin(test, 2);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	owner = memcomp_test_new(test, f->folio, 2);
+	KUNIT_ASSERT_NOT_NULL(test, owner);
+	owner->remaining = 0;
+	memcomp_test_record_handle_abort(owner->record);
+	owner->record = NULL;
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&f->model.charged), 0L);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->model.get_calls), 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->model.put_calls), 1);
+}
+
+static void memcomp_test_record_charge_failure(struct kunit *test)
+{
+	struct memcomp_test_objcg_fixture *f;
+	void *record;
+
+	f = memcomp_test_objcg_begin(test, 1);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	f->model.fail_at = 1;
+	record = memcomp_test_record_alloc(f->folio, 1);
+	if (!IS_ERR(record)) {
+		memcomp_test_record_handle_abort(record);
+		KUNIT_FAIL(test, "record metadata charge unexpectedly succeeded");
+		return;
+	}
+	KUNIT_EXPECT_EQ(test, PTR_ERR(record), (long)-ENOMEM);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&f->model.charged), 0L);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->model.get_calls), 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->model.put_calls), 1);
+}
+#endif /* CONFIG_MEMCG */
+#endif /* _MM_MEMCOMP_TESTS_CORE_TEST_H */
diff --git a/mm/memcomp/tests/defrag_test.h b/mm/memcomp/tests/defrag_test.h
new file mode 100644
index 0000000..4d69394
--- /dev/null
+++ b/mm/memcomp/tests/defrag_test.h
@@ -0,0 +1,601 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_DEFRAG_TEST_H
+#define _MM_MEMCOMP_TESTS_DEFRAG_TEST_H
+
+#include <kunit/static_stub.h>
+#include "../defrag.h"
+
+/*
+ * Include after consumers_test.h for its unlocked accounting/probe fixture.
+ * Backing IO and slot counts are modeled. Encodings, zs objects, byte copies,
+ * decompression, guards, charging and the scanner are real. No device is used.
+ */
+#if defined(CONFIG_MEMCG) && defined(CONFIG_SWAP)
+#define MC16_DEFRAG_TEST_SLOTS (MEMCOMP_WRITEBACK_DEFRAG_SCAN + 4)
+
+struct mc16_defrag_test {
+	struct mc16_consumer_test *base;
+	struct memcomp_ref refs[MC16_DEFRAG_TEST_SLOTS];
+	struct memcomp_ref guard;
+	struct memcomp_kunit_async_probe payload;
+	unsigned int nr;
+	u32 markers[2];
+	u8 *image;
+	u8 *original;
+	u32 bytes;
+	int count;
+	int read_error;
+	bool fail_buffer;
+	bool fail_alloc;
+	bool fail_charge;
+	bool drop_owner;
+	unsigned int race;
+	unsigned int reads;
+	unsigned int copies;
+	bool callback_under_t;
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	long swapped_before;
+#endif
+};
+
+static struct mc16_defrag_test *mc16_defrag_test_current;
+
+static void mc16_defrag_test_cleanup(void *data)
+{
+	struct mc16_defrag_test *f = data;
+	unsigned int i;
+
+	f->base->model.fail_at = 0;
+	if (mc16_defrag_test_current == f)
+		mc16_defrag_test_current = NULL;
+	if (f->guard.slot)
+		mc16_ref_put(&f->guard);
+	for (i = 0; i < f->nr; i++)
+		if (f->refs[i].slot)
+			mc16_ref_put(&f->refs[i]);
+	for (i = 0; i < ARRAY_SIZE(f->markers); i++)
+		if (f->markers[i])
+			xa_erase_irq(&mc16_clusters, f->markers[i]);
+	rcu_barrier();
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	KUNIT_EXPECT_EQ(f->base->test, atomic_long_read(&memcomp_swapped_entries),
+			f->swapped_before);
+#endif
+	if (rcu_access_pointer(memcomp_kunit_async_probe) == &f->payload) {
+		rcu_assign_pointer(memcomp_kunit_async_probe, NULL);
+		synchronize_rcu();
+	}
+}
+
+static struct mc16_defrag_test *mc16_defrag_test_begin(struct kunit *test)
+{
+	struct mc16_consumer_test *base = mc16_consumer_test_begin(test);
+	struct mc16_defrag_test *f;
+	unsigned long handle = 0;
+	unsigned int i;
+	void *mapped;
+	u8 pool = 0;
+	int ret;
+
+	if (!base)
+		return NULL;
+	if (rcu_access_pointer(memcomp_kunit_async_probe)) {
+		KUNIT_FAIL(test, "defrag fixture requires an idle payload probe");
+		return NULL;
+	}
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->base = base;
+	f->count = 1;
+	f->payload.task = current;
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	f->swapped_before = atomic_long_read(&memcomp_swapped_entries);
+#endif
+	if (kunit_add_action_or_reset(test, mc16_defrag_test_cleanup, f))
+		return NULL;
+	f->image = kunit_kzalloc(test, PAGE_SIZE, GFP_KERNEL);
+	f->original = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	if (!f->image || !f->original)
+		return NULL;
+	for (i = 0; i < PAGE_SIZE; i++)
+		f->original[i] = i % 53;
+	ret = memcomp_prepare_payload(f->original, PAGE_SIZE, &f->bytes, &handle,
+				      &pool, MEMCOMP_PAYLOAD_MUST_SUCCEED, false);
+	if (ret)
+		return NULL;
+	if (!f->bytes || f->bytes >= PAGE_SIZE - 38 || pool) {
+		if (f->bytes)
+			memcomp_zs_free(pool, handle);
+		return NULL;
+	}
+	mapped = zs_map_object(memcomp_pools[0], handle, ZS_MM_RO);
+	if (mapped) {
+		memcpy(f->image + 37, mapped, f->bytes);
+		zs_unmap_object(memcomp_pools[0], handle);
+	}
+	memcomp_zs_free(0, handle);
+	return mapped ? f : NULL;
+}
+
+/* 0 samefill/noncandidate, 1 stable packed, 2 ordinary, 3 attached packed. */
+static int mc16_defrag_test_insert(struct mc16_defrag_test *f, unsigned int mode)
+{
+	struct mc16_initial_payload initial = { .word = 0x12345678 };
+	struct mc16_consumer_test *b = f->base;
+	struct memcomp_ref *ref;
+	struct mc16_view view;
+	u64 word;
+	u16 length;
+	int ret;
+
+	if (f->nr == ARRAY_SIZE(f->refs))
+		return -ENOSPC;
+	ref = &f->refs[f->nr];
+	if (mode == 3) {
+		ret = mc16_consumer_test_reserve(b, 0);
+		if (ret)
+			return ret;
+		*ref = b->owners[0];
+		b->owners[0] = (struct memcomp_ref) { };
+	} else {
+		ret = mc16_reserve_cache(&b->model.objcg, folio_nid(b->account),
+					 &initial, 1, ref);
+		if (ret)
+			return ret;
+		mc16_cache_publish(ref, 0);
+	}
+	f->nr++;
+	if (!mode)
+		return 0;
+	if (!mc16_swap_encode(0, 0x567 + f->nr, mode == 2 ? 0 : 37,
+			      f->bytes, mode != 2, &word, &length))
+		return -EINVAL;
+	mutex_lock(memcomp_lock_of(ref->token));
+	if (!mc16_view_locked(ref, &view)) {
+		ret = -EIO;
+		goto unlock;
+	}
+	mc16_account_state(ref, false);
+	if (*view.flags & MC16_F_RESIDENT) {
+		folio_put(view.member->owner_folio);
+		memcomp_debug_dec(&memcomp_pending_pages);
+	}
+	*view.word = word;
+	*view.length = length;
+	*view.flags = MC16_SWAPPED | (*view.flags & MC16_F_OWNER) |
+		      MC16_F_REFERENCED | MC16_F_INCOMPRESSIBLE;
+	memcomp_compressed_bytes_add(f->bytes);
+	memcomp_debug_long_inc(&memcomp_swapped_entries);
+	mc16_account_state(ref, true);
+	ret = 0;
+unlock:
+	mutex_unlock(memcomp_lock_of(ref->token));
+	return ret;
+}
+
+static int mc16_defrag_test_count(swp_entry_t swap)
+{
+	return swap.val ? mc16_defrag_test_current->count : 0;
+}
+
+static int mc16_defrag_test_read(swp_entry_t swap, void *dst)
+{
+	struct mc16_defrag_test *f = mc16_defrag_test_current;
+
+	f->reads++;
+	if (!swap.val)
+		return -EIO;
+	if (f->guard.slot && mutex_is_locked(memcomp_lock_of(f->guard.token)))
+		f->callback_under_t = true;
+	if (f->read_error)
+		return f->read_error;
+	memcpy(dst, f->image, PAGE_SIZE);
+	return 0;
+}
+
+static const struct memcomp_defrag_ops mc16_defrag_test_ops = {
+	.slot_count = mc16_defrag_test_count,
+	.read_page = mc16_defrag_test_read,
+};
+
+static void *mc16_defrag_test_buffer(void)
+{
+	if (mc16_defrag_test_current->fail_buffer)
+		return NULL;
+	return kmalloc(PAGE_SIZE, GFP_NOWAIT | __GFP_NOWARN);
+}
+
+static int mc16_defrag_test_copy(const void *src, unsigned int bytes,
+				 struct mc16_payload *payload)
+{
+	struct mc16_defrag_test *f = mc16_defrag_test_current;
+	struct memcomp_store_ctx store = { .kunit_async_probe = &f->payload };
+	unsigned int copied = 0;
+	unsigned long handle;
+	int ret;
+
+	f->copies++;
+	if (f->fail_alloc)
+		return -ENOMEM;
+	ret = memcomp_alloc_raw_payload(0, src, bytes, &copied, &handle, false,
+					f->guard.slot ? &store : NULL);
+	if (ret)
+		return ret;
+	*payload = (struct mc16_payload) { .word = handle, .bytes = copied };
+	if (f->fail_charge)
+		f->base->model.fail_at = atomic_read(&f->base->model.charge_calls) + 1;
+	if (f->race) {
+		struct mc16_swap_fields fields;
+		struct mc16_view view;
+		u64 word;
+		u16 length;
+
+		mutex_lock(memcomp_lock_of(f->guard.token));
+		ret = mc16_view_locked(&f->guard, &view) &&
+			mc16_swap_decode(*view.word, *view.length, &fields) ? 0 : -EIO;
+		if (!ret) {
+			if (f->race == 1)
+				fields.byte_offset++;
+			else
+				fields.length++;
+			if (!mc16_swap_encode(fields.type, fields.swap_offset,
+					      fields.byte_offset, fields.length,
+					      fields.packed, &word, &length)) {
+				ret = -EINVAL;
+			} else {
+				*view.word = word;
+				*view.length = length;
+				if (f->race == 2)
+					memcomp_compressed_bytes_add(1);
+			}
+		}
+		mutex_unlock(memcomp_lock_of(f->guard.token));
+		if (ret)
+			return ret;
+	}
+	if (f->drop_owner) {
+		struct memcomp_ref owner;
+		bool dropped = false;
+
+		folio_lock(f->base->account);
+		if (mc16_get(f->guard.token, &owner))
+			dropped = mc16_owner_drop_folio_held(&owner,
+							     f->base->account, 1, 0);
+		folio_unlock(f->base->account);
+		if (!dropped)
+			return -EIO;
+		f->refs[0] = (struct memcomp_ref) { };
+	}
+	return 0;
+}
+
+/* Stubs are disabled, and every T/folio lock is gone, before any assertion. */
+static int mc16_defrag_test_run(struct mc16_defrag_test *f, u64 *cursor)
+{
+	struct kunit *test = f->base->test;
+	int ret;
+
+	mc16_defrag_test_current = f;
+	if (f->guard.slot)
+		rcu_assign_pointer(memcomp_kunit_async_probe, &f->payload);
+	kunit_activate_static_stub(test, mc16_defrag_buffer_alloc,
+				   mc16_defrag_test_buffer);
+	kunit_activate_static_stub(test, mc16_defrag_copy_payload,
+				   mc16_defrag_test_copy);
+	ret = cursor ? mc16_defrag_scan(cursor, &mc16_defrag_test_ops) :
+		mc16_defrag_entry(&f->guard, &mc16_defrag_test_ops);
+	kunit_deactivate_static_stub(test, mc16_defrag_copy_payload);
+	kunit_deactivate_static_stub(test, mc16_defrag_buffer_alloc);
+	mc16_defrag_test_current = NULL;
+	return ret;
+}
+
+static unsigned int mc16_defrag_test_state(struct memcomp_ref *ref,
+					   u64 *word, u16 *length, bool *attached)
+{
+	struct mc16_view view;
+	unsigned int state = MC16_EMPTY;
+
+	mutex_lock(memcomp_lock_of(ref->token));
+	if (mc16_view_locked(ref, &view)) {
+		state = mc16_flags_state(*view.flags);
+		if (word)
+			*word = *view.word;
+		if (length)
+			*length = *view.length;
+		if (attached)
+			*attached = !!view.record;
+	}
+	mutex_unlock(memcomp_lock_of(ref->token));
+	return state;
+}
+
+static void memcomp_test_defrag_roundtrip(struct kunit *test)
+{
+	struct mc16_defrag_test *f = mc16_defrag_test_begin(test);
+	u64 word;
+	u16 length;
+	void *mapped;
+	bool same;
+	s64 compressed;
+	int puts, packed, dups, ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_EQ(test, mc16_defrag_test_insert(f, 1), 0);
+	KUNIT_ASSERT_TRUE(test, mc16_get(f->refs[0].token, &f->guard));
+	puts = atomic_read(&memcomp_kunit_slot_puts);
+	packed = atomic_read(&memcomp_kunit_slot_reclaims);
+	dups = atomic_read(&memcomp_kunit_slot_dups);
+	compressed = atomic64_read(&memcomp_compressed_bytes);
+	KUNIT_ASSERT_EQ(test, mc16_defrag_test_run(f, NULL), 1);
+	KUNIT_EXPECT_FALSE(test, f->callback_under_t);
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_kunit_slot_dups) - dups, 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_kunit_slot_puts) - puts, 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_kunit_slot_reclaims) - packed, 1);
+	KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_compressed_bytes), compressed);
+	KUNIT_EXPECT_EQ(test, f->guard.cluster->eligible_slots, (u16)1);
+	KUNIT_ASSERT_EQ(test, mc16_defrag_test_state(&f->guard, &word, &length, NULL),
+			(unsigned int)MC16_STORED);
+	KUNIT_EXPECT_EQ(test, (u32)length + 1, f->bytes);
+	mapped = zs_map_object(memcomp_pools[0], word, ZS_MM_RO);
+	if (!mapped) {
+		KUNIT_FAIL(test, "copied payload did not map");
+		return;
+	}
+	same = !memcmp(mapped, f->image + 37, f->bytes);
+	zs_unmap_object(memcomp_pools[0], word);
+	KUNIT_EXPECT_TRUE(test, same);
+	ret = mc16_load_page(&f->guard, f->image);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, memcmp(f->image, f->original, PAGE_SIZE), 0);
+	mc16_ref_put(&f->guard);
+	mc16_ref_put(&f->refs[0]);
+	KUNIT_EXPECT_EQ(test, f->payload.allocs, 1U);
+	KUNIT_EXPECT_EQ(test, f->payload.frees, 1U);
+	KUNIT_EXPECT_FALSE(test, f->payload.live);
+	KUNIT_EXPECT_FALSE(test, f->payload.bad_lifetime);
+}
