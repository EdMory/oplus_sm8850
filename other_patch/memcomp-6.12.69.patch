+/* Leave the atomic zsmalloc mapping before KUnit can report a failure. */
+static bool memcomp_test_enospc_raw_matches(u8 pool_idx,
+					    unsigned long handle,
+					    const void *src)
+{
+	struct zs_pool *pool = memcomp_pools[pool_idx];
+	const void *payload;
+	bool matches;
+
+	payload = zs_map_object(pool, handle, ZS_MM_RO);
+	matches = payload && !memcmp(payload, src, PAGE_SIZE);
+	if (payload)
+		zs_unmap_object(pool, handle);
+	return matches;
+}
+
+/* Exercise raw policy through the real synchronous and precomputed paths. */
+static void memcomp_test_enospc_payload(struct kunit *test,
+					bool precomputed)
+{
+	static const int statuses[] = { -ENOSPC, -E2BIG, -EIO };
+	struct memcomp_async_req request = { .len = 17 };
+	struct memcomp_reclaim_ctx *ctx;
+	struct memcomp_store_ctx store = {};
+	const struct memcomp_async_req *selected;
+	unsigned int reclaim_flags, length, i, raw;
+	unsigned long handle;
+	s64 candidate, reject, fail;
+	u8 pool_idx;
+	u8 *src;
+	bool matches;
+	int ret;
+
+	if (!memcomp_is_enabled()) {
+		kunit_skip(test, "memcomp initialization failed");
+		return;
+	}
+	src = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	memcomp_test_fill_zstd_ratio_page(src);
+	reclaim_flags = memcomp_test_reclaimer_enter();
+	ctx = memcomp_reclaim_ctx_get(1, MEMCOMP_RECLAIM_KSWAPD);
+	if (!ctx) {
+		memcomp_test_reclaimer_exit(reclaim_flags);
+		KUNIT_FAIL(test, "failed to acquire a compressor context");
+		return;
+	}
+	for (i = 0; i < ARRAY_SIZE(statuses); i++) {
+		request.ret = statuses[i];
+		store.precomp = precomputed ? &request : NULL;
+		selected = memcomp_store_precomp(&store, 0);
+		for (raw = 0; raw <= 1; raw++) {
+			candidate =
+				atomic64_read(&memcomp_raw_candidate_ge_page);
+			reject = atomic64_read(&memcomp_raw_reject_ge_page);
+			fail = atomic64_read(&memcomp_compress_fail);
+			length = 0;
+			handle = 0;
+			pool_idx = 0;
+			/* Reused output must leave the sync sentinel intact. */
+			ctx->kunit_compress_error =
+				precomputed ? -EIO : statuses[i];
+			ret = memcomp_prepare_payload_locked(&ctx, src,
+							     PAGE_SIZE, &length,
+							     &handle, &pool_idx,
+							     raw, NULL, selected);
+			if (statuses[i] == -EIO) {
+				KUNIT_EXPECT_EQ(test, ret, -EIO);
+				KUNIT_EXPECT_EQ(test, length, 0U);
+				KUNIT_EXPECT_EQ(test,
+						atomic64_read(&memcomp_compress_fail),
+					fail + 1);
+				KUNIT_EXPECT_EQ(test,
+						ctx->kunit_compress_error, 0);
+			} else {
+				KUNIT_EXPECT_EQ(test, ret, raw ? 0 : -E2BIG);
+				KUNIT_EXPECT_EQ(test, length,
+						raw ? (unsigned int)PAGE_SIZE : 0U);
+				KUNIT_EXPECT_EQ(test,
+						atomic64_read(&memcomp_compress_fail),
+					fail);
+				KUNIT_EXPECT_EQ(test, ctx->kunit_compress_error,
+						precomputed ? -EIO : 0);
+				candidate++;
+				reject += !raw;
+			}
+			KUNIT_EXPECT_EQ(test,
+					atomic64_read(&memcomp_raw_candidate_ge_page),
+				candidate);
+			KUNIT_EXPECT_EQ(test,
+					atomic64_read(&memcomp_raw_reject_ge_page),
+				reject);
+			if (!ret && length) {
+				if (length == PAGE_SIZE) {
+					matches = memcomp_test_enospc_raw_matches(pool_idx,
+										  handle, src);
+					KUNIT_EXPECT_TRUE(test, matches);
+				}
+				memcomp_zs_free(pool_idx, handle);
+			}
+		}
+	}
+	ctx->kunit_compress_error = 0;
+	memcomp_reclaim_ctx_put(ctx);
+	memcomp_test_reclaimer_exit(reclaim_flags);
+}
+
+static void memcomp_test_enospc_sync(struct kunit *test)
+{
+	memcomp_test_enospc_payload(test, false);
+}
+
+static void memcomp_test_enospc_precomp(struct kunit *test)
+{
+	memcomp_test_enospc_payload(test, true);
+}
+
+/* Result events precede admission: a later store refusal still counts. */
+static void memcomp_test_enospc_async_events(struct kunit *test)
+{
+	static const struct {
+		int status;
+		bool same_filled;
+		unsigned int payloads;
+		unsigned int failures;
+	} cases[] = {
+		{ 0, false, 2, 0 },
+		{ -ENOSPC, false, 2, 0 },
+		{ -E2BIG, false, 2, 0 },
+		{ -EIO, false, 0, 2 },
+		{ -ENODATA, false, 0, 2 },
+		{ -EHWPOISON, false, 0, 2 },
+		{ 0, true, 0, 0 },
+		{ -ENOSPC, true, 0, 0 },
+	};
+	struct memcomp_reclaim_ctx *ctx;
+	struct memcomp_async *async;
+	struct folio *folio;
+	unsigned int reclaim_flags, i, j;
+	s64 payloads, failures;
+	bool stored;
+
+	if (!memcomp_is_enabled()) {
+		kunit_skip(test, "memcomp initialization failed");
+		return;
+	}
+	async = kunit_kzalloc(test, sizeof(*async), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, async);
+	folio = folio_alloc(GFP_KERNEL | __GFP_ZERO, 1);
+	KUNIT_ASSERT_NOT_NULL(test, folio);
+	folio_lock(folio);
+	/* A non-anon folio refuses preflight before reading payload buffers. */
+	async->nr = 3;
+	async->reqs[0].ret = -EIO;
+	for (j = 1; j < async->nr; j++)
+		async->reqs[j].folio = folio;
+	reclaim_flags = memcomp_test_reclaimer_enter();
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		for (j = 1; j < async->nr; j++) {
+			async->reqs[j].ret = cases[i].status;
+			async->reqs[j].same_filled = cases[i].same_filled;
+		}
+		ctx = memcomp_reclaim_ctx_get(2, MEMCOMP_RECLAIM_KSWAPD);
+		if (!ctx) {
+			KUNIT_FAIL(test, "no compressor context");
+			break;
+		}
+		payloads = atomic64_read(&memcomp_async_payloads);
+		failures = atomic64_read(&memcomp_async_fail);
+		stored = memcomp_store_after_unmap_async(folio, &ctx, async);
+		KUNIT_EXPECT_FALSE(test, stored);
+		KUNIT_EXPECT_PTR_EQ(test, ctx, NULL);
+		if (ctx)
+			memcomp_reclaim_ctx_put(ctx);
+		KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_async_payloads),
+				payloads + cases[i].payloads);
+		KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_async_fail),
+				failures + cases[i].failures);
+	}
+	memcomp_test_reclaimer_exit(reclaim_flags);
+	folio_unlock(folio);
+	folio_put(folio);
+}
+
+#endif /* CONFIG_MEMCG */
+
+#endif /* _MM_MEMCOMP_TESTS_ENOSPC_TEST_H */
diff --git a/mm/memcomp/tests/fault_alloc_test.h b/mm/memcomp/tests/fault_alloc_test.h
new file mode 100644
index 0000000..a8b9193
--- /dev/null
+++ b/mm/memcomp/tests/fault_alloc_test.h
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_FAULT_ALLOC_TEST_H
+#define _MM_MEMCOMP_TESTS_FAULT_ALLOC_TEST_H
+
+#include <kunit/test.h>
+#include <linux/mm.h>
+#include <linux/huge_mm.h>
+
+#include "../fault_alloc.h"
+
+static void memcomp_test_fault_alloc_single_page(struct kunit *test)
+{
+	struct vm_area_struct vma = { };
+
+	KUNIT_EXPECT_EQ(test, memcomp_fault_alloc_gfp(&vma, 1),
+			GFP_HIGHUSER_MOVABLE);
+	vm_flags_init(&vma, VM_HUGEPAGE);
+	KUNIT_EXPECT_EQ(test, memcomp_fault_alloc_gfp(&vma, 1),
+			GFP_HIGHUSER_MOVABLE);
+}
+
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+/* No assertions or allocations may interrupt the save/restore interval. */
+static gfp_t
+memcomp_test_fault_alloc_with_policy(struct vm_area_struct *vma,
+				     unsigned int nr_pages, unsigned long policy)
+{
+	const unsigned long defrag_mask =
+		BIT(TRANSPARENT_HUGEPAGE_DEFRAG_DIRECT_FLAG) |
+		BIT(TRANSPARENT_HUGEPAGE_DEFRAG_KSWAPD_FLAG) |
+		BIT(TRANSPARENT_HUGEPAGE_DEFRAG_KSWAPD_OR_MADV_FLAG) |
+		BIT(TRANSPARENT_HUGEPAGE_DEFRAG_REQ_MADV_FLAG);
+	unsigned long saved = READ_ONCE(transparent_hugepage_flags);
+	gfp_t gfp;
+
+	WRITE_ONCE(transparent_hugepage_flags, (saved & ~defrag_mask) | policy);
+	gfp = memcomp_fault_alloc_gfp(vma, nr_pages);
+	WRITE_ONCE(transparent_hugepage_flags, saved);
+
+	return gfp;
+}
+#endif
+
+static void memcomp_test_fault_alloc_defrag_policy(struct kunit *test)
+{
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+	/* Expected reclaim/retry behavior, for ordinary and madvised VMAs. */
+	static const struct {
+		unsigned long policy;
+		gfp_t behavior[2];
+	} cases[] = {
+		{ 0, { 0, 0 } }, /* never */
+		{ BIT(TRANSPARENT_HUGEPAGE_DEFRAG_DIRECT_FLAG),
+		  { __GFP_DIRECT_RECLAIM | __GFP_NORETRY,
+		    __GFP_DIRECT_RECLAIM } }, /* always */
+		{ BIT(TRANSPARENT_HUGEPAGE_DEFRAG_KSWAPD_FLAG),
+		  { __GFP_KSWAPD_RECLAIM, __GFP_KSWAPD_RECLAIM } }, /* defer */
+		/* defer+madvise */
+		{ BIT(TRANSPARENT_HUGEPAGE_DEFRAG_KSWAPD_OR_MADV_FLAG),
+		  { __GFP_KSWAPD_RECLAIM, __GFP_DIRECT_RECLAIM } },
+		/* madvise */
+		{ BIT(TRANSPARENT_HUGEPAGE_DEFRAG_REQ_MADV_FLAG),
+		  { 0, __GFP_DIRECT_RECLAIM } },
+	};
+	const gfp_t behavior_mask = __GFP_RECLAIM | __GFP_NORETRY |
+				    __GFP_RETRY_MAYFAIL | __GFP_NOFAIL;
+	const gfp_t required = __GFP_COMP | __GFP_NOMEMALLOC | __GFP_NOWARN;
+	struct vm_area_struct vma = { };
+	unsigned int i, advised;
+	gfp_t gfp;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		for (advised = 0; advised < 2; advised++) {
+			vm_flags_init(&vma, advised ? VM_HUGEPAGE : 0);
+			/* The historical regression used an order-four span. */
+			gfp = memcomp_test_fault_alloc_with_policy(&vma, 16,
+								   cases[i].policy);
+			KUNIT_EXPECT_EQ_MSG(test, gfp & behavior_mask,
+					    cases[i].behavior[advised],
+					    "policy %u advised %u", i, advised);
+			KUNIT_EXPECT_EQ(test, gfp & required, required);
+			KUNIT_EXPECT_EQ(test, gfp & ~behavior_mask,
+					GFP_TRANSHUGE_LIGHT & ~behavior_mask);
+			gfp = memcomp_test_fault_alloc_with_policy(&vma, 1,
+								   cases[i].policy);
+			KUNIT_EXPECT_EQ(test, gfp, GFP_HIGHUSER_MOVABLE);
+		}
+	}
+#else
+	kunit_skip(test, "THP defrag requires CONFIG_TRANSPARENT_HUGEPAGE");
+#endif
+}
+
+static void memcomp_test_fault_alloc_single_fallback(struct kunit *test)
+{
+	struct vm_area_struct vma = { };
+	gfp_t large, single;
+
+	vm_flags_init(&vma, VM_HUGEPAGE);
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+	/* MADV_HUGEPAGE obeys never; order-0 fallback permits reclaim. */
+	large = memcomp_test_fault_alloc_with_policy(&vma, 16, 0);
+	single = memcomp_test_fault_alloc_with_policy(&vma, 1, 0);
+	KUNIT_EXPECT_EQ(test, large & __GFP_RECLAIM, (gfp_t)0);
+#else
+	large = memcomp_fault_alloc_gfp(&vma, 16);
+	single = memcomp_fault_alloc_gfp(&vma, 1);
+	KUNIT_EXPECT_EQ(test, large,
+			GFP_HIGHUSER_MOVABLE | __GFP_NORETRY | __GFP_NOWARN);
+#endif
+	KUNIT_EXPECT_EQ(test, single, GFP_HIGHUSER_MOVABLE);
+	KUNIT_EXPECT_NE(test, large, single);
+	KUNIT_EXPECT_EQ(test, single & __GFP_RECLAIM,
+			GFP_HIGHUSER_MOVABLE & __GFP_RECLAIM);
+	KUNIT_EXPECT_EQ(test, single & (__GFP_COMP | __GFP_NOMEMALLOC |
+		__GFP_NOWARN | __GFP_NORETRY), (gfp_t)0);
+}
+
+#endif /* _MM_MEMCOMP_TESTS_FAULT_ALLOC_TEST_H */
diff --git a/mm/memcomp/tests/fault_test.h b/mm/memcomp/tests/fault_test.h
new file mode 100644
index 0000000..789362b
--- /dev/null
+++ b/mm/memcomp/tests/fault_test.h
@@ -0,0 +1,851 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_FAULT_TEST_H
+#define _MM_MEMCOMP_TESTS_FAULT_TEST_H
+
+/*
+ * Include after zero_load_test.h and refs/payload/owner test fixtures.
+ * Real mmap, PTL, folio allocation/charge, codec/zs and anon rmap. Only the
+ * existing source objcg is modeled. No swap device or public dispatch is used.
+ */
+#if defined(MC16_ZERO_LOAD_MM_TEST_ENABLED) && defined(CONFIG_MEMCG)
+#define MC16_FAULT_MM_TEST_ENABLED
+#define MC16_FT_PAGES 4
+
+struct mc16_ft {
+	struct kunit *test;
+	struct mc16_test_refs *refs;
+	struct mm_struct *mm;
+	unsigned long mapping;
+	unsigned long addr;
+	vm_flags_t flags;
+	pgprot_t prot;
+	bool saved_vma;
+	struct mc16_zero_owners zero;
+	s64 swapents;
+	s64 anonpages;
+	u32 tokens[MC16_FT_PAGES];
+	unsigned int nr;
+	struct folio *pins[MC16_FT_PAGES];
+	unsigned int nr_pins;
+	struct mc16_payload prepared[MC16_FT_PAGES];
+	struct mc16_payload_tail tail[MC16_FT_PAGES];
+	u8 *src;
+	int actor_error;
+	bool actor_ran;
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+	bool saved_orders;
+	unsigned long orders;
+#endif
+};
+
+/* The inherited source cleanup expects a locked folio; lock in this task. */
+static void mc16_ft_objcg_cleanup(void *data)
+{
+	struct memcomp_test_objcg_fixture *owner = data;
+
+	if (owner->folio)
+		folio_lock(owner->folio);
+	memcomp_test_objcg_cleanup(owner);
+}
+
+static int mc16_ft_storage(struct mc16_ft *f)
+{
+	struct kunit *test = f->test;
+	struct mc16_test_storage *s;
+	struct memcomp_test_objcg_fixture *owner;
+	struct folio *source;
+	int ret;
+
+	f->refs = kunit_kzalloc(test, sizeof(*f->refs), GFP_KERNEL);
+	s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+	if (!f->refs || !s)
+		return -ENOMEM;
+	f->refs->storage = s;
+	owner = memcomp_test_objcg_begin(test, 1);
+	if (!owner)
+		return -ENOMEM;
+	folio_unlock(owner->folio);
+	kunit_remove_action(test, memcomp_test_objcg_cleanup, owner);
+	ret = kunit_add_action_or_reset(test, mc16_ft_objcg_cleanup, owner);
+	if (ret)
+		return ret;
+	/* A genuine four-page source for the immutable order-2 span fixture. */
+	source = folio_alloc(GFP_KERNEL, 2);
+	if (!source)
+		return -ENOMEM;
+	folio_put(owner->folio);
+	owner->folio = source;
+	owner->model.folio = source;
+	owner->nr_pages = MC16_FT_PAGES;
+	s->owner = owner;
+	s->test = test;
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	mc16_test_metadata_snapshot(&s->baseline);
+#endif
+	s->probe.task = current;
+	ret = kunit_add_action_or_reset(test, mc16_test_storage_cleanup, s);
+	if (ret)
+		return ret;
+	rcu_assign_pointer(mc16_storage_fixture, &s->probe);
+	f->refs->stored_before = atomic64_read(&memcomp_stored_bytes);
+	f->refs->compressed_before = atomic64_read(&memcomp_compressed_bytes);
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	f->refs->pending_before = atomic64_read(&memcomp_pending_pages);
+#endif
+	return kunit_add_action_or_reset(test, mc16_test_refs_cleanup, f->refs);
+}
+
+static void mc16_ft_zero_unchanged(struct mc16_ft *f)
+{
+	struct mc16_zero_owners after;
+
+	mc16_zero_owners_read(&after);
+	KUNIT_EXPECT_EQ(f->test, after.pte_pages, f->zero.pte_pages);
+	KUNIT_EXPECT_EQ(f->test, after.cache_pages, f->zero.cache_pages);
+}
+
+/* Caller holds mmap_read_lock; a removed positive PTE owns exactly one ref. */
+static int mc16_ft_zap(struct mc16_ft *f, unsigned int index)
+{
+	unsigned long addr = f->addr + index * PAGE_SIZE;
+	spinlock_t *ptl; /* Actual PTE removal and token ownership transaction. */
+	struct memcomp_ref ref;
+	pte_t *ptep, pte;
+	pmd_t *pmd;
+
+	pmd = mm_find_pmd(f->mm, addr);
+	if (!pmd)
+		return -ENOENT;
+	ptep = pte_offset_map_lock(f->mm, pmd, addr, &ptl);
+	if (!ptep)
+		return -ENOENT;
+	pte = ptep_get(ptep);
+	if (is_swap_pte(pte) && is_memcomp_entry(pte_to_swp_entry(pte))) {
+		unsigned long token = swp_offset(pte_to_swp_entry(pte));
+
+		ptep_get_and_clear(f->mm, addr, ptep);
+		add_mm_counter(f->mm, MM_SWAPENTS, -1);
+		if (!token)
+			mc16_zero_pte_put(1);
+		else if (mc16_get(token, &ref))
+			mc16_ref_put_count(&ref, 2);
+	}
+	pte_unmap_unlock(ptep, ptl);
+	return 0;
+}
+
+static void mc16_ft_cleanup(void *data)
+{
+	struct mc16_ft *f = data;
+	struct mc16_test_storage *s = f->refs->storage;
+	struct vm_area_struct *vma;
+	unsigned int i;
+	int ret;
+
+	mc16_fault_probe = (typeof(mc16_fault_probe)) { };
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+	if (f->saved_orders)
+		WRITE_ONCE(huge_anon_orders_always, f->orders);
+#endif
+	mmap_read_lock(f->mm);
+	for (i = 0; i < MC16_FT_PAGES; i++)
+		mc16_ft_zap(f, i);
+	mmap_read_unlock(f->mm);
+	for (i = 0; i < s->nr; i++) {
+		if (!s->refs[i].slot)
+			continue;
+		mc16_payload_finish(&s->refs[i], &f->tail[i]);
+		mc16_payload_abort(&s->refs[i], &f->prepared[i]);
+	}
+	mmap_write_lock(f->mm);
+	vma = vma_lookup(f->mm, f->addr);
+	if (vma && f->saved_vma) {
+		vma_start_write(vma);
+		vm_flags_reset(vma, f->flags);
+		vma->vm_page_prot = f->prot;
+	}
+	mmap_write_unlock(f->mm);
+	/* Present pages use normal MM rmap/LRU cleanup, after token PTE removal. */
+	ret = mc16_test_dontneed(f->mm, f->mapping, 2 * MC16_FT_PAGES * PAGE_SIZE);
+	KUNIT_EXPECT_EQ(f->test, ret, 0);
+	for (i = 0; i < f->nr_pins; i++)
+		folio_put(f->pins[i]);
+	KUNIT_EXPECT_EQ(f->test, mc16_zl_rss(f->mm, MM_SWAPENTS), f->swapents);
+	KUNIT_EXPECT_EQ(f->test, mc16_zl_rss(f->mm, MM_ANONPAGES), f->anonpages);
+	mc16_ft_zero_unchanged(f);
+	mmput(f->mm);
+}
+
+static int mc16_ft_prepare(struct mc16_ft *f, unsigned int index, bool raw)
+{
+	struct mc16_test_storage *s = f->refs->storage;
+	struct memcomp_ref *ref = &s->refs[index];
+	struct mc16_payload *p = &f->prepared[index];
+	unsigned long handle;
+	unsigned int bytes;
+	u8 pool = 0;
+	int ret;
+
+	if (raw)
+		ret = memcomp_alloc_raw_payload(0, f->src + index * PAGE_SIZE,
+						PAGE_SIZE, &bytes, &handle, false, NULL);
+	else
+		ret = memcomp_prepare_payload(f->src + index * PAGE_SIZE, PAGE_SIZE,
+					      &bytes, &handle, &pool,
+					      MEMCOMP_PAYLOAD_MUST_SUCCEED, false);
+	if (ret)
+		return ret;
+	if (pool) {
+		memcomp_zs_free(pool, handle);
+		return -EINVAL;
+	}
+	*p = (struct mc16_payload) { .word = handle, .bytes = bytes };
+	if (!bytes || (!raw && bytes >= PAGE_SIZE))
+		return -E2BIG;
+	ret = mc16_payload_charge(ref, p);
+	if (ret)
+		return ret;
+	folio_lock(s->owner->folio);
+	mutex_lock(memcomp_lock_of(ref->token));
+	ret = mc16_payload_commit_locked(ref, s->owner->folio, f->nr, index,
+					 p, &f->tail[index]);
+	mutex_unlock(memcomp_lock_of(ref->token));
+	mc16_payload_finish(ref, &f->tail[index]);
+	folio_unlock(s->owner->folio);
+	return ret;
+}
+
+static pte_t mc16_ft_orig(struct mc16_ft *f, unsigned int index)
+{
+	return pte_swp_mksoft_dirty(swp_entry_to_pte(make_memcomp_entry(f->tokens[index])));
+}
+
+static int mc16_ft_install(struct mc16_ft *f, unsigned int index, pte_t pte)
+{
+	unsigned long addr = f->addr + index * PAGE_SIZE;
+	spinlock_t *ptl; /* Actual PTE owns a transferred mc16_get reference. */
+	struct memcomp_ref ref;
+	pte_t *ptep;
+	int ret = 0;
+
+	mmap_read_lock(f->mm);
+	ptep = get_locked_pte(f->mm, addr, &ptl);
+	if (!ptep) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	__acquire(RCU);
+	if (!pte_none(ptep_get(ptep))) {
+		ret = -EEXIST;
+	} else if (!mc16_get(swp_offset(pte_to_swp_entry(pte)), &ref)) {
+		ret = -ENOENT;
+	} else {
+		set_pte_at(f->mm, addr, ptep, pte);
+		add_mm_counter(f->mm, MM_SWAPENTS, 1);
+		/* ref ownership is now the installed PTE's. */
+	}
+	pte_unmap_unlock(ptep, ptl);
+out:
+	mmap_read_unlock(f->mm);
+	return ret;
+}
+
+static struct mc16_ft *mc16_ft_begin(struct kunit *test, unsigned int nr,
+				     bool raw, bool normalize)
+{
+	struct mc16_ft *f;
+	struct mc16_test_storage *s;
+	struct vm_area_struct *vma;
+	unsigned int i;
+	int ret;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->test = test;
+	f->nr = nr;
+	if (mc16_ft_storage(f))
+		return NULL;
+	s = f->refs->storage;
+	f->mapping = kunit_vm_mmap(test, NULL, 0, 2 * MC16_FT_PAGES * PAGE_SIZE,
+				   PROT_READ | PROT_WRITE,
+				   MAP_PRIVATE | MAP_ANONYMOUS, 0);
+	if (!f->mapping || IS_ERR_VALUE(f->mapping))
+		return NULL;
+	f->addr = ALIGN(f->mapping, MC16_FT_PAGES * PAGE_SIZE);
+	f->mm = current->mm;
+	mmget(f->mm);
+	f->swapents = mc16_zl_rss(f->mm, MM_SWAPENTS);
+	f->anonpages = mc16_zl_rss(f->mm, MM_ANONPAGES);
+	mc16_zero_owners_read(&f->zero);
+	if (kunit_add_action_or_reset(test, mc16_ft_cleanup, f))
+		return NULL;
+	mmap_read_lock(f->mm);
+	vma = vma_lookup(f->mm, f->addr);
+	if (vma) {
+		f->flags = vma->vm_flags;
+		f->prot = vma->vm_page_prot;
+		f->saved_vma = true;
+	}
+	ret = vma ? anon_vma_prepare(vma) : -ENOENT;
+	mmap_read_unlock(f->mm);
+	if (ret)
+		return NULL;
+	f->src = kunit_kmalloc(test, nr * PAGE_SIZE, GFP_KERNEL);
+	if (!f->src)
+		return NULL;
+	for (i = 0; i < nr * PAGE_SIZE; i++)
+		f->src[i] = raw ? i * 37 + (i >> 5) : (i + i / PAGE_SIZE) % 53;
+	folio_lock(s->owner->folio);
+	ret = mc16_test_refs_reserve(f->refs, nr);
+	folio_unlock(s->owner->folio);
+	if (ret)
+		return NULL;
+	for (i = 0; i < nr; i++) {
+		f->tokens[i] = s->refs[i].token;
+		if (mc16_ft_prepare(f, i, raw) || mc16_ft_install(f, i, mc16_ft_orig(f, i)))
+			return NULL;
+	}
+	if (normalize) {
+		folio_lock(s->owner->folio);
+		for (i = nr; i; ) {
+			struct memcomp_ref ref;
+
+			i--;
+			if (!mc16_get(f->tokens[i], &ref)) {
+				ret = -ENOENT;
+				break;
+			}
+			if (!mc16_owner_drop_folio_held(&ref, s->owner->folio, nr, i)) {
+				ret = -ESTALE;
+				break;
+			}
+			s->refs[i] = (struct memcomp_ref) { };
+		}
+		folio_unlock(s->owner->folio);
+		if (ret)
+			return NULL;
+	}
+	return f;
+}
