+	MEMCOMP_ANON_UNMAP_FAIL,
+	MEMCOMP_ANON_FINISH_FAIL,
+	/* Not tried, for having not compressed before. */
+	MEMCOMP_ANON_INCOMPRESSIBLE_SKIP,
+};
+
+#ifdef CONFIG_MEMCOMP
+
