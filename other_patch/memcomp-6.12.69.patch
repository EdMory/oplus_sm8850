+	/* Keep malformed/incomplete setup from reaching the pagemap offset math. */
+	if (!map->page_size) {
+		errno = EINVAL;
+		return -1;
+	}
+	index = (uintptr_t)map->addr / map->page_size + page;
+
+	do {
+		ret = pread(map->pagemap_fd, entry, sizeof(*entry),
+			    index * sizeof(*entry));
+	} while (ret < 0 && errno == EINTR);
+	if (ret == sizeof(*entry))
+		return 0;
+	if (ret >= 0)
