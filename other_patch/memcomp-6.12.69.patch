+static void memcomp_test_public_madv_free_partial(struct kunit *test)
+{
+	mc16_ct_madv_free(test, true, false);
+}
+
+static void memcomp_test_public_madv_free_shared(struct kunit *test)
+{
+	mc16_ct_madv_free(test, false, true);
+}
