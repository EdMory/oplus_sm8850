+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _MM_MEMCOMP_TESTS_LATE_ASYNC_TEST_H
+#define _MM_MEMCOMP_TESTS_LATE_ASYNC_TEST_H
+
+/* Included after the shared KUnit async codec definitions. */
+/* A second real LOADED event must not replace an initialized pool. */
+static struct acomp_alg memcomp_test_acomp_again_alg = {
+	.compress = memcomp_test_acomp_compress,
+	.decompress = memcomp_test_acomp_decompress,
+	.init = memcomp_test_acomp_init,
+	.exit = memcomp_test_acomp_exit,
+	.reqsize = sizeof(struct memcomp_test_acomp_req),
+	.base = {
+		.cra_name = "memcomp-kunit-acomp",
+		.cra_driver_name = "memcomp-kunit-acomp-again",
+		.cra_flags = CRYPTO_ALG_ASYNC,
+		.cra_blocksize = 1,
+		.cra_ctxsize = sizeof(struct memcomp_test_acomp_tfm),
+		.cra_module = THIS_MODULE,
+	},
+};
+
+/* An unrelated algorithm must never become this selector's transform. */
+static struct acomp_alg memcomp_test_acomp_other_alg = {
+	.compress = memcomp_test_acomp_compress,
+	.decompress = memcomp_test_acomp_decompress,
+	.init = memcomp_test_acomp_init,
+	.exit = memcomp_test_acomp_exit,
+	.reqsize = sizeof(struct memcomp_test_acomp_req),
+	.base = {
+		.cra_name = "memcomp-kunit-other",
+		.cra_driver_name = "memcomp-kunit-other-async",
+		.cra_flags = CRYPTO_ALG_ASYNC,
+		.cra_blocksize = 1,
+		.cra_ctxsize = sizeof(struct memcomp_test_acomp_tfm),
+		.cra_module = THIS_MODULE,
+	},
+};
+
+/* The synchronous form uses the boot-selected codec without replacing it. */
+struct memcomp_test_comp_tfm {
+	struct crypto_comp *sync;
+};
+
+static int memcomp_test_comp_init(struct crypto_tfm *tfm)
+{
+	struct memcomp_test_comp_tfm *ctx = crypto_tfm_ctx(tfm);
+
+	ctx->sync = crypto_alloc_comp(memcomp_compressor, 0, 0);
+	return PTR_ERR_OR_ZERO(ctx->sync);
+}
+
+static void memcomp_test_comp_exit(struct crypto_tfm *tfm)
+{
+	struct memcomp_test_comp_tfm *ctx = crypto_tfm_ctx(tfm);
+
+	crypto_free_comp(ctx->sync);
+}
+
+static int memcomp_test_comp_compress(struct crypto_tfm *tfm, const u8 *src,
+				      unsigned int slen, u8 *dst,
+				      unsigned int *dlen)
+{
+	struct memcomp_test_comp_tfm *ctx = crypto_tfm_ctx(tfm);
+
+	return crypto_comp_compress(ctx->sync, src, slen, dst, dlen);
+}
+
+static int memcomp_test_comp_decompress(struct crypto_tfm *tfm, const u8 *src,
+					unsigned int slen, u8 *dst,
+					unsigned int *dlen)
+{
+	struct memcomp_test_comp_tfm *ctx = crypto_tfm_ctx(tfm);
+
+	return crypto_comp_decompress(ctx->sync, src, slen, dst, dlen);
+}
+
+static struct crypto_alg memcomp_test_comp_alg = {
+	.cra_name = "memcomp-kunit-acomp",
+	.cra_driver_name = "memcomp-kunit-acomp-sync",
+	.cra_flags = CRYPTO_ALG_TYPE_COMPRESS,
+	.cra_blocksize = 1,
+	.cra_ctxsize = sizeof(struct memcomp_test_comp_tfm),
+	.cra_init = memcomp_test_comp_init,
+	.cra_exit = memcomp_test_comp_exit,
+	.cra_module = THIS_MODULE,
+	.cra_u = {
+		.compress = {
+			.coa_compress = memcomp_test_comp_compress,
+			.coa_decompress = memcomp_test_comp_decompress,
+		},
+	},
+};
+
+struct memcomp_test_late_async_fixture {
+	struct memcomp_compressor_select select;
+	struct memcomp_async_pool pool;
+	struct notifier_block loaded_nb;
+	struct completion loaded;
+	struct crypto_comp *sync;
+	struct memcomp_async *taken;
+	struct crypto_acomp *initial_tfm;
+	struct memcomp_async *initial_batches[BITS_PER_LONG];
+	unsigned int initial_nr;
+	struct kunit *test;
+	char compressor[MEMCOMP_COMPRESSOR_NAME_LEN];
+	int inits_before;
+	int exits_before;
+	bool sync_registered;
+	bool async_registered;
+	bool again_registered;
+	bool other_registered;
+	bool select_registered;
+	bool observer_registered;
+};
+
+static int memcomp_test_late_loaded(struct notifier_block *nb,
+				    unsigned long msg, void *data)
+{
+	struct memcomp_test_late_async_fixture *f;
+	struct crypto_alg *alg = data;
+
+	if (msg != CRYPTO_MSG_ALG_LOADED ||
+	    (alg != &memcomp_test_acomp_alg.base &&
+	     alg != &memcomp_test_acomp_again_alg.base &&
+	     alg != &memcomp_test_acomp_other_alg.base))
+		return NOTIFY_DONE;
+	f = container_of(nb, struct memcomp_test_late_async_fixture, loaded_nb);
+	/* Lower priority than the production callback: its queueing is done. */
+	complete(&f->loaded);
+	return NOTIFY_OK;
+}
+
+static void memcomp_test_late_async_cleanup(void *data)
+{
+	struct memcomp_test_late_async_fixture *f = data;
+	unsigned int i, j;
+
+	/* Never hold select_lock while waiting for either callback or work. */
+	if (f->select_registered)
+		crypto_unregister_notifier(&f->select.nb);
+	if (f->observer_registered)
+		crypto_unregister_notifier(&f->loaded_nb);
+	cancel_delayed_work_sync(&f->select.work);
+	if (f->taken)
+		memcomp_async_give(&f->pool, f->taken);
+	for (i = 0; i < f->pool.nr; i++)
+		memcomp_async_free_batch(f->pool.batches[i]);
+	/* Preserve ownership even when a broken retry replaced the first pool. */
+	for (i = 0; i < f->initial_nr; i++) {
+		for (j = 0; j < f->pool.nr; j++) {
+			if (f->initial_batches[i] == f->pool.batches[j])
+				break;
+		}
+		if (j == f->pool.nr)
+			memcomp_async_free_batch(f->initial_batches[i]);
+	}
+	if (f->pool.tfm)
+		crypto_free_acomp(f->pool.tfm);
+	if (f->initial_tfm && f->initial_tfm != f->pool.tfm)
+		crypto_free_acomp(f->initial_tfm);
+	if (f->other_registered)
+		crypto_unregister_acomp(&memcomp_test_acomp_other_alg);
+	if (f->again_registered)
+		crypto_unregister_acomp(&memcomp_test_acomp_again_alg);
+	if (f->async_registered)
+		crypto_unregister_acomp(&memcomp_test_acomp_alg);
+	if (f->sync)
+		crypto_free_comp(f->sync);
+	if (f->sync_registered)
+		crypto_unregister_alg(&memcomp_test_comp_alg);
+	KUNIT_EXPECT_EQ(f->test,
+			atomic_read(&memcomp_test_acomp_inits) - f->inits_before,
+			atomic_read(&memcomp_test_acomp_exits) - f->exits_before);
+}
+
+static void memcomp_test_async_late_registration(struct kunit *test)
+{
+	struct memcomp_test_late_async_fixture *f;
+	struct crypto_acomp *tfm, *boot_tfm;
+	struct memcomp_async *first;
+	const char *driver;
+	unsigned long waited;
+	unsigned int nr, i, j;
+	int ret;
+
+	KUNIT_ASSERT_TRUE(test, memcomp_is_enabled());
+	KUNIT_ASSERT_NE(test, strcmp(memcomp_compressor,
+				     "memcomp-kunit-acomp"), 0);
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	f->test = test;
+	f->inits_before = atomic_read(&memcomp_test_acomp_inits);
+	f->exits_before = atomic_read(&memcomp_test_acomp_exits);
+	spin_lock_init(&f->pool.lock);
+	INIT_DELAYED_WORK(&f->select.work, memcomp_select_worker);
+	init_completion(&f->loaded);
+	strscpy(f->compressor, "memcomp-kunit-acomp", sizeof(f->compressor));
+	f->select.compressor = f->compressor;
+	f->select.pool = &f->pool;
+	f->select.nb.notifier_call = memcomp_crypto_notify;
+	f->loaded_nb.notifier_call = memcomp_test_late_loaded;
+	f->loaded_nb.priority = -1;
+	ret = kunit_add_action_or_reset(test, memcomp_test_late_async_cleanup, f);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	ret = crypto_register_alg(&memcomp_test_comp_alg);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	f->sync_registered = true;
+	f->sync = crypto_alloc_comp(f->compressor, 0, 0);
+	if (IS_ERR(f->sync)) {
+		ret = PTR_ERR(f->sync);
+		f->sync = NULL;
+		KUNIT_FAIL(test, "late async synchronous selection: %d", ret);
+		return;
+	}
+	KUNIT_EXPECT_STREQ(test, crypto_comp_name(f->sync), f->compressor);
+	ret = crypto_has_acomp(f->compressor, CRYPTO_ALG_ASYNC,
+			       CRYPTO_ALG_ASYNC | CRYPTO_NOLOAD);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	/* Only boot does global startup; this context owns a selected sync form. */
+	mutex_lock(&memcomp_select_lock);
+	f->select.decided = true;
+	f->select.started = true;
+	mutex_unlock(&memcomp_select_lock);
+	/* Before publication there must not be a visible async transform. */
+	KUNIT_ASSERT_PTR_EQ(test, smp_load_acquire(&f->pool.tfm), NULL);
+	KUNIT_ASSERT_EQ(test, f->pool.nr, 0U);
+	/* Observe the production pool without replacing its release-published tfm. */
+	boot_tfm = smp_load_acquire(&memcomp_async_pool.tfm);
+
+	ret = crypto_register_notifier(&f->loaded_nb);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	f->observer_registered = true;
+	ret = crypto_register_notifier(&f->select.nb);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	f->select_registered = true;
+	/* Run a real event while only the selected synchronous form exists. */
+	ret = crypto_register_acomp(&memcomp_test_acomp_other_alg);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	f->other_registered = true;
+	waited = wait_for_completion_timeout(&f->loaded, 10 * HZ);
+	KUNIT_ASSERT_NE(test, waited, 0UL);
+	flush_delayed_work(&f->select.work);
+	/* No release publication is allowed for the unrelated async name. */
+	KUNIT_EXPECT_PTR_EQ(test, smp_load_acquire(&f->pool.tfm), NULL);
+	KUNIT_EXPECT_EQ(test, f->pool.nr, 0U);
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_test_acomp_inits),
+			f->inits_before);
+	reinit_completion(&f->loaded);
+	/* No direct async_init/worker call, queueing or global pool replacement. */
+	ret = crypto_register_acomp(&memcomp_test_acomp_alg);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	f->async_registered = true;
+	waited = wait_for_completion_timeout(&f->loaded, 10 * HZ);
+	KUNIT_ASSERT_NE(test, waited, 0UL);
+	flush_delayed_work(&f->select.work);
+	/* Consume exactly the publication performed by the production worker. */
+	tfm = smp_load_acquire(&f->pool.tfm);
+	KUNIT_ASSERT_NOT_NULL(test, tfm);
+	driver = crypto_tfm_alg_driver_name(crypto_acomp_tfm(tfm));
+	KUNIT_EXPECT_STREQ(test, driver, "memcomp-kunit-acomp-async");
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_test_acomp_inits),
+			f->inits_before + 1);
+	nr = f->pool.nr;
+	KUNIT_ASSERT_GT(test, nr, 0U);
+	KUNIT_EXPECT_EQ(test, (unsigned int)hweight_long(f->pool.free), nr);
+	for (i = 0; i < nr; i++) {
+		struct memcomp_async *batch = f->pool.batches[i];
+
+		KUNIT_ASSERT_NOT_NULL(test, batch);
+		KUNIT_EXPECT_EQ(test, batch->id, i);
+		for (j = 0; j < MEMCOMP_ASYNC_PAGES; j++) {
+			KUNIT_EXPECT_NOT_NULL(test, batch->reqs[j].req);
+			KUNIT_EXPECT_NOT_NULL(test, batch->reqs[j].buf);
+			KUNIT_EXPECT_PTR_EQ(test, batch->reqs[j].async, batch);
+		}
+	}
+	f->initial_tfm = tfm;
+	f->initial_nr = nr;
+	memcpy(f->initial_batches, f->pool.batches,
+	       nr * sizeof(f->initial_batches[0]));
+	first = f->pool.batches[0];
+	KUNIT_ASSERT_NOT_NULL(test, first);
+	f->taken = memcomp_async_take(&f->pool, 0);
+	KUNIT_ASSERT_NOT_NULL(test, f->taken);
+	memcomp_async_give(&f->pool, f->taken);
+	f->taken = NULL;
+
+	/* A second real registration must not allocate or replace anything. */
+	reinit_completion(&f->loaded);
+	ret = crypto_register_acomp(&memcomp_test_acomp_again_alg);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	f->again_registered = true;
+	waited = wait_for_completion_timeout(&f->loaded, 10 * HZ);
+	KUNIT_ASSERT_NE(test, waited, 0UL);
+	flush_delayed_work(&f->select.work);
+	/* Repeated events must leave the release-published transform unchanged. */
+	KUNIT_ASSERT_PTR_EQ(test, smp_load_acquire(&f->pool.tfm), tfm);
+	KUNIT_EXPECT_PTR_EQ(test, f->pool.batches[0], first);
+	KUNIT_ASSERT_EQ(test, f->pool.nr, nr);
+	for (i = 0; i < nr; i++)
+		KUNIT_EXPECT_PTR_EQ(test, f->pool.batches[i], f->initial_batches[i]);
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_test_acomp_inits),
+			f->inits_before + 1);
+
+	/* Unregister first, drain second, then prove a new event cannot requeue. */
+	ret = crypto_unregister_notifier(&f->select.nb);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	f->select_registered = false;
+	cancel_delayed_work_sync(&f->select.work);
+	crypto_unregister_acomp(&memcomp_test_acomp_again_alg);
+	f->again_registered = false;
+	reinit_completion(&f->loaded);
+	ret = crypto_register_acomp(&memcomp_test_acomp_again_alg);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	f->again_registered = true;
+	waited = wait_for_completion_timeout(&f->loaded, 10 * HZ);
+	KUNIT_ASSERT_NE(test, waited, 0UL);
+	KUNIT_EXPECT_FALSE(test, flush_delayed_work(&f->select.work));
+	KUNIT_EXPECT_FALSE(test, delayed_work_pending(&f->select.work));
+	/* Repeated events must leave the release-published transform unchanged. */
+	KUNIT_EXPECT_PTR_EQ(test, smp_load_acquire(&f->pool.tfm), tfm);
+	KUNIT_EXPECT_EQ(test, atomic_read(&memcomp_test_acomp_inits),
+			f->inits_before + 1);
+	/* The boot pool's independently published transform was never replaced. */
+	KUNIT_EXPECT_PTR_EQ(test, smp_load_acquire(&memcomp_async_pool.tfm),
+			    boot_tfm);
+}
+
+#endif /* _MM_MEMCOMP_TESTS_LATE_ASYNC_TEST_H */
diff --git a/mm/memcomp/tests/load_test.h b/mm/memcomp/tests/load_test.h
new file mode 100644
index 0000000..2c7de62
--- /dev/null
+++ b/mm/memcomp/tests/load_test.h
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_LOAD_TEST_H
+#define _MM_MEMCOMP_TESTS_LOAD_TEST_H
+#ifdef CONFIG_MEMCG
+static void memcomp_test_load_pending(struct kunit *test)
+{
+	struct mc16_test_payload *f = mc16_test_payload_begin(test);
+	void *dst = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, dst);
+	memset(dst, 0x5a, PAGE_SIZE);
+	KUNIT_EXPECT_EQ(test, mc16_load_page(&f->refs->storage->refs[0], dst),
+			-EAGAIN);
+	KUNIT_EXPECT_PTR_EQ(test, memchr_inv(dst, 0x5a, PAGE_SIZE), NULL);
+}
+
+static void memcomp_test_load_samefill(struct kunit *test)
+{
+	const unsigned long pattern = 0xfedcba9876543210UL;
+	struct mc16_test_payload *f = mc16_test_payload_begin(test);
+	struct mc16_test_storage *storage;
+	struct memcomp_ref *ref;
+	struct mc16_record *detached;
+	struct mc16_view view;
+	unsigned long *dst;
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	storage = f->refs->storage;
+	ref = &storage->refs[0];
+	dst = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dst);
+	KUNIT_ASSERT_EQ(test, mc16_test_payload_prepare(f, 0, pattern), 0);
+	KUNIT_ASSERT_EQ(test, mc16_test_payload_commit(f, storage->owner->folio), 0);
+	mc16_payload_finish(ref, &f->tail);
+	KUNIT_ASSERT_EQ(test, mc16_load_page(ref, dst), 0);
+	for (i = 0; i < PAGE_SIZE / sizeof(*dst); i++)
+		KUNIT_EXPECT_EQ(test, dst[i], pattern);
+
+	/* Model the completed producer's detach while retaining slot ownership. */
+	mutex_lock(memcomp_lock_of(ref->token));
+	mc16_view_locked(ref, &view);
+	mc16_account_state(ref, false);
+	*view.flags &= ~MC16_F_OWNER;
+	mc16_account_state(ref, true);
+	detached = mc16_normalize_locked(ref);
+	mutex_unlock(memcomp_lock_of(ref->token));
+	KUNIT_ASSERT_NOT_NULL(test, detached);
+	mc16_record_member_put(detached);
+	memset(dst, 0, PAGE_SIZE);
+	KUNIT_ASSERT_EQ(test, mc16_load_page(ref, dst), 0);
+	for (i = 0; i < PAGE_SIZE / sizeof(*dst); i++)
+		KUNIT_EXPECT_EQ(test, dst[i], pattern);
+}
+
+static void mc16_test_load_payload(struct kunit *test, bool raw,
+				   bool writeback)
+{
+	struct mc16_test_payload *f = mc16_test_payload_begin(test);
+	struct mc16_test_storage *storage;
+	struct memcomp_ref *ref;
+	struct mc16_view view;
+	unsigned int bytes = 0, i;
+	unsigned long handle = 0;
+	u8 pool = 0;
+	u8 *src, *dst;
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	storage = f->refs->storage;
+	ref = &storage->refs[0];
+	src = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	dst = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	KUNIT_ASSERT_NOT_NULL(test, dst);
+	for (i = 0; i < PAGE_SIZE; i++)
+		src[i] = raw ? (i * 37 + (i >> 5)) : (i % 53);
+	if (raw)
+		ret = memcomp_alloc_raw_payload(0, src, PAGE_SIZE, &bytes,
+						&handle, false, NULL);
+	else
+		ret = memcomp_prepare_payload(src, PAGE_SIZE, &bytes, &handle,
+					      &pool, MEMCOMP_PAYLOAD_MUST_SUCCEED,
+					      false);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	f->prepared = (struct mc16_payload) { .word = handle, .bytes = bytes };
+	KUNIT_ASSERT_EQ(test, pool, (u8)0);
+	if (raw) {
+		KUNIT_EXPECT_EQ(test, bytes, (unsigned int)PAGE_SIZE);
+	} else {
+		KUNIT_EXPECT_GT(test, bytes, 0U);
+		KUNIT_EXPECT_LT(test, bytes, (unsigned int)PAGE_SIZE);
+	}
+	KUNIT_ASSERT_EQ(test, mc16_payload_charge(ref, &f->prepared), 0);
+	KUNIT_ASSERT_EQ(test, mc16_test_payload_commit(f, storage->owner->folio), 0);
+	mc16_payload_finish(ref, &f->tail);
+	if (writeback) {
+		mutex_lock(memcomp_lock_of(ref->token));
+		mc16_view_locked(ref, &view);
+		*view.flags = (*view.flags & ~MC16_STATE_MASK) | MC16_WRITEBACK;
+		mc16_fifo_transition(ref, MC16_STORED, MC16_WRITEBACK);
+		mutex_unlock(memcomp_lock_of(ref->token));
+	}
+	memset(dst, 0, PAGE_SIZE);
+	KUNIT_ASSERT_EQ(test, mc16_load_page(ref, dst), 0);
+	KUNIT_EXPECT_EQ(test, memcmp(src, dst, PAGE_SIZE), 0);
+
+	mutex_lock(memcomp_lock_of(ref->token));
+	mc16_view_locked(ref, &view);
+	*view.flags |= MC16_F_REFRESH_PENDING;
+	mutex_unlock(memcomp_lock_of(ref->token));
+	memset(dst, 0x5a, PAGE_SIZE);
+	KUNIT_EXPECT_EQ(test, mc16_load_page(ref, dst), -EAGAIN);
+	KUNIT_EXPECT_PTR_EQ(test, memchr_inv(dst, 0x5a, PAGE_SIZE), NULL);
+}
+
+static void memcomp_test_load_raw(struct kunit *test)
+{
+	mc16_test_load_payload(test, true, false);
+}
+
+static void memcomp_test_load_compressed(struct kunit *test)
+{
+	mc16_test_load_payload(test, false, false);
+}
+
+static void memcomp_test_load_writeback(struct kunit *test)
+{
+	mc16_test_load_payload(test, true, true);
+}
+#endif /* CONFIG_MEMCG */
+#endif /* _MM_MEMCOMP_TESTS_LOAD_TEST_H */
diff --git a/mm/memcomp/tests/migrate_test.h b/mm/memcomp/tests/migrate_test.h
new file mode 100644
index 0000000..dc961f9
--- /dev/null
+++ b/mm/memcomp/tests/migrate_test.h
@@ -0,0 +1,795 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_MIGRATE_TEST_H
+#define _MM_MEMCOMP_TESTS_MIGRATE_TEST_H
+
+/* Include after consumers_test.h; register these CONFIG_MEMCG cases in main. */
+#ifdef CONFIG_MEMCG
+#define MC16_MIGT_NR 4
+
+struct mc16_migt_saved {
+	u64 word;
+	u16 flags;
+	u16 length;
+};
+
+struct mc16_migt_snapshot {
+	struct mc16_migt_saved payload[MC16_MIGT_NR];
+	u32 charge[MC16_MIGT_NR];
+	int refs[MC16_MIGT_NR];
+	int members[MC16_MIGT_NR];
+	u16 nid[MC16_MIGT_NR];
+	long charged;
+	int charges;
+	int uncharges;
+	int gets;
+	int puts;
+	int src_refs;
+	int dst_refs;
+	s64 stored;
+	s64 compressed;
+	long eligible;
+};
+
+struct mc16_migt {
+	struct mc16_consumer_test *base;
+	struct memcomp_ref refs[MC16_MIGT_NR]; /* Initial OWNERs, not lookups. */
+	u32 tokens[MC16_MIGT_NR];
+	struct mc16_migt_saved saved[MC16_MIGT_NR];
+	bool swapped[MC16_MIGT_NR];
+	struct mc16_migt_snapshot before;
+	unsigned int nr;
+	u8 *data;
+	u8 *loaded;
+	unsigned int fail_index;
+	bool race;
+	bool changed;
+	u16 race_flags;
+	unsigned int trace[2 * MC16_MIGT_NR + 1];
+	unsigned int nr_trace;
+	bool all_pinned;
+	bool old_owner_seen;
+};
+
+static struct mc16_migt *mc16_migt_current;
+
+/* No swap IO is executed: temporarily install only its encoded representation.
+ * The real zs payload is retained privately and restored before any release.
+ * This checks that migration never touches backing ownership, not swap IO.
+ */
+static int mc16_migt_swapped(struct mc16_migt *f, unsigned int index, bool set)
+{
+	struct memcomp_ref *ref = &f->refs[index];
+	struct mc16_view view;
+	unsigned int old_state, new_state;
+	u64 word = 0;
+	u16 length = 0;
+	int ret = 0;
+
+	if (set && !mc16_swap_encode(0, 128 + index, 0,
+				     f->before.payload[index].length + 1,
+				     true, &word, &length))
+		return -EINVAL;
+	mutex_lock(memcomp_lock_of(ref->token));
+	if (!mc16_view_locked(ref, &view) || !view.member) {
+		ret = -EINVAL;
+		goto out;
+	}
+	old_state = mc16_flags_state(*view.flags);
+	mc16_account_state(ref, false);
+	if (set) {
+		f->saved[index] = (struct mc16_migt_saved) {
+			.word = *view.word, .length = *view.length, .flags = *view.flags,
+		};
+		*view.word = word;
+		*view.length = length;
+		*view.flags = (*view.flags & ~MC16_STATE_MASK) | MC16_SWAPPED;
+		memcomp_debug_long_inc(&memcomp_swapped_entries);
+	} else {
+		*view.word = f->saved[index].word;
+		*view.length = f->saved[index].length;
+		*view.flags = f->saved[index].flags;
+		memcomp_debug_long_dec(&memcomp_swapped_entries);
+	}
+	new_state = mc16_flags_state(*view.flags);
+	mc16_fifo_transition(ref, old_state, new_state);
+	mc16_account_state(ref, true);
+	f->swapped[index] = set;
+out:
+	mutex_unlock(memcomp_lock_of(ref->token));
+	return ret;
+}
+
+static void mc16_migt_restore_race(struct mc16_migt *f)
+{
+	struct memcomp_ref *ref;
+	struct mc16_view view;
+
+	if (!f->changed)
+		return;
+	ref = &f->refs[f->fail_index];
+	mutex_lock(memcomp_lock_of(ref->token));
+	if (mc16_view_locked(ref, &view))
+		*view.flags = f->race_flags;
+	mutex_unlock(memcomp_lock_of(ref->token));
+	f->changed = false;
+}
+
+static void mc16_migt_cleanup(void *data)
+{
+	struct mc16_migt *f = data;
+	struct folio *src = f->base->account, *dst = f->base->dst;
+	unsigned int i;
+
+	mc16_migt_current = NULL;
+	mc16_migt_restore_race(f);
+	for (i = 0; i < f->nr; i++) {
+		if (!f->refs[i].slot)
+			continue;
+		if (f->swapped[i])
+			mc16_migt_swapped(f, i, false);
+		mc16_ref_put(&f->refs[i]);
+	}
+	if (src) {
+		src->swap.val = 0;
+		src->mapping = NULL;
+		folio_clear_swapbacked(src);
+	}
+	if (dst) {
+		dst->swap.val = 0;
+		dst->mapping = NULL;
+		folio_clear_swapbacked(dst);
+	}
+}
+
+static int mc16_migt_payload(struct mc16_migt *f, unsigned int index)
+{
+	struct folio *src = f->base->account;
+	struct memcomp_ref *ref = &f->refs[index];
+	struct mc16_payload payload = { };
+	struct mc16_payload_tail tail = { };
+	unsigned long handle;
+	unsigned int bytes;
+	u8 pool = 0;
+	int ret;
+
+	ret = memcomp_prepare_payload(f->data + index * PAGE_SIZE, PAGE_SIZE,
+				      &bytes, &handle, &pool,
+				      MEMCOMP_PAYLOAD_MUST_SUCCEED, false);
+	if (ret)
+		return ret;
+	if (pool) {
+		memcomp_zs_free(pool, handle);
+		return -EINVAL;
+	}
+	payload = (struct mc16_payload) { .word = handle, .bytes = bytes };
+	ret = mc16_payload_charge(ref, &payload);
+	if (ret)
+		goto abort;
+	folio_lock(src);
+	mutex_lock(memcomp_lock_of(ref->token));
+	ret = mc16_payload_commit_locked(ref, src, f->nr, index, &payload, &tail);
+	mutex_unlock(memcomp_lock_of(ref->token));
+	mc16_payload_finish(ref, &tail);
+	folio_unlock(src);
+abort:
+	mc16_payload_abort(ref, &payload);
+	return ret;
+}
+
+static struct mc16_migt *
+mc16_migt_begin(struct kunit *test, unsigned int nr, unsigned int state)
+{
+	struct mc16_migt *f;
+	struct mc16_record *record;
+	struct folio *src, *dst;
+	unsigned int i;
+	int ret;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->base = mc16_consumer_test_begin(test);
+	if (!f->base)
+		return NULL;
+	f->fail_index = UINT_MAX;
+	if (nr > 1) {
+		src = folio_alloc(GFP_KERNEL, ilog2(nr));
+		dst = folio_alloc(GFP_KERNEL, ilog2(nr));
+		if (!src || !dst) {
+			if (src)
+				folio_put(src);
+			if (dst)
+				folio_put(dst);
+			return NULL;
+		}
+		folio_put(f->base->account);
+		folio_put(f->base->dst);
+		f->base->account = src;
+		f->base->dst = dst;
+		f->base->model.folio = src;
+	}
+	if (kunit_add_action_or_reset(test, mc16_migt_cleanup, f))
+		return NULL;
+	src = f->base->account;
+	dst = f->base->dst;
+	src->mapping = (struct address_space *)PAGE_MAPPING_ANON;
+	dst->mapping = (struct address_space *)PAGE_MAPPING_ANON;
+	__folio_set_swapbacked(src);
+	__folio_set_swapbacked(dst);
+	f->data = kunit_kmalloc(test, nr * PAGE_SIZE, GFP_KERNEL);
+	f->loaded = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	if (!f->data || !f->loaded)
+		return NULL;
+	for (i = 0; i < nr * PAGE_SIZE; i++)
+		f->data[i] = state == MC16_SAMEFILL ? 0x6e : (i + i / PAGE_SIZE) % 47;
+	for (i = 0; i < nr; i++) {
+		void *mapped = kmap_local_folio(src, i * PAGE_SIZE);
+
+		memcpy(mapped, f->data + i * PAGE_SIZE, PAGE_SIZE);
+		kunmap_local(mapped);
+	}
+	record = mc16_record_alloc(src, nr, false);
+	if (IS_ERR(record))
+		return NULL;
+	ret = mc16_reserve(record, nr, MC16_KEY_ANON, f->refs);
+	if (ret) {
+		mc16_record_abort(record);
+		return NULL;
+	}
+	f->nr = nr;
+	for (i = 0; i < nr; i++) {
+		mc16_account_reservation(&f->refs[i]);
+		f->tokens[i] = f->refs[i].token;
+	}
+	src->swap = make_memcomp_entry(f->tokens[0]);
+	if (state == MC16_PENDING)
+		return f;
+	for (i = 0; i < nr; i++) {
+		if (mc16_migt_payload(f, i))
+			return NULL;
+	}
+	return f;
+}
+
+/* Snapshot scalars under T; no record/member pointer is kept across T. */
+static void mc16_migt_snapshot(struct mc16_migt *f,
+			       struct mc16_migt_snapshot *s, struct folio *owner)
+{
+	struct memcomp_kunit_objcg *model = &f->base->model;
+	struct kunit *test = f->base->test;
+	struct mc16_view view;
+	unsigned int i;
+	bool valid;
+
+	for (i = 0; i < f->nr; i++) {
+		struct memcomp_ref *ref = &f->refs[i];
+
+		if (!ref->slot)
+			continue;
+		mutex_lock(memcomp_lock_of(ref->token));
+		valid = mc16_view_locked(ref, &view) && view.record;
+		if (valid) {
+			s->payload[i] = (struct mc16_migt_saved) {
+				.word = *view.word, .flags = *view.flags,
+				.length = *view.length,
+			};
+			s->charge[i] = view.member->payload_charge;
+			s->members[i] = refcount_read(&view.record->members);
+			valid = view.member->owner_folio == owner &&
+				view.record->producer == f->base->account &&
+				view.record->nid == ref->cluster->key->nid;
+		}
+		mutex_unlock(memcomp_lock_of(ref->token));
+		KUNIT_EXPECT_TRUE(test, valid);
+		s->refs[i] = refcount_read(&ref->slot->refs);
+		s->nid[i] = ref->cluster->key->nid;
+	}
+	s->charged = atomic_long_read(&model->charged);
+	s->charges = atomic_read(&model->charge_calls);
+	s->uncharges = atomic_read(&model->uncharge_calls);
+	s->gets = atomic_read(&model->get_calls);
+	s->puts = atomic_read(&model->put_calls);
+	s->src_refs = folio_ref_count(f->base->account);
+	s->dst_refs = folio_ref_count(f->base->dst);
+	s->stored = atomic64_read(&memcomp_stored_bytes);
+	s->compressed = atomic64_read(&memcomp_compressed_bytes);
+	s->eligible = atomic_long_read(&mc16_fifo_of(&f->refs[0])->nr_entries);
+}
+
+static void mc16_migt_unchanged(struct mc16_migt *f, struct folio *owner)
+{
+	struct mc16_migt_snapshot after = { };
+	unsigned int i;
+
+	mc16_migt_snapshot(f, &after, owner);
+	for (i = 0; i < f->nr; i++) {
+		KUNIT_EXPECT_EQ(f->base->test, after.payload[i].word,
+				f->before.payload[i].word);
+		KUNIT_EXPECT_EQ(f->base->test, after.payload[i].flags,
+				f->before.payload[i].flags);
+		KUNIT_EXPECT_EQ(f->base->test, after.payload[i].length,
+				f->before.payload[i].length);
+		KUNIT_EXPECT_EQ(f->base->test, after.charge[i],
+				f->before.charge[i]);
+		KUNIT_EXPECT_EQ(f->base->test, after.refs[i],
+				f->before.refs[i]);
+		KUNIT_EXPECT_EQ(f->base->test, after.members[i],
+				f->before.members[i]);
+		KUNIT_EXPECT_EQ(f->base->test, after.nid[i],
+				f->before.nid[i]);
+	}
+	KUNIT_EXPECT_EQ(f->base->test, after.charged, f->before.charged);
+	KUNIT_EXPECT_EQ(f->base->test, after.charges, f->before.charges);
+	KUNIT_EXPECT_EQ(f->base->test, after.uncharges, f->before.uncharges);
+	KUNIT_EXPECT_EQ(f->base->test, after.gets, f->before.gets);
+	KUNIT_EXPECT_EQ(f->base->test, after.puts, f->before.puts);
+	KUNIT_EXPECT_EQ(f->base->test, after.src_refs, f->before.src_refs);
+	KUNIT_EXPECT_EQ(f->base->test, after.dst_refs, f->before.dst_refs);
+	KUNIT_EXPECT_EQ(f->base->test, after.stored, f->before.stored);
+	KUNIT_EXPECT_EQ(f->base->test, after.compressed, f->before.compressed);
+	KUNIT_EXPECT_EQ(f->base->test, after.eligible, f->before.eligible);
+}
+
+static void mc16_migt_bytes(struct mc16_migt *f)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < f->nr; i++) {
+		if (!f->refs[i].slot)
+			continue;
+		if (f->swapped[i]) {
+			ret = mc16_migt_swapped(f, i, false);
+			KUNIT_ASSERT_EQ(f->base->test, ret, 0);
+		}
+		ret = mc16_load_page(&f->refs[i], f->loaded);
+		KUNIT_ASSERT_EQ(f->base->test, ret, 0);
+		KUNIT_EXPECT_EQ(f->base->test,
+				memcmp(f->loaded, f->data + i * PAGE_SIZE, PAGE_SIZE), 0);
+	}
+}
+
+static int mc16_migt_move_window(struct memcomp_ref *ref, struct folio *from,
+				 struct folio *to, unsigned int index)
+{
+	struct mc16_migt *f = mc16_migt_current;
+	struct mc16_view view;
+	unsigned int i;
+	bool forward = from == f->base->account;
+
+	if (f->nr_trace < ARRAY_SIZE(f->trace))
+		f->trace[f->nr_trace++] = index | (forward ? 0 : 0x80);
+	if (!index && forward) {
+		f->all_pinned = true;
+		for (i = 0; i < f->nr; i++)
+			f->all_pinned &= refcount_read(&f->refs[i].slot->refs) == 2;
+	}
+	if (!forward || index != f->fail_index)
+		return 0;
+	mutex_lock(memcomp_lock_of(ref->token));
+	if (mc16_view_locked(ref, &view)) {
+		f->old_owner_seen = view.member->owner_folio == from;
+		if (f->race) {
+			f->race_flags = *view.flags;
+			*view.flags &= ~MC16_F_OWNER;
+			f->changed = true;
+		}
+	}
+	mutex_unlock(memcomp_lock_of(ref->token));
+	return f->race ? 0 : -EAGAIN;
+}
+
+/* Every acquired folio lock is released before any fatal test assertion. */
+static int mc16_migt_call(struct mc16_migt *f, bool rollback,
+			  bool lock_src, bool lock_dst, bool inject)
+{
+	struct folio *src = f->base->account, *dst = f->base->dst;
+	int ret = 0;
+
+	if (inject) {
+		mc16_migt_current = f;
+		kunit_activate_static_stub(f->base->test, mc16_migrate_move_error,
+					   mc16_migt_move_window);
+	}
+	if (lock_src)
+		folio_lock(src);
+	if (lock_dst)
+		folio_lock(dst);
+	if (rollback)
+		mc16_migrate_folio_rollback(dst, src);
+	else
+		ret = mc16_migrate_folio(dst, src);
+	if (lock_dst)
+		folio_unlock(dst);
+	if (lock_src)
+		folio_unlock(src);
+	if (inject) {
+		kunit_deactivate_static_stub(f->base->test, mc16_migrate_move_error);
+		mc16_migt_current = NULL;
+	}
+	mc16_migt_restore_race(f);
+	return ret;
+}
+
+struct mc16_migt_metadata {
+	unsigned long entry;
+	u32 token[MC16_MIGT_NR];
+	unsigned short source_id[MC16_MIGT_NR];
+	u64 shadow[MC16_MIGT_NR];
+};
+
+/* Existing OWNER refs pin slots/keys; only scalars leave the lock scope. */
+static bool
+mc16_migt_metadata_snapshot(struct mc16_migt *f, struct folio *owner,
+			    struct mc16_migt_metadata *s, bool seed)
+{
+	unsigned long token;
+	unsigned int i;
+	bool valid;
+
+	folio_lock(owner);
+	s->entry = owner->swap.val;
+	token = swp_offset(owner->swap);
+	valid = folio_memcomp_reserved(owner);
+	for (i = 0; valid && i < f->nr; i++) {
+		struct memcomp_ref *ref = &f->refs[i];
+		u64 *shadow;
+
+		mutex_lock(memcomp_lock_of(ref->token));
+		shadow = mc16_shadow_ptr(ref);
+		valid = shadow && ref->token == token + i &&
+			mc16_owner_matches_locked(ref, owner, f->nr, i);
+		if (valid && seed) {
+			valid = !*shadow;
+			/* Opaque words; never passed to stock refault. */
+			if (valid)
+				*shadow = (unsigned long)xa_mk_value(0x100 + i);
+		}
+		if (valid) {
+			s->token[i] = ref->token;
+			s->source_id[i] = mc16_owner_id(ref);
+			s->shadow[i] = *shadow;
+		}
+		mutex_unlock(memcomp_lock_of(ref->token));
+	}
+	folio_unlock(owner);
+	return valid;
+}
+
+static void mc16_migt_success(struct kunit *test, unsigned int state)
+{
+	struct mc16_migt *f = mc16_migt_begin(test, MC16_MIGT_NR, state);
+	struct mc16_migt_metadata before = { }, after = { };
+	unsigned int i;
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	mc16_migt_snapshot(f, &f->before, f->base->account);
+	if (state == MC16_SWAPPED) {
+		for (i = 0; i < f->nr; i++)
+			KUNIT_ASSERT_EQ(test, mc16_migt_swapped(f, i, true), 0);
+		mc16_migt_snapshot(f, &f->before, f->base->account);
+	}
+	KUNIT_ASSERT_TRUE(test,
+			  mc16_migt_metadata_snapshot(f, f->base->account,
+						      &before, true));
+	ret = mc16_migt_call(f, false, true, true, false);
+	KUNIT_ASSERT_EQ(test, ret, 1);
+	KUNIT_EXPECT_EQ(test, f->base->dst->swap.val, f->base->account->swap.val);
+	mc16_migt_unchanged(f, f->base->dst);
+	KUNIT_ASSERT_TRUE(test,
+			  mc16_migt_metadata_snapshot(f, f->base->dst,
+						      &after, false));
+	KUNIT_EXPECT_EQ(test, after.entry, before.entry);
+	for (i = 0; i < f->nr; i++) {
+		KUNIT_EXPECT_EQ(test, after.token[i], before.token[i]);
+		KUNIT_EXPECT_EQ(test, after.source_id[i],
+				before.source_id[i]);
+		KUNIT_EXPECT_EQ(test, after.shadow[i], before.shadow[i]);
+	}
+	mc16_migt_bytes(f);
+}
