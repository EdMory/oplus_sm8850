+struct memcomp_async {
+	/* Requests not yet done, plus one until the batch is waited for. */
+	atomic_t pending;
+	struct completion done;
+	unsigned int id;
+	/* Requests taken, from the first. */
+	unsigned int nr;
+	struct memcomp_async_req reqs[MEMCOMP_ASYNC_PAGES];
+};
