+static void memcomp_test_migrate_dst_geometry(struct kunit *test)
+{
+	struct mc16_migt *f = mc16_migt_begin(test, MC16_MIGT_NR, MC16_STORED);
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
