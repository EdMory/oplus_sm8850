+static unsigned int memcomp_test_reclaimer_enter(void)
+{
+	unsigned int flags = current->flags & (PF_MEMALLOC | PF_KSWAPD);
+
+	current->flags |= PF_MEMALLOC | PF_KSWAPD;
+	return flags;
+}
