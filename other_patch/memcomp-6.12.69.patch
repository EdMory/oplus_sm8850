+		{ "swap-device", required_argument, NULL, 's' },
+		{ "swapoff", required_argument, NULL, 's' },
+		{ "swapon-flags", required_argument, NULL, 'f' },
+		{ "rewrite-only", no_argument, NULL, 'r' },
+		{ "help", no_argument, NULL, 'h' },
+		{ }
+	};
+	unsigned long flags;
+	char *end;
+	int c;
