+	KUNIT_EXPECT_EQ(test, atomic_read(&anon_vma->refcount), refs);
+
+	/* Released the way reclaim frees a stored folio. */
+	memcomp_invalidate_folio(folio);
+	KUNIT_EXPECT_EQ(test, atomic_read(&anon_vma->refcount), refs);
+	folio_unlock(folio);
+	folio_put(folio);
