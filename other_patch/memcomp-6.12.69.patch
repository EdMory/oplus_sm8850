+static void memcomp_test_fill_incompressible(void *buf,
+					     unsigned int nr_pages)
+{
+	u32 *words = buf;
+	u32 value = 0x9e3779b9;
+	unsigned int i;
+
+	for (i = 0; i < nr_pages * PAGE_SIZE / sizeof(*words); i++) {
+		value ^= value << 13;
+		value ^= value >> 17;
+		value ^= value << 5;
+		words[i] = value;
+	}
+}
