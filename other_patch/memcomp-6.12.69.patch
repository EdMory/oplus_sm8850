+static bool mc16_ws_id_get_ref(unsigned short id)
+{
+	if (!id)
+		return true;
+	mc16_ws_id_get_calls++;
+	return id == 7;
+}
+
+static void mc16_ws_id_put(unsigned short id)
+{
+	if (id)
+		mc16_ws_id_put_calls++;
+}
