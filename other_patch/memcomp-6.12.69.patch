+
+/* Whether folio->swap names a span reclaim holds for the anonymous @folio. */
+static inline bool folio_memcomp_reserved(struct folio *folio)
+{
+	return is_memcomp_entry(folio->swap) &&
+	       !memcomp_entry_is_mark(folio->swap);
