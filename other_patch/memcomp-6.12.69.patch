+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_REFS_TEST_H
+#define _MM_MEMCOMP_TESTS_REFS_TEST_H
+#ifdef CONFIG_MEMCG
+struct mc16_test_refs {
+	struct mc16_test_storage *storage;
+	bool published[MC16_TEST_REFS];
+	s64 stored_before;
+	s64 compressed_before;
+	s64 pending_before;
+};
+
+static void mc16_test_refs_cleanup(void *data)
+{
+	struct mc16_test_refs *f = data;
+	struct mc16_test_storage *storage = f->storage;
+	unsigned int i;
+
+	for (i = 0; i < storage->nr; i++) {
+		if (f->published[i] && storage->refs[i].slot)
+			mc16_ref_put(&storage->refs[i]);
+	}
+	KUNIT_EXPECT_EQ(storage->test, atomic64_read(&memcomp_stored_bytes),
+			f->stored_before);
+	KUNIT_EXPECT_EQ(storage->test, atomic64_read(&memcomp_compressed_bytes),
+			f->compressed_before);
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	KUNIT_EXPECT_EQ(storage->test, atomic64_read(&memcomp_pending_pages),
+			f->pending_before);
+#endif
+}
+
+static struct mc16_test_refs *mc16_test_refs_begin(struct kunit *test)
+{
+	struct mc16_test_refs *f;
+	int ret;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->storage = mc16_test_storage_begin(test);
+	if (!f->storage)
+		return NULL;
+	f->stored_before = atomic64_read(&memcomp_stored_bytes);
+	f->compressed_before = atomic64_read(&memcomp_compressed_bytes);
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	f->pending_before = atomic64_read(&memcomp_pending_pages);
+#endif
+	ret = kunit_add_action_or_reset(test, mc16_test_refs_cleanup, f);
+	return ret ? NULL : f;
+}
+
+static int mc16_test_refs_reserve(struct mc16_test_refs *f, unsigned int nr)
+{
+	unsigned int start = f->storage->nr, i;
+	int ret;
+
+	ret = mc16_test_reserve(f->storage, nr);
+	if (ret)
+		return ret;
+	for (i = start; i < start + nr; i++) {
+		mc16_account_reservation(&f->storage->refs[i]);
+		f->published[i] = true;
+	}
+	return 0;
+}
+
+/* Publish a real payload while the slot remains physically record-backed. */
+static int mc16_test_refs_payload(struct mc16_test_refs *f, unsigned int i,
+				  unsigned int state)
+{
+	struct memcomp_ref *ref = &f->storage->refs[i];
+	struct mc16_view view;
+	unsigned long handle = 0;
+	u32 bytes = state == MC16_STORED ? PAGE_SIZE : 0;
+	int ret;
+
+	if (bytes) {
+		ret = memcomp_zs_malloc(memcomp_pools[0], bytes, &handle, false);
+		if (ret)
+			return ret;
+		ret = memcomp_objcg_charge(&f->storage->owner->model.objcg,
+					   GFP_KERNEL, bytes);
+		if (ret) {
+			memcomp_zs_free(0, handle);
+			return ret;
+		}
+	}
+	mutex_lock(memcomp_lock_of(ref->token));
+	mc16_view_locked(ref, &view);
+	mc16_account_state(ref, false);
+	folio_put(view.member->owner_folio);
+	*view.flags = (*view.flags & MC16_ORDER_MASK) | state | MC16_F_OWNER;
+	*view.length = bytes ? bytes - 1 : 0;
+	*view.word = bytes ? handle : 0x9a9a9a9a9a9a9a9aULL;
+	view.member->payload_charge = bytes;
+	memcomp_debug_dec(&memcomp_pending_pages);
+	memcomp_compressed_bytes_add(bytes);
+	mc16_account_state(ref, true);
+	mc16_fifo_transition(ref, MC16_PENDING, state);
+	mutex_unlock(memcomp_lock_of(ref->token));
+	return 0;
+}
+
+static void memcomp_test_put_pair(struct kunit *test)
+{
+	struct mc16_test_refs *f;
+	struct memcomp_ref guard;
+	spinlock_t ptl; /* Models a paired lookup and persistent PTE put. */
+	unsigned long irqflags;
+	u32 token;
+
+	f = mc16_test_refs_begin(test);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_EQ(test, mc16_test_refs_reserve(f, 1), 0);
+	token = f->storage->refs[0].token;
+	KUNIT_ASSERT_TRUE(test, mc16_get(token, &guard));
+	f->storage->refs[0] = (struct memcomp_ref) { };
+	spin_lock_init(&ptl);
+	spin_lock_irqsave(&ptl, irqflags);
+	mc16_ref_put_count(&guard, 2);
+	spin_unlock_irqrestore(&ptl, irqflags);
+	KUNIT_EXPECT_PTR_EQ(test, guard.slot, NULL);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(f->storage->owner->folio), 1);
+	KUNIT_EXPECT_FALSE(test, mc16_get(token, &guard));
+}
+
+static void memcomp_test_fifo_eligibility(struct kunit *test)
+{
+	struct mc16_test_refs *f;
+	struct mc16_test_storage *storage;
+	struct memcomp_lru *fifo;
+	struct memcomp_ref guard;
+	unsigned int budget;
+	long before;
+
+	f = mc16_test_refs_begin(test);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	storage = f->storage;
+	KUNIT_ASSERT_EQ(test, mc16_test_refs_reserve(f, 2), 0);
+	fifo = mc16_fifo_of(&storage->refs[0]);
+	before = atomic_long_read(&fifo->nr_entries);
+	KUNIT_ASSERT_EQ(test, mc16_test_refs_payload(f, 0, MC16_STORED), 0);
+	KUNIT_ASSERT_EQ(test, mc16_test_refs_payload(f, 1, MC16_SAMEFILL), 0);
+	KUNIT_EXPECT_EQ(test, storage->refs[0].cluster->eligible_slots, (u16)1);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&fifo->nr_entries), before + 1);
+	budget = 2;
+	KUNIT_ASSERT_TRUE(test, mc16_fifo_select(fifo, &budget, &guard));
+	KUNIT_EXPECT_EQ(test, guard.token, storage->refs[0].token);
+	mc16_ref_put(&guard);
+	mc16_ref_put(&storage->refs[0]);
+	KUNIT_EXPECT_EQ(test, storage->refs[1].cluster->eligible_slots, (u16)0);
+	KUNIT_EXPECT_TRUE(test, list_empty(&storage->refs[1].cluster->fifo));
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&fifo->nr_entries), before);
+	/* SAMEFILL may still live but can no longer keep a cluster on FIFO. */
+	budget = 10;
+	KUNIT_EXPECT_FALSE(test, mc16_fifo_select(fifo, &budget, &guard));
+	KUNIT_EXPECT_EQ(test, budget, 10U);
+}
+
+static void memcomp_test_fifo_scan_budget(struct kunit *test)
+{
+	struct mc16_test_refs *f;
+	struct mc16_test_storage *storage;
+	struct memcomp_ref guard;
+	struct mc16_view view;
+	struct memcomp_lru *fifo;
+	unsigned int i, budget = 65, state, found = 0;
+
+	f = mc16_test_refs_begin(test);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	storage = f->storage;
+	for (i = 0; i < 65; i++)
+		KUNIT_ASSERT_EQ(test, mc16_test_refs_reserve(f, 1), 0);
+	KUNIT_ASSERT_EQ(test, mc16_test_refs_payload(f, 64, MC16_STORED), 0);
+	fifo = mc16_fifo_of(&storage->refs[64]);
+	while (mc16_fifo_select(fifo, &budget, &guard)) {
+		mutex_lock(memcomp_lock_of(guard.token));
+		mc16_view_locked(&guard, &view);
+		state = mc16_flags_state(*view.flags);
+		mutex_unlock(memcomp_lock_of(guard.token));
+		if (state == MC16_STORED)
+			found++;
+		mc16_ref_put(&guard);
+	}
+	KUNIT_EXPECT_EQ(test, found, 1U);
+	KUNIT_EXPECT_EQ(test, budget, 0U);
+}
+
+static void memcomp_test_writeback_last_guard(struct kunit *test)
+{
+	struct mc16_test_refs *f;
+	struct mc16_test_storage *storage;
+	struct memcomp_ref writer;
+	struct mc16_view view;
+	struct memcomp_lru *fifo;
+	unsigned int budget = 1;
+	bool hot;
+
+	f = mc16_test_refs_begin(test);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	storage = f->storage;
+	KUNIT_ASSERT_EQ(test, mc16_test_refs_reserve(f, 1), 0);
+	KUNIT_ASSERT_EQ(test, mc16_test_refs_payload(f, 0, MC16_STORED), 0);
+	fifo = mc16_fifo_of(&storage->refs[0]);
+	KUNIT_ASSERT_TRUE(test, mc16_fifo_select(fifo, &budget, &writer));
+	mutex_lock(memcomp_lock_of(writer.token));
+	mc16_view_locked(&writer, &view);
+	*view.flags |= MC16_F_REFERENCED;
+	hot = mc16_fifo_second_chance_locked(&writer);
+	KUNIT_EXPECT_TRUE(test, hot);
+	KUNIT_EXPECT_FALSE(test, mc16_fifo_second_chance_locked(&writer));
+	mc16_fifo_transition(&writer, MC16_STORED, MC16_WRITEBACK);
+	*view.flags = (*view.flags & ~MC16_STATE_MASK) | MC16_WRITEBACK;
+	mutex_unlock(memcomp_lock_of(writer.token));
+	/* PTE/owner release cannot destroy a payload still held by the writer. */
+	mc16_ref_put(&storage->refs[0]);
+	KUNIT_EXPECT_EQ(test, refcount_read(&writer.slot->refs), 1U);
+	KUNIT_EXPECT_TRUE(test, list_empty(&fifo->entries));
+	mc16_ref_put(&writer);
+	KUNIT_EXPECT_PTR_EQ(test, writer.slot, NULL);
+}
+#endif /* CONFIG_MEMCG */
+#endif /* _MM_MEMCOMP_TESTS_REFS_TEST_H */
diff --git a/mm/memcomp/tests/replacement_test.h b/mm/memcomp/tests/replacement_test.h
new file mode 100644
index 0000000..ee212ce
--- /dev/null
+++ b/mm/memcomp/tests/replacement_test.h
@@ -0,0 +1,360 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_REPLACEMENT_TEST_H
+#define _MM_MEMCOMP_TESTS_REPLACEMENT_TEST_H
+
+/*
+ * Author: nakixii
+ *
+ * Include after store_transaction_test.h in suite.h.
+ * Register the four cases below under MC16_REPLACEMENT_TEST_ENABLED.
+ * Inherits MEMCOMP_KUNIT_TEST (DEBUG_STATS), MEMCG, MMU, ADVISE_SYSCALLS.
+ *
+ * Old oracles: 6cc25de18927:mm/suite.h:
+ * refresh_rejects_mixed_state: -EAGAIN, one state event/two pages, unchanged
+ * PENDING+RESIDENT and SAMEFILL members, one pending page, balanced rollback.
+ * reserve_replaces_stored_span: a different reservation, one pending page,
+ * old token absent after its final reference, balanced reservation teardown.
+ * Extend replacement to order 1 and retain real old payloads with guards.
+ *
+ * Public reserve/store/load/release and real MM/PTE/rmap/codec/zs execute.
+ * A sibling SAMEFILL uses the existing real payload commit/finish fixture;
+ * the reverse mixed order uses an injected second-commit store failure.
+ * No fabricated entry state or mocked successful store is used.
+ * There is no public refresh entry point: call the production mc16 refresh
+ * transaction for its state-event oracle, and separately check public store's
+ * earlier mixed-span PREFLIGHT rejection. These counters are not interchangeable.
+ * Objcg/slot allocation and commit failure routing use the serial test models.
+ * No concurrent race, device IO or reclaim scheduling coverage is claimed.
+ * All actors release locks/leases before returning to any KUnit assertion.
+ */
+#ifdef MC16_STORE_TRANSACTION_TEST_ENABLED
+#define MC16_REPLACEMENT_TEST_ENABLED
+
+struct mc16_rct_member {
+	u64 word;
+	u16 length;
+	u16 flags;
+	unsigned int refs;
+	bool valid;
+};
+
+/* Only scalar effective state crosses T; the caller owns the lookup guard. */
+static struct mc16_rct_member mc16_rct_member(struct memcomp_ref *ref)
+{
+	struct mc16_rct_member s = { };
+	struct mc16_view view;
+
+	mutex_lock(memcomp_lock_of(ref->token));
+	if (mc16_view_locked(ref, &view)) {
+		s.word = *view.word;
+		s.length = *view.length;
+		s.flags = *view.flags;
+		s.refs = refcount_read(&ref->slot->refs);
+		s.valid = mc16_flags_valid(s.flags);
+	}
+	mutex_unlock(memcomp_lock_of(ref->token));
+	return s;
+}
+
+/* Drop the temporary public lookup before returning or asserting. */
+static struct mc16_rct_member mc16_rct_lookup(unsigned long token)
+{
+	struct mc16_rct_member s = { };
+	struct memcomp_ref ref = { };
+
+	if (memcomp_entry_get_ref(token, &ref)) {
+		s = mc16_rct_member(&ref);
+		/* Report references excluding this temporary lookup. */
+		if (s.refs)
+			s.refs--;
+		memcomp_entry_put_ref(&ref);
+	}
+	return s;
+}
+
+static void mc16_rct_expect_unchanged(struct mc16_flt *f,
+				      struct mc16_rct_member before[2])
+{
+	struct mc16_rct_member after;
+	unsigned int i;
+
+	for (i = 0; i < f->nr; i++) {
+		after = mc16_rct_member(&f->guards[i]);
+		KUNIT_EXPECT_TRUE(f->test, after.valid);
+		KUNIT_EXPECT_EQ(f->test, after.word, before[i].word);
+		KUNIT_EXPECT_EQ(f->test, after.length, before[i].length);
+		KUNIT_EXPECT_EQ(f->test, after.flags, before[i].flags);
+		KUNIT_EXPECT_EQ(f->test, after.refs, before[i].refs);
+	}
+}
+
+/* Unlike public store, the refresh transaction retains the caller's ctx. */
+static int mc16_rct_refresh(struct mc16_flt *f, const void *src)
+{
+	struct memcomp_reclaim_ctx *ctx;
+	struct memcomp_store_ctx store = { };
+	unsigned int flags;
+	int ret = -EBUSY;
+
+	flags = memcomp_test_reclaimer_enter();
+	ctx = memcomp_reclaim_ctx_get(f->nr, MEMCOMP_RECLAIM_KSWAPD);
+	if (!ctx)
+		goto out;
+	folio_lock(f->folio);
+	ret = mc16_anon_refresh(&ctx, src, f->nr, &store, f->guards);
+	folio_unlock(f->folio);
+	if (ctx)
+		memcomp_reclaim_ctx_put(ctx);
+	memcomp_direct_staging_put(store.staging);
+out:
+	memcomp_test_reclaimer_exit(flags);
+	return ret;
+}
+
+static void mc16_rct_mixed(struct kunit *test, bool sibling_samefill)
+{
+	struct mc16_flt *f = mc16_flt_begin(test, 1);
+	struct mc16_rct_member members[2];
+	struct mc16_sct_stats stats;
+	s64 pending;
+	long charged;
+	u8 *src, *dst;
+	unsigned int i, stored = sibling_samefill ? 1 : 0;
+	int pins, ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	src = kunit_kmalloc(test, 2 * PAGE_SIZE, GFP_KERNEL);
+	dst = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	KUNIT_ASSERT_NOT_NULL(test, dst);
+	mc16_sct_pattern(src, 2, false);
+	if (sibling_samefill)
+		memset(src + PAGE_SIZE, 0x5a, PAGE_SIZE);
+	mc16_sct_copy(f, src);
+	pending = atomic64_read(&memcomp_pending_pages);
+	pins = atomic_read(&f->anon_vma->refcount);
+	KUNIT_ASSERT_TRUE(test, mc16_sct_reserve(f));
+	KUNIT_ASSERT_EQ(test, mc16_flt_hold(f), 0);
+	for (i = 0; i < f->nr; i++)
+		KUNIT_ASSERT_EQ(test, mc16_flt_escape(f, i), 0);
+	stats = mc16_sct_stats_read();
+	if (sibling_samefill) {
+		/* Actual SAMEFILL commit matches the source bytes above. */
+		KUNIT_ASSERT_EQ(test, mc16_flt_commit(f, 1), 0);
+		mc16_sct_stats_expect(test, stats, (struct mc16_sct_stats) { });
+	} else {
+		/* Real codec/zs prefix, then public store fails commit 2. */
+		mc16_sct_run(f, (struct mc16_sct_attempt) {
+			.fail = MEMCOMP_KUNIT_FAIL_REFRESH_COMMIT, .nth = 2,
+		}, false);
+		mc16_sct_stats_expect(test, stats, (struct mc16_sct_stats) {
+			.state = 1, .state_pages = 2, .bg_fail = 2,
+		});
+	}
+	for (i = 0; i < f->nr; i++) {
+		members[i] = mc16_rct_member(&f->guards[i]);
+		KUNIT_ASSERT_TRUE(test, members[i].valid);
+		KUNIT_EXPECT_TRUE(test, members[i].flags & MC16_F_OWNER);
+		KUNIT_EXPECT_FALSE(test, members[i].flags & MC16_F_REFRESH_PENDING);
+		KUNIT_EXPECT_EQ(test, members[i].refs, 3U);
+		KUNIT_EXPECT_EQ(test, mc16_flags_state(members[i].flags),
+				i == stored ? (sibling_samefill ? MC16_SAMEFILL :
+				MC16_STORED) : MC16_PENDING);
+		KUNIT_EXPECT_EQ(test, !!(members[i].flags & MC16_F_RESIDENT),
+				i != stored);
+	}
+	KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_pending_pages), pending + 1);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(f->folio), 2);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->anon_vma->refcount), pins + 1);
+	charged = atomic_long_read(&f->base->model.charged);
+	stats = mc16_sct_stats_read();
+	ret = mc16_rct_refresh(f, src);
+	KUNIT_EXPECT_EQ(test, ret, -EAGAIN);
+	mc16_sct_stats_expect(test, stats, (struct mc16_sct_stats) {
+		.state = 1, .state_pages = 2,
+	});
+	mc16_rct_expect_unchanged(f, members);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&f->base->model.charged), charged);
+	KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_pending_pages), pending + 1);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(f->folio), 2);
+	stats = mc16_sct_stats_read();
+	/* Public wrapper refuses the mixed span before refresh validation. */
+	mc16_sct_run(f, (struct mc16_sct_attempt) { }, false);
+	mc16_sct_stats_expect(test, stats, (struct mc16_sct_stats) {
+		.preflight = 2, .bg_fail = 2,
+	});
+	mc16_rct_expect_unchanged(f, members);
+	KUNIT_EXPECT_EQ(test, atomic_long_read(&f->base->model.charged), charged);
+	KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_pending_pages), pending + 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->anon_vma->refcount), pins + 1);
+	mc16_sct_rollback(f);
+	for (i = 0; i < f->nr; i++) {
+		mc16_flt_expect_present(f, i, f->addr + i * PAGE_SIZE);
+		KUNIT_EXPECT_FALSE(test, mc16_flt_flags(&f->guards[i], false) &
+				   MC16_F_OWNER);
+		KUNIT_EXPECT_EQ(test, refcount_read(&f->guards[i].slot->refs), 1U);
+	}
+	/* Normalized committed member remains loadable through its guard. */
+	mc16_sct_expect_load(f, stored, src + stored * PAGE_SIZE, dst);
+	for (i = 0; i < f->nr; i++)
+		memcomp_entry_put_ref(&f->guards[i]);
+	KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_pending_pages), pending);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->anon_vma->refcount), pins);
+}
+
+static void memcomp_test_replacement_mixed_sibling(struct kunit *test)
+{
+	mc16_rct_mixed(test, true);
+}
+
+static void memcomp_test_replacement_mixed_head(struct kunit *test)
+{
+	mc16_rct_mixed(test, false);
+}
+
+static void mc16_rct_load(struct mc16_flt *f, unsigned long token,
+			  const void *src, void *dst)
+{
+	struct memcomp_ref ref = { };
+	void *bytes;
+	int ret = -ENOENT;
+
+	if (memcomp_load_folio_pin(token, &ref)) {
+		folio_lock(f->base->dst);
+		ret = memcomp_load_folio(&ref, f->base->dst);
+		if (!ret) {
+			bytes = kmap_local_folio(f->base->dst, 0);
+			memcpy(dst, bytes, PAGE_SIZE);
+			kunmap_local(bytes);
+		}
+		folio_unlock(f->base->dst);
+		memcomp_load_folio_abort(&ref);
+	}
+	KUNIT_EXPECT_EQ(f->test, ret, 0);
+	if (!ret)
+		KUNIT_EXPECT_EQ(f->test, memcmp(src, dst, PAGE_SIZE), 0);
+}
+
+static void mc16_rct_release_guards(void *data)
+{
+	struct memcomp_ref *refs = data;
+	unsigned int i;
+
+	for (i = 0; i < 2; i++)
+		memcomp_entry_put_ref(&refs[i]);
+}
+
+static void mc16_rct_replace(struct kunit *test, unsigned int order)
+{
+	struct mc16_flt *f = mc16_flt_begin(test, order);
+	struct mc16_rct_member old, fresh;
+	struct memcomp_ref *new_guards;
+	struct mc16_sct_stats stats;
+	unsigned long token, old_tokens[2];
+	u8 *src, *next, *dst;
+	s64 pending;
+	unsigned int i;
+	int pins;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	new_guards = kunit_kcalloc(test, 2, sizeof(*new_guards), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, new_guards);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+							mc16_rct_release_guards, new_guards), 0);
+	src = kunit_kmalloc(test, f->nr * PAGE_SIZE, GFP_KERNEL);
+	next = kunit_kmalloc(test, f->nr * PAGE_SIZE, GFP_KERNEL);
+	dst = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	KUNIT_ASSERT_NOT_NULL(test, next);
+	KUNIT_ASSERT_NOT_NULL(test, dst);
+	mc16_sct_pattern(src, f->nr, false);
+	for (i = 0; i < f->nr * PAGE_SIZE; i++)
+		next[i] = src[i] ^ 0x73;
+	mc16_sct_copy(f, src);
+	pending = atomic64_read(&memcomp_pending_pages);
+	pins = atomic_read(&f->anon_vma->refcount);
+	KUNIT_ASSERT_TRUE(test, mc16_sct_reserve(f));
+	KUNIT_ASSERT_EQ(test, mc16_flt_hold(f), 0);
+	for (i = 0; i < f->nr; i++) {
+		old_tokens[i] = f->guards[i].token;
+		KUNIT_ASSERT_EQ(test, mc16_flt_escape(f, i), 0);
+	}
+	stats = mc16_sct_stats_read();
+	mc16_sct_run(f, (struct mc16_sct_attempt) { }, true);
+	mc16_sct_stats_expect(test, stats, (struct mc16_sct_stats) {
+		.bg_ok = f->nr,
+	});
+	KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_pending_pages), pending);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->anon_vma->refcount), pins);
+	for (i = 0; i < f->nr; i++) {
+		old = mc16_rct_member(&f->guards[i]);
+		KUNIT_ASSERT_TRUE(test, old.valid);
+		KUNIT_ASSERT_EQ(test, mc16_flags_state(old.flags), MC16_STORED);
+		/* Remove actual old PTE ownership, retaining OWNER + guard. */
+		KUNIT_ASSERT_EQ(test, mc16_flt_zap(f, f->addr + i * PAGE_SIZE), 0);
+		KUNIT_EXPECT_EQ(test, refcount_read(&f->guards[i].slot->refs), 2U);
+	}
+	KUNIT_ASSERT_TRUE(test, mc16_sct_reserve(f));
+	token = swp_offset(f->folio->swap);
+	KUNIT_EXPECT_NE(test, token, old_tokens[0]);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(f->folio), 1 + f->nr);
+	KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_pending_pages),
+			pending + f->nr);
+	/* The unmapped source takes no new folio_get_anon_vma() pin. */
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->anon_vma->refcount), pins);
+	for (i = 0; i < f->nr; i++) {
+		old = mc16_rct_member(&f->guards[i]);
+		fresh = mc16_rct_lookup(token + i);
+		KUNIT_EXPECT_TRUE(test, old.valid);
+		KUNIT_EXPECT_EQ(test, mc16_flags_state(old.flags), MC16_STORED);
+		KUNIT_EXPECT_FALSE(test, old.flags & MC16_F_OWNER);
+		KUNIT_EXPECT_EQ(test, old.refs, 1U);
+		KUNIT_EXPECT_TRUE(test, memcomp_entry_present(old_tokens[i]));
+		KUNIT_EXPECT_TRUE(test, fresh.valid);
+		KUNIT_EXPECT_EQ(test, mc16_flags_state(fresh.flags), MC16_PENDING);
+		KUNIT_EXPECT_TRUE(test, fresh.flags & MC16_F_OWNER);
+		KUNIT_EXPECT_TRUE(test, fresh.flags & MC16_F_RESIDENT);
+		KUNIT_EXPECT_FALSE(test, fresh.flags & MC16_F_REFRESH_PENDING);
+		KUNIT_EXPECT_EQ(test, fresh.refs, 1U);
+		mc16_sct_expect_load(f, i, src + i * PAGE_SIZE, dst);
+	}
+	/* New stores change bytes without touching the guard-held old payloads. */
+	mc16_sct_copy(f, next);
+	stats = mc16_sct_stats_read();
+	mc16_sct_run(f, (struct mc16_sct_attempt) { }, true);
+	mc16_sct_stats_expect(test, stats, (struct mc16_sct_stats) {
+		.bg_ok = f->nr,
+	});
+	KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_pending_pages), pending);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->anon_vma->refcount), pins);
+	/* A fresh span without PTE owners needs guards across real source exit. */
+	for (i = 0; i < f->nr; i++)
+		KUNIT_ASSERT_TRUE(test, memcomp_entry_get_ref(token + i,
+							      &new_guards[i]));
+	KUNIT_ASSERT_TRUE(test, mc16_sct_release(f));
+	for (i = 0; i < f->nr; i++) {
+		mc16_sct_expect_load(f, i, src + i * PAGE_SIZE, dst);
+		mc16_rct_load(f, token + i, next + i * PAGE_SIZE, dst);
+		memcomp_entry_put_ref(&f->guards[i]);
+		KUNIT_EXPECT_FALSE(test, memcomp_entry_present(old_tokens[i]));
+		KUNIT_EXPECT_TRUE(test, memcomp_entry_present(token + i));
+	}
+	for (i = 0; i < f->nr; i++)
+		memcomp_entry_put_ref(&new_guards[i]);
+	for (i = 0; i < f->nr; i++)
+		KUNIT_EXPECT_FALSE(test, memcomp_entry_present(token + i));
+	KUNIT_EXPECT_EQ(test, folio_ref_count(f->folio), 1);
+	KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_pending_pages), pending);
+}
+
+static void memcomp_test_replacement_stored_order0(struct kunit *test)
+{
+	mc16_rct_replace(test, 0);
+}
+
+static void memcomp_test_replacement_stored_order1(struct kunit *test)
+{
+	mc16_rct_replace(test, 1);
+}
+#endif /* MC16_STORE_TRANSACTION_TEST_ENABLED */
+#endif /* _MM_MEMCOMP_TESTS_REPLACEMENT_TEST_H */
diff --git a/mm/memcomp/tests/resident_test.h b/mm/memcomp/tests/resident_test.h
new file mode 100644
index 0000000..3a9e45e
--- /dev/null
+++ b/mm/memcomp/tests/resident_test.h
@@ -0,0 +1,796 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_RESIDENT_TEST_H
+#define _MM_MEMCOMP_TESTS_RESIDENT_TEST_H
+
+#include <kunit/resource.h>
+#include <kunit/static_stub.h>
+#include <linux/completion.h>
+#include <linux/kthread.h>
+#include <linux/mman.h>
+#include <linux/sched/mm.h>
+#include <linux/sched/task.h>
+#include "../resident.h"
+
+/* Include after consumers_test.h. Real MM/folio/rmap, modeled metadata objcg. */
+#if defined(CONFIG_MEMCG) && defined(CONFIG_ADVISE_SYSCALLS)
+#define MC16_RESIDENT_TEST_ENABLED
+enum mc16_rl_race {
+	MC16_RL_NONE,
+	MC16_RL_STORED,
+	MC16_RL_FOLIO,
+	MC16_RL_RESIDENT,
+};
+
+struct mc16_rl {
+	struct mc16_consumer_test *base;
+	struct mm_struct *mm;
+	unsigned long addr;
+	struct folio *folio, *other;
+	struct memcomp_ref owners[2], guard;
+	unsigned int nr, target;
+	struct anon_vma *anon_vma; /* Borrowed from the producer's record hold. */
+	vm_flags_t saved_flags;
+	pgprot_t saved_prot;
+	bool saved_vma;
+	pte_t orig;
+	s64 swapents, anonpages;
+	enum mc16_rl_race race;
+	int hook_error, lookup;
+	bool switched, cleared, handled;
+	unsigned int fault_flags;
+	pte_t *fault_pte;
+	struct task_struct *worker;
+	struct completion locked, go;
+};
+
+static struct mc16_rl *mc16_rl_current;
+
+static s64 mc16_rl_rss(struct mc16_rl *f, int member)
+{
+	return percpu_counter_sum(&f->mm->rss_stat[member]);
+}
+
+/* The PTE owns one existing slot ref; removing it requires no new lookup. */
+static void mc16_rl_zap_token(struct mc16_rl *f)
+{
+	struct memcomp_ref removed;
+	spinlock_t *ptl; /* Serializes the real PTE and its owner reference. */
+	pte_t *ptep, pte;
+	pmd_t *pmd;
+
+	if (!f->owners[f->target].slot)
+		return;
+	mmap_read_lock(f->mm);
+	pmd = mm_find_pmd(f->mm, f->addr);
+	if (!pmd)
+		goto out;
+	ptep = pte_offset_map_lock(f->mm, pmd, f->addr, &ptl);
+	if (!ptep)
+		goto out;
+	pte = ptep_get(ptep);
+	if (is_swap_pte(pte) && is_memcomp_entry(pte_to_swp_entry(pte)) &&
+	    swp_offset(pte_to_swp_entry(pte)) == f->owners[f->target].token) {
+		ptep_get_and_clear(f->mm, f->addr, ptep);
+		add_mm_counter(f->mm, MM_SWAPENTS, -1);
+		removed = f->owners[f->target];
+		mc16_ref_put(&removed);
+	}
+	pte_unmap_unlock(ptep, ptl);
+out:
+	mmap_read_unlock(f->mm);
+}
+
+/* Undo only deliberately injected invalid identity/flags before final puts. */
+static void mc16_rl_restore_race(struct mc16_rl *f)
+{
+	struct mc16_view view;
+
+	if (!f->switched && !f->cleared)
+		return;
+	folio_lock(f->folio);
+	mutex_lock(memcomp_lock_of(f->owners[f->target].token));
+	if (mc16_view_locked(&f->owners[f->target], &view)) {
+		if (f->switched) {
+			folio_get(f->folio);
+			view.member->owner_folio = f->folio;
+			folio_put(f->other);
+		}
+		if (f->cleared)
+			*view.flags |= MC16_F_RESIDENT;
+	}
+	mutex_unlock(memcomp_lock_of(f->owners[f->target].token));
+	folio_unlock(f->folio);
+	f->switched = false;
+	f->cleared = false;
+}
+
+static void mc16_rl_join(struct mc16_rl *f)
+{
+	if (f->worker) {
+		complete_all(&f->go);
+		kthread_stop_put(f->worker);
+		f->worker = NULL;
+	}
+}
+
+static void mc16_rl_cleanup(void *data)
+{
+	struct mc16_rl *f = data;
+	struct vm_area_struct *vma;
+	struct anon_vma *anon_vma = NULL;
+	unsigned int i;
+	int ret;
+
+	mc16_rl_join(f);
+	mc16_rl_current = NULL;
+	mc16_rl_restore_race(f);
+	if (f->guard.slot)
+		mc16_ref_put(&f->guard);
+	mc16_rl_zap_token(f);
+	if (f->nr) {
+		folio_lock(f->folio);
+		mutex_lock(memcomp_lock_of(f->owners[0].token));
+		anon_vma = mc16_span_take_anon_vma_locked(&f->owners[0],
+							  f->folio, f->nr);
+		mutex_unlock(memcomp_lock_of(f->owners[0].token));
+		/* Producer siblings leave first; head/anon_vma bookkeeping last. */
+		for (i = f->nr; i > 0; i--)
+			mc16_ref_put(&f->owners[i - 1]);
+		folio_unlock(f->folio);
+	}
+	KUNIT_EXPECT_PTR_EQ(f->base->test, anon_vma, f->anon_vma);
+	if (anon_vma)
+		put_anon_vma(anon_vma);
+	f->anon_vma = NULL;
+	mmap_write_lock(f->mm);
+	vma = vma_lookup(f->mm, f->addr);
+	if (vma && f->saved_vma) {
+		vma_start_write(vma);
+		vm_flags_reset(vma, f->saved_flags);
+		vma->vm_page_prot = f->saved_prot;
+	}
+	mmap_write_unlock(f->mm);
+	ret = mc16_test_dontneed(f->mm, f->addr, PAGE_SIZE);
+	KUNIT_EXPECT_EQ(f->base->test, ret, 0);
+	KUNIT_EXPECT_EQ(f->base->test, mc16_rl_rss(f, MM_SWAPENTS), f->swapents);
+	KUNIT_EXPECT_EQ(f->base->test, mc16_rl_rss(f, MM_ANONPAGES), f->anonpages);
+	if (f->folio) {
+		KUNIT_EXPECT_FALSE(f->base->test, folio_test_locked(f->folio));
+		KUNIT_EXPECT_EQ(f->base->test, folio_mapcount(f->folio), 0);
+		folio_put(f->folio);
+	}
+	if (f->other)
+		folio_put(f->other);
+	f->base->model.folio = f->base->account;
+	mmput(f->mm);
+}
+
+static int mc16_rl_reserve(struct mc16_rl *f, unsigned int nr)
+{
+	struct mc16_record *record;
+	struct anon_vma *anon_vma;
+	unsigned int i;
+	int ret;
+
+	folio_lock(f->folio);
+	record = mc16_record_alloc(f->folio, nr, false);
+	if (IS_ERR(record)) {
+		ret = PTR_ERR(record);
+		goto unlock;
+	}
+	anon_vma = folio_get_anon_vma(f->folio);
+	if (!anon_vma) {
+		mc16_record_abort(record);
+		ret = -EINVAL;
+		goto unlock;
+	}
+	record->anon_vma = anon_vma;
+	record->record_flags |= MC16_RECORD_ANON_VMA;
+	ret = mc16_reserve(record, nr, MC16_KEY_ANON, f->owners);
+	if (ret) {
+		record->anon_vma = NULL;
+		record->record_flags &= ~MC16_RECORD_ANON_VMA;
+		mc16_record_abort(record);
+		put_anon_vma(anon_vma);
+		goto unlock;
+	}
+	f->nr = nr;
+	f->anon_vma = anon_vma;
+	for (i = 0; i < nr; i++)
+		mc16_account_reservation(&f->owners[i]);
+unlock:
+	folio_unlock(f->folio);
+	return ret;
+}
+
+/* Replace an actual anonymous PTE, retaining the folio's existing anon rmap. */
+static int mc16_rl_install(struct mc16_rl *f)
+{
+	struct vm_area_struct *vma;
+	struct memcomp_ref pte_ref;
+	spinlock_t *ptl; /* Serializes the real PTE and its owner reference. */
+	pte_t *ptep, old;
+	void *data;
+	int ret = -EINVAL;
+
+	mmap_read_lock(f->mm);
+	vma = vma_lookup(f->mm, f->addr);
+	if (!vma)
+		goto out;
+	folio_lock(f->folio);
+	data = kmap_local_folio(f->folio, 0);
+	memset(data, 0x6b, PAGE_SIZE);
+	kunmap_local(data);
+	flush_dcache_folio(f->folio);
+	ptep = get_locked_pte(f->mm, f->addr, &ptl);
+	if (!ptep) {
+		ret = -ENOMEM;
+		goto unlock_folio;
+	}
+	__acquire(RCU);
+	old = ptep_get(ptep);
+	if (!pte_present(old) || pte_page(old) != &f->folio->page ||
+	    !mc16_get(f->owners[f->target].token, &pte_ref))
+		goto unlock_pte;
+	ptep_clear_flush(vma, f->addr, ptep);
+	folio_remove_rmap_pte(f->folio, &f->folio->page, vma);
+	add_mm_counter(f->mm, MM_ANONPAGES, -1);
+	add_mm_counter(f->mm, MM_SWAPENTS, 1);
+	set_pte_at(f->mm, f->addr, ptep, f->orig);
+	/* The get is now the token PTE's; the old mapping drops its folio ref. */
+	folio_put(f->folio);
+	ret = 0;
+unlock_pte:
+	pte_unmap_unlock(ptep, ptl);
+unlock_folio:
+	folio_unlock(f->folio);
+out:
+	mmap_read_unlock(f->mm);
+	return ret;
+}
+
+static struct mc16_rl *mc16_rl_begin(struct kunit *test, unsigned int nr,
+				     unsigned int target)
+{
+	struct mc16_rl *f;
+	struct vm_area_struct *vma;
+	spinlock_t *ptl; /* Serializes the real PTE and its owner reference. */
+	pte_t *ptep, pte;
+	vm_fault_t fault;
+	int ret;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->base = mc16_consumer_test_begin(test);
+	if (!f->base)
+		return NULL;
+	f->addr = kunit_vm_mmap(test, NULL, 0, PAGE_SIZE,
+				PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, 0);
+	if (!f->addr || IS_ERR_VALUE(f->addr))
+		return NULL;
+	f->mm = current->mm;
+	mmget(f->mm);
+	f->target = target;
+	f->swapents = mc16_rl_rss(f, MM_SWAPENTS);
+	f->anonpages = mc16_rl_rss(f, MM_ANONPAGES);
+	init_completion(&f->locked);
+	init_completion(&f->go);
+	if (kunit_add_action_or_reset(test, mc16_rl_cleanup, f))
+		return NULL;
+	f->other = folio_alloc(GFP_KERNEL, 0);
+	if (!f->other)
+		return NULL;
+	mmap_write_lock(f->mm);
+	vma = vma_lookup(f->mm, f->addr);
+	if (vma) {
+		f->saved_flags = vma->vm_flags;
+		f->saved_prot = vma->vm_page_prot;
+		f->saved_vma = true;
+		vma_start_write(vma);
+		vm_flags_set(vma, VM_NOHUGEPAGE);
+	}
+	mmap_write_unlock(f->mm);
+	if (!vma)
+		return NULL;
+	mmap_read_lock(f->mm);
+	vma = vma_lookup(f->mm, f->addr);
+	if (!vma) {
+		ret = -ENOENT;
+		goto out;
+	}
+	fault = handle_mm_fault(vma, f->addr, FAULT_FLAG_WRITE, NULL);
+	ret = fault & VM_FAULT_ERROR ? -EFAULT : -ENOMEM;
+	if (fault & VM_FAULT_ERROR)
+		goto out;
+	ptep = get_locked_pte(f->mm, f->addr, &ptl);
+	if (!ptep)
+		goto out;
+	__acquire(RCU);
+	pte = ptep_get(ptep);
+	if (pte_present(pte) && !pte_special(pte)) {
+		f->folio = page_folio(pte_page(pte));
+		folio_get(f->folio);
+		ret = folio_test_large(f->folio) ? -EINVAL : 0;
+	}
+	pte_unmap_unlock(ptep, ptl);
+out:
+	mmap_read_unlock(f->mm);
+	if (ret)
+		return NULL;
+	f->base->model.folio = f->folio;
+	if (mc16_rl_reserve(f, nr))
+		return NULL;
+	f->orig = swp_entry_to_pte(make_memcomp_entry(f->owners[target].token));
+	f->orig = pte_swp_mkexclusive(f->orig);
+	if (mc16_rl_install(f))
+		return NULL;
+	/* Remove pagevec's temporary folio ref before ownership assertions. */
+	lru_add_drain_all();
+	return f;
+}
+
+static pte_t mc16_rl_read(struct mc16_rl *f)
+{
+	spinlock_t *ptl; /* Serializes the real PTE and its owner reference. */
+	pte_t *ptep, pte = __pte(0);
+	pmd_t *pmd;
+
+	mmap_read_lock(f->mm);
+	pmd = mm_find_pmd(f->mm, f->addr);
+	if (pmd) {
+		ptep = pte_offset_map_lock(f->mm, pmd, f->addr, &ptl);
+		if (ptep) {
+			pte = ptep_get(ptep);
+			pte_unmap_unlock(ptep, ptl);
+		}
+	}
+	mmap_read_unlock(f->mm);
+	return pte;
+}
+
+static int mc16_rl_change_pte(struct mc16_rl *f, pte_t pte)
+{
+	spinlock_t *ptl; /* Serializes the real PTE and its owner reference. */
+	pte_t *ptep;
+	int ret = 0;
+
+	mmap_read_lock(f->mm);
+	ptep = get_locked_pte(f->mm, f->addr, &ptl);
+	if (!ptep) {
+		ret = -ENOMEM;
+	} else {
+		__acquire(RCU);
+		if (!pte_same(ptep_get(ptep), f->orig))
+			ret = -ESTALE;
+		else
+			set_pte_at(f->mm, f->addr, ptep, pte);
+		pte_unmap_unlock(ptep, ptl);
+	}
+	mmap_read_unlock(f->mm);
+	return ret;
+}
+
+static void mc16_rl_policy(struct mc16_rl *f, vm_flags_t set, vm_flags_t clear)
+{
+	struct vm_area_struct *vma;
+
+	mmap_write_lock(f->mm);
+	vma = vma_lookup(f->mm, f->addr);
+	if (vma) {
+		vma_start_write(vma);
+		vm_flags_reset(vma, (vma->vm_flags | set) & ~clear);
+		vma->vm_page_prot = vm_get_page_prot(vma->vm_flags);
+	}
+	mmap_write_unlock(f->mm);
+	KUNIT_EXPECT_NOT_NULL(f->base->test, vma);
+}
+
+/* A genuine producer commit removes RESIDENT and its folio hold. */
+static int mc16_rl_store(struct mc16_rl *f)
+{
+	struct mc16_payload payload = { .word = 0x123456789abcdef0ULL };
+	struct mc16_payload_tail tail = { };
+	struct memcomp_ref *ref = &f->owners[0];
+	int ret;
+
+	folio_lock(f->folio);
+	mutex_lock(memcomp_lock_of(ref->token));
+	ret = mc16_payload_commit_locked(ref, f->folio, 1, 0, &payload, &tail);
+	mutex_unlock(memcomp_lock_of(ref->token));
+	if (!ret)
+		mc16_payload_finish(ref, &tail);
+	folio_unlock(f->folio);
+	return ret;
+}
+
+static vm_fault_t mc16_rl_lock(struct folio *folio, struct vm_fault *vmf)
+{
+	struct mc16_rl *f = mc16_rl_current;
+	struct memcomp_ref *ref = &f->owners[f->target];
+	struct mc16_view view;
+
+	if (f->race == MC16_RL_STORED) {
+		f->hook_error = mc16_rl_store(f);
+	} else {
+		folio_lock(folio);
+		mutex_lock(memcomp_lock_of(ref->token));
+		if (!mc16_view_locked(ref, &view)) {
+			f->hook_error = -EIO;
+		} else if (f->race == MC16_RL_FOLIO) {
+			folio_get(f->other);
+			view.member->owner_folio = f->other;
+			folio_put(folio);
+			f->switched = true;
+		} else if (f->race == MC16_RL_RESIDENT) {
+			*view.flags &= ~MC16_F_RESIDENT;
+			f->cleared = true;
+		}
+		mutex_unlock(memcomp_lock_of(ref->token));
+		folio_unlock(folio);
+	}
+	return folio_lock_or_retry(folio, vmf);
+}
+
+/* No fatal assertions, resource allocations or returned locks in this helper. */
+static vm_fault_t mc16_rl_fault(struct mc16_rl *f, unsigned int flags,
+				bool hold_folio)
+{
+	struct vm_area_struct *vma;
+	vm_fault_t ret = VM_FAULT_SIGBUS;
+
+	f->lookup = mc16_entry_resident_get(f->owners[f->target].token, &f->guard);
+	if (f->lookup < 0 || !f->guard.slot)
+		return ret;
+	if (f->race != MC16_RL_NONE) {
+		mc16_rl_current = f;
+		kunit_activate_static_stub(f->base->test, mc16_resident_lock_or_retry,
+					   mc16_rl_lock);
+	}
+	mmap_read_lock(f->mm);
+	vma = vma_lookup(f->mm, f->addr);
+	if (!vma)
+		goto unlock_mm;
+	if (hold_folio)
+		folio_lock(f->folio);
+	if (f->worker)
+		complete(&f->go);
+	{
+		struct vm_fault vmf = {
+			.vma = vma, .address = f->addr, .real_address = f->addr,
+			.flags = flags | FAULT_FLAG_ORIG_PTE_VALID,
+			.pmd = mm_find_pmd(f->mm, f->addr), .orig_pte = f->orig,
+			.gfp_mask = GFP_HIGHUSER_MOVABLE,
+		};
+
+		ret = mc16_load_resident(&vmf, &f->guard, &f->handled);
+		f->fault_pte = vmf.pte;
+		f->fault_flags = vmf.flags;
+	}
+	if (hold_folio)
+		folio_unlock(f->folio);
+	/* NOWAIT retains the read lock; ordinary first RETRY has dropped it. */
+	if ((ret & VM_FAULT_RETRY) && !(flags & FAULT_FLAG_RETRY_NOWAIT))
+		goto unlocked_mm;
+unlock_mm:
+	mmap_read_unlock(f->mm);
+unlocked_mm:
+	if (f->race != MC16_RL_NONE) {
+		kunit_deactivate_static_stub(f->base->test, mc16_resident_lock_or_retry);
+		mc16_rl_current = NULL;
+	}
+	mc16_rl_join(f);
+	mc16_rl_restore_race(f);
+	return ret;
+}
+
+static void mc16_rl_counts(struct mc16_rl *f, unsigned int ptes,
+			   unsigned int present, unsigned int refs)
+{
+	struct mc16_view view;
+	bool owner = false, anon = false;
+
+	KUNIT_EXPECT_EQ(f->base->test, mc16_rl_rss(f, MM_SWAPENTS), f->swapents + ptes);
+	KUNIT_EXPECT_EQ(f->base->test, mc16_rl_rss(f, MM_ANONPAGES), f->anonpages + present);
+	KUNIT_EXPECT_EQ(f->base->test, refcount_read(&f->owners[f->target].slot->refs),
+			refs);
+	KUNIT_EXPECT_EQ(f->base->test, folio_mapcount(f->folio), (int)present);
+	KUNIT_EXPECT_FALSE(f->base->test, folio_test_locked(f->folio));
+	KUNIT_EXPECT_PTR_EQ(f->base->test, f->fault_pte, NULL);
+	mutex_lock(memcomp_lock_of(f->owners[0].token));
+	if (mc16_view_locked(&f->owners[0], &view)) {
+		owner = *view.flags & MC16_F_OWNER;
+		anon = view.record && view.record->anon_vma == f->anon_vma &&
+			(view.record->record_flags & MC16_RECORD_ANON_VMA);
+	}
+	mutex_unlock(memcomp_lock_of(f->owners[0].token));
+	KUNIT_EXPECT_TRUE(f->base->test, owner);
+	KUNIT_EXPECT_TRUE(f->base->test, anon);
+}
+
+static void mc16_rl_present(struct mc16_rl *f, bool write, bool dirty)
+{
+	pte_t pte = mc16_rl_read(f);
+	void *data;
+	bool same;
+
+	KUNIT_ASSERT_TRUE(f->base->test, pte_present(pte));
+	KUNIT_EXPECT_PTR_EQ(f->base->test, pte_page(pte), &f->folio->page);
+	KUNIT_EXPECT_EQ(f->base->test, !!pte_write(pte), write);
+	if (dirty)
+		KUNIT_EXPECT_TRUE(f->base->test, pte_dirty(pte));
+	else if (!write)
+		KUNIT_EXPECT_FALSE(f->base->test, pte_dirty(pte));
+	KUNIT_EXPECT_TRUE(f->base->test, folio_test_anon(f->folio));
+	KUNIT_EXPECT_TRUE(f->base->test, folio_test_swapbacked(f->folio));
+	KUNIT_EXPECT_TRUE(f->base->test, folio_test_uptodate(f->folio));
+	data = kmap_local_folio(f->folio, 0);
+	same = !memchr_inv(data, 0x6b, PAGE_SIZE);
+	kunmap_local(data);
+	KUNIT_EXPECT_TRUE(f->base->test, same);
+	mc16_rl_counts(f, 0, 1, 1);
+}
+
+static void memcomp_test_resident_write(struct kunit *test)
+{
+	struct mc16_rl *f = mc16_rl_begin(test, 1, 0);
+	pte_t orig;
+	vm_fault_t ret;
+	int refs;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	refs = folio_ref_count(f->folio);
+	orig = pte_swp_mksoft_dirty(f->orig);
+	KUNIT_ASSERT_EQ(test, mc16_rl_change_pte(f, orig), 0);
+	f->orig = orig;
+	ret = mc16_rl_fault(f, FAULT_FLAG_WRITE, false);
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)ret,
+			(__force unsigned int)VM_FAULT_NOPAGE);
+	KUNIT_EXPECT_TRUE(test, f->handled);
+	KUNIT_EXPECT_NULL(test, f->guard.slot);
+	KUNIT_EXPECT_FALSE(test, f->fault_flags & FAULT_FLAG_WRITE);
+	mc16_rl_present(f, true, true);
+	KUNIT_EXPECT_EQ(test, !!pte_soft_dirty(mc16_rl_read(f)), !!pte_swp_soft_dirty(orig));
+	KUNIT_EXPECT_TRUE(test, PageAnonExclusive(&f->folio->page));
+	KUNIT_EXPECT_EQ(test, folio_ref_count(f->folio), refs + 1);
+	/* The still-resident producer cannot make a stale second fault win. */
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)mc16_rl_fault(f, 0, false), 0U);
+	KUNIT_EXPECT_TRUE(test, f->handled);
+	KUNIT_EXPECT_NULL(test, f->guard.slot);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(f->folio), refs + 1);
+	mc16_rl_counts(f, 0, 1, 1);
+}
+
+static void memcomp_test_resident_readonly(struct kunit *test)
+{
+	struct mc16_rl *f = mc16_rl_begin(test, 1, 0);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	mc16_rl_policy(f, 0, VM_WRITE);
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)mc16_rl_fault(f, 0, false),
+			(__force unsigned int)VM_FAULT_NOPAGE);
+	KUNIT_EXPECT_TRUE(test, f->handled);
+	KUNIT_EXPECT_NULL(test, f->guard.slot);
+	mc16_rl_present(f, false, false);
+}
+
+static void memcomp_test_resident_shared(struct kunit *test)
+{
+	struct mc16_rl *f = mc16_rl_begin(test, 1, 0);
+	pte_t orig;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	orig = pte_swp_clear_exclusive(f->orig);
+	KUNIT_ASSERT_EQ(test, mc16_rl_change_pte(f, orig), 0);
+	f->orig = orig;
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)mc16_rl_fault(f, FAULT_FLAG_WRITE, false),
+			(__force unsigned int)VM_FAULT_NOPAGE);
+	KUNIT_EXPECT_TRUE(test, f->fault_flags & FAULT_FLAG_WRITE);
+	mc16_rl_present(f, false, false);
+}
+
+static void memcomp_test_resident_softdirty_wp(struct kunit *test)
+{
+	struct mc16_rl *f;
+
+	if (!IS_ENABLED(CONFIG_MEM_SOFT_DIRTY)) {
+		kunit_skip(test, "soft-dirty tracking is disabled");
+		return;
+	}
+	f = mc16_rl_begin(test, 1, 0);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	mc16_rl_policy(f, 0, VM_SOFTDIRTY);
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)mc16_rl_fault(f, 0, false),
+			(__force unsigned int)VM_FAULT_NOPAGE);
+	mc16_rl_present(f, false, false);
+	KUNIT_EXPECT_FALSE(test, pte_soft_dirty(mc16_rl_read(f)));
+}
+
+static void memcomp_test_resident_uffd_wp(struct kunit *test)
+{
+	struct mc16_rl *f;
+	pte_t orig = pte_swp_mkuffd_wp(swp_entry_to_pte(make_memcomp_entry(1)));
+
+	if (!IS_ENABLED(CONFIG_USERFAULTFD) || !pte_swp_uffd_wp(orig)) {
+		kunit_skip(test, "architecture has no enabled swap UFFD-WP bit");
+		return;
+	}
+	f = mc16_rl_begin(test, 1, 0);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	mc16_rl_policy(f, VM_UFFD_WP, 0);
+	orig = pte_swp_mkuffd_wp(f->orig);
+	KUNIT_ASSERT_EQ(test, mc16_rl_change_pte(f, orig), 0);
+	f->orig = orig;
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)mc16_rl_fault(f, 0, false),
+			(__force unsigned int)VM_FAULT_NOPAGE);
+	mc16_rl_present(f, false, false);
+	KUNIT_EXPECT_TRUE(test, pte_uffd_wp(mc16_rl_read(f)));
+}
+
+static void memcomp_test_resident_changed_pte(struct kunit *test)
+{
+	struct mc16_rl *f = mc16_rl_begin(test, 1, 0);
+	pte_t changed;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	changed = pte_swp_mksoft_dirty(f->orig);
+	if (pte_same(changed, f->orig))
+		changed = pte_swp_clear_exclusive(f->orig);
+	KUNIT_ASSERT_FALSE(test, pte_same(changed, f->orig));
+	KUNIT_ASSERT_EQ(test, mc16_rl_change_pte(f, changed), 0);
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)mc16_rl_fault(f, 0, false), 0U);
+	KUNIT_EXPECT_TRUE(test, f->handled);
+	KUNIT_EXPECT_NULL(test, f->guard.slot);
+	KUNIT_EXPECT_TRUE(test, pte_same(mc16_rl_read(f), changed));
+	mc16_rl_counts(f, 1, 0, 2);
+}
+
+static void memcomp_test_resident_zapped(struct kunit *test)
+{
+	struct mc16_rl *f = mc16_rl_begin(test, 1, 0);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	mc16_rl_zap_token(f);
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)mc16_rl_fault(f, 0, false), 0U);
+	KUNIT_EXPECT_TRUE(test, f->handled);
+	KUNIT_EXPECT_NULL(test, f->guard.slot);
+	KUNIT_EXPECT_TRUE(test, pte_none(mc16_rl_read(f)));
+	mc16_rl_counts(f, 0, 0, 1);
+}
+
+static void memcomp_test_resident_unhandled(struct kunit *test)
+{
+	struct mc16_rl *f = mc16_rl_begin(test, 1, 0);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_EQ(test, mc16_rl_store(f), 0);
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)mc16_rl_fault(f, 0, false), 0U);
+	KUNIT_EXPECT_EQ(test, f->lookup, 0);
+	KUNIT_EXPECT_FALSE(test, f->handled);
+	KUNIT_EXPECT_NOT_NULL(test, f->guard.slot);
+	mc16_rl_counts(f, 1, 0, 3);
+	mc16_ref_put(&f->guard);
+}
+
+static void mc16_rl_race_case(struct kunit *test, enum mc16_rl_race race)
+{
+	struct mc16_rl *f = mc16_rl_begin(test, 1, 0);
+	int refs;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	refs = folio_ref_count(f->folio);
+	f->race = race;
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)mc16_rl_fault(f, 0, false), 0U);
+	KUNIT_EXPECT_EQ(test, f->hook_error, 0);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(f->folio), refs - (race == MC16_RL_STORED));
+	KUNIT_EXPECT_TRUE(test, f->handled);
+	KUNIT_EXPECT_NULL(test, f->guard.slot);
+	KUNIT_EXPECT_TRUE(test, pte_same(mc16_rl_read(f), f->orig));
+	mc16_rl_counts(f, 1, 0, 2);
+}
+
+static void memcomp_test_resident_state_race(struct kunit *test)
+{
+	mc16_rl_race_case(test, MC16_RL_STORED);
+}
+
+static void memcomp_test_resident_folio_race(struct kunit *test)
+{
+	mc16_rl_race_case(test, MC16_RL_FOLIO);
+}
+
+static void memcomp_test_resident_flag_race(struct kunit *test)
+{
+	mc16_rl_race_case(test, MC16_RL_RESIDENT);
+}
+
+static void memcomp_test_resident_bad_index(struct kunit *test)
+{
+	/* A real two-member record on an order-0 folio models corrupt geometry. */
+	struct mc16_rl *f = mc16_rl_begin(test, 2, 1);
+	pte_t changed;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)mc16_rl_fault(f, 0, false),
+			(__force unsigned int)VM_FAULT_SIGBUS);
+	KUNIT_EXPECT_TRUE(test, f->handled);
+	KUNIT_EXPECT_NULL(test, f->guard.slot);
+	KUNIT_EXPECT_TRUE(test, pte_same(mc16_rl_read(f), f->orig));
+	mc16_rl_counts(f, 1, 0, 2);
+	/* Corruption must not SIGBUS a PTE that has already changed identity. */
+	changed = pte_swp_clear_exclusive(f->orig);
+	KUNIT_ASSERT_EQ(test, mc16_rl_change_pte(f, changed), 0);
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)mc16_rl_fault(f, 0, false), 0U);
+	KUNIT_EXPECT_TRUE(test, f->handled);
+	KUNIT_EXPECT_NULL(test, f->guard.slot);
+	KUNIT_EXPECT_TRUE(test, pte_same(mc16_rl_read(f), changed));
+	mc16_rl_counts(f, 1, 0, 2);
+}
+
+static void memcomp_test_resident_retry_nowait(struct kunit *test)
+{
+	struct mc16_rl *f = mc16_rl_begin(test, 1, 0);
+	vm_fault_t ret;
+	int refs;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	refs = folio_ref_count(f->folio);
+	ret = mc16_rl_fault(f, FAULT_FLAG_ALLOW_RETRY | FAULT_FLAG_RETRY_NOWAIT, true);
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)ret,
+			(__force unsigned int)VM_FAULT_RETRY);
+	KUNIT_EXPECT_TRUE(test, f->handled);
+	KUNIT_EXPECT_NULL(test, f->guard.slot);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(f->folio), refs);
+	KUNIT_EXPECT_TRUE(test, pte_same(mc16_rl_read(f), f->orig));
+	mc16_rl_counts(f, 1, 0, 2);
+}
+
+static int mc16_rl_retry_writer(void *data)
+{
+	struct mc16_rl *f = data;
+
+	folio_lock(f->folio);
+	complete(&f->locked);
+	wait_for_completion(&f->go);
+	/* The ordinary retry must drop mmap_read_lock before waiting on us. */
+	mmap_write_lock(f->mm);
+	folio_unlock(f->folio);
+	mmap_write_unlock(f->mm);
+	return 0;
+}
+
+static void memcomp_test_resident_retry(struct kunit *test)
+{
+	struct mc16_rl *f = mc16_rl_begin(test, 1, 0);
+	unsigned long ready;
+	vm_fault_t ret;
+	int refs;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	refs = folio_ref_count(f->folio);
+	f->worker = kthread_run(mc16_rl_retry_writer, f, "mc16-resident-retry");
+	if (IS_ERR(f->worker)) {
+		f->worker = NULL;
+		KUNIT_FAIL(test, "could not start resident writer");
+		return;
+	}
+	get_task_struct(f->worker);
+	ready = wait_for_completion_timeout(&f->locked, msecs_to_jiffies(5000));
+	if (!ready) {
+		mc16_rl_join(f);
+		KUNIT_FAIL(test, "resident writer did not lock folio");
+		return;
+	}
+	ret = mc16_rl_fault(f, FAULT_FLAG_ALLOW_RETRY, false);
+	/* No test thread owns another task's folio or mmap lock on assertion. */
+	mc16_rl_join(f);
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)ret,
+			(__force unsigned int)VM_FAULT_RETRY);
+	KUNIT_EXPECT_TRUE(test, f->handled);
+	KUNIT_EXPECT_NULL(test, f->guard.slot);
+	KUNIT_EXPECT_EQ(test, folio_ref_count(f->folio), refs);
+	KUNIT_EXPECT_TRUE(test, pte_same(mc16_rl_read(f), f->orig));
+	mc16_rl_counts(f, 1, 0, 2);
+}
+#endif /* CONFIG_MEMCG && CONFIG_ADVISE_SYSCALLS */
+#endif /* _MM_MEMCOMP_TESTS_RESIDENT_TEST_H */
diff --git a/mm/memcomp/tests/rollback_test.h b/mm/memcomp/tests/rollback_test.h
new file mode 100644
index 0000000..f74c5a0
--- /dev/null
+++ b/mm/memcomp/tests/rollback_test.h
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_ROLLBACK_TEST_H
+#define _MM_MEMCOMP_TESTS_ROLLBACK_TEST_H
+
+/* Real VM/PTE fixture; only allocation ownership uses the existing objcg model. */
+#if defined(MC16_FOLIO_TEST_ENABLED) && defined(CONFIG_MEMCOMP_DEBUG_STATS)
+#define MC16_ROLLBACK_TEST_ENABLED
+
+struct mc16_rb_counts {
+	s64 spans;
+	s64 ptes;
+	s64 rewalks;
+	s64 missed;
+	s64 pending;
+};
+
+static struct mc16_rb_counts mc16_rb_counts(void)
+{
+	return (struct mc16_rb_counts) {
+		.spans = atomic64_read(&memcomp_restore_spans),
+		.ptes = atomic64_read(&memcomp_restore_ptes),
+		.rewalks = atomic64_read(&memcomp_restore_rewalks),
+		.missed = atomic64_read(&memcomp_restore_missed_pages),
+		.pending = atomic64_read(&memcomp_pending_pages),
+	};
+}
+
+static bool mc16_rb_reserve(struct mc16_flt *f)
+{
+	bool reserved;
+
+	folio_lock(f->folio);
+	reserved = memcomp_reserve(f->folio);
+	folio_unlock(f->folio);
+	return reserved;
+}
+
+static void mc16_rb_rollback(struct mc16_flt *f)
+{
+	mmap_read_lock(f->mm);
+	folio_lock(f->folio);
+	memcomp_rollback_folio(f->folio);
+	folio_unlock(f->folio);
+	mmap_read_unlock(f->mm);
+}
+
+static void mc16_rb_expect_bytes(struct mc16_flt *f)
+{
+	unsigned int i;
+	void *bytes;
+
+	for (i = 0; i < f->nr; i++) {
+		bytes = kmap_local_folio(f->folio, i * PAGE_SIZE);
+		KUNIT_EXPECT_PTR_EQ(f->test, memchr_inv(bytes, 0x6b, PAGE_SIZE), NULL);
+		kunmap_local(bytes);
+	}
+}
+
+/* A fully restored span without a lookup guard must not start another walk. */
+static void memcomp_test_public_rollback_restored(struct kunit *test)
+{
+	struct mc16_flt *f = mc16_flt_begin(test, 0);
+	struct mc16_rb_counts before, after;
+	unsigned long token;
+	unsigned int first, second;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_TRUE(test, mc16_rb_reserve(f));
+	token = swp_offset(f->folio->swap);
+	KUNIT_ASSERT_EQ(test, mc16_flt_escape(f, 0), 0);
+	mmap_read_lock(f->mm);
+	folio_lock(f->folio);
+	first = mc16_folio_restore_span(f->folio, token, false);
+	second = mc16_folio_restore_span(f->folio, token, false);
+	folio_unlock(f->folio);
+	mmap_read_unlock(f->mm);
+	KUNIT_ASSERT_EQ(test, first, 1U);
+	KUNIT_ASSERT_EQ(test, second, 0U);
+	before = mc16_rb_counts();
+	mc16_rb_rollback(f);
+	after = mc16_rb_counts();
+	KUNIT_EXPECT_EQ(test, after.spans, before.spans);
+	KUNIT_EXPECT_EQ(test, after.ptes, before.ptes);
+	KUNIT_EXPECT_EQ(test, after.rewalks, before.rewalks);
+	KUNIT_EXPECT_EQ(test, after.missed, before.missed);
+	KUNIT_EXPECT_EQ(test, after.pending, before.pending - 1);
+	KUNIT_EXPECT_EQ(test, f->folio->swap.val, 0UL);
+	KUNIT_EXPECT_FALSE(test, memcomp_entry_present(token));
+	mc16_flt_expect_present(f, 0, f->addr);
+	mc16_rb_expect_bytes(f);
+}
+
+/* Temporary guards may request a bounded rewalk, but are not missed PTEs. */
+static void memcomp_test_public_rollback_lookup_only(struct kunit *test)
+{
+	struct mc16_flt *f = mc16_flt_begin(test, 1);
+	struct mc16_rb_counts before, after;
+	unsigned long token;
+	unsigned int i;
+	int pins;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	pins = atomic_read(&f->anon_vma->refcount);
+	KUNIT_ASSERT_TRUE(test, mc16_rb_reserve(f));
+	token = swp_offset(f->folio->swap);
+	KUNIT_ASSERT_EQ(test, mc16_flt_hold(f), 0);
+	before = mc16_rb_counts();
+	mc16_rb_rollback(f);
+	after = mc16_rb_counts();
+	KUNIT_EXPECT_EQ(test, after.spans, before.spans + 1);
+	KUNIT_EXPECT_EQ(test, after.rewalks, before.rewalks + 1);
+	KUNIT_EXPECT_EQ(test, after.ptes, before.ptes);
+	KUNIT_EXPECT_EQ(test, after.missed, before.missed);
+	/* Pending slots remain live while the two lookup guards are held. */
+	KUNIT_EXPECT_EQ(test, after.pending, before.pending);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->anon_vma->refcount), pins);
+	KUNIT_EXPECT_EQ(test, f->folio->swap.val, 0UL);
+	for (i = 0; i < f->nr; i++) {
+		KUNIT_EXPECT_EQ(test, refcount_read(&f->guards[i].slot->refs), 1U);
+		KUNIT_EXPECT_FALSE(test, mc16_flt_flags(&f->guards[i], false) & MC16_F_OWNER);
+		memcomp_entry_put_ref(&f->guards[i]);
+		KUNIT_EXPECT_FALSE(test, memcomp_entry_present(token + i));
+	}
+	KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_pending_pages), before.pending - 2);
+	mc16_rb_expect_bytes(f);
+}
+
+/* Both PTEs restore on the first pass; held guards cause exactly one rewalk. */
+static void memcomp_test_public_rollback_rewalk(struct kunit *test)
+{
+	struct mc16_flt *f = mc16_flt_begin(test, 1);
+	struct mc16_rb_counts before, after;
+	unsigned long token;
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_TRUE(test, mc16_rb_reserve(f));
+	token = swp_offset(f->folio->swap);
+	KUNIT_ASSERT_EQ(test, mc16_flt_hold(f), 0);
+	for (i = 0; i < f->nr; i++)
+		KUNIT_ASSERT_EQ(test, mc16_flt_escape(f, i), 0);
+	before = mc16_rb_counts();
+	mc16_rb_rollback(f);
+	after = mc16_rb_counts();
+	KUNIT_EXPECT_EQ(test, after.spans, before.spans + 1);
+	KUNIT_EXPECT_EQ(test, after.ptes, before.ptes + 2);
+	KUNIT_EXPECT_EQ(test, after.rewalks, before.rewalks + 1);
+	KUNIT_EXPECT_EQ(test, after.missed, before.missed);
+	/* Pending slots remain live while the two lookup guards are held. */
+	KUNIT_EXPECT_EQ(test, after.pending, before.pending);
+	KUNIT_EXPECT_EQ(test, mc16_flt_rss(f, MM_SWAPENTS), f->swapents);
+	KUNIT_EXPECT_EQ(test, mc16_flt_rss(f, MM_ANONPAGES), f->anonpages + 2);
+	for (i = 0; i < f->nr; i++) {
+		mc16_flt_expect_present(f, i, f->addr + i * PAGE_SIZE);
+		KUNIT_EXPECT_EQ(test, refcount_read(&f->guards[i].slot->refs), 1U);
+		memcomp_entry_put_ref(&f->guards[i]);
+		KUNIT_EXPECT_FALSE(test, memcomp_entry_present(token + i));
+	}
+	KUNIT_EXPECT_EQ(test, atomic64_read(&memcomp_pending_pages), before.pending - 2);
+	mc16_rb_expect_bytes(f);
+}
+#endif /* MC16_FOLIO_TEST_ENABLED && CONFIG_MEMCOMP_DEBUG_STATS */
+#endif /* _MM_MEMCOMP_TESTS_ROLLBACK_TEST_H */
diff --git a/mm/memcomp/tests/scan_test.h b/mm/memcomp/tests/scan_test.h
new file mode 100644
index 0000000..cf283f4
--- /dev/null
+++ b/mm/memcomp/tests/scan_test.h
@@ -0,0 +1,422 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_SCAN_TEST_H
+#define _MM_MEMCOMP_TESTS_SCAN_TEST_H
+
+/* Include after storage/refs fixtures and cache_store.h; register in main. */
+#include "../scan.h"
+
+#ifdef CONFIG_MEMCG
+struct mc16_test_scan {
+	struct mc16_test_refs *refs;
+	struct memcomp_ref guard;
+	struct memcomp_ref cache;
+	u32 markers[2];
+	bool active;
+};
+
+static void mc16_test_scan_cleanup(void *data)
+{
+	struct mc16_test_scan *f = data;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(f->markers); i++)
+		if (f->markers[i])
+			xa_erase_irq(&mc16_clusters, f->markers[i]);
+	if (f->guard.slot)
+		mc16_ref_put(&f->guard);
+	if (f->cache.slot) {
+		if (f->active) {
+			mc16_ref_put(&f->cache);
+		} else {
+			mc16_release_resources(&f->cache);
+			mc16_retire_slot(&f->cache);
+		}
+	}
+}
+
+static struct mc16_test_scan *mc16_test_scan_begin(struct kunit *test)
+{
+	struct mc16_test_scan *f;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->refs = mc16_test_refs_begin(test);
+	if (!f->refs || kunit_add_action_or_reset(test,
+						  mc16_test_scan_cleanup, f))
+		return NULL;
+	return f;
+}
+
+/* The real reservation transaction still publishes/charges the cluster. */
+static int mc16_test_scan_last_id(u32 *id)
+{
+	return __xa_alloc(&mc16_clusters, id, NULL,
+		XA_LIMIT(MC16_MAX_CLUSTER_ID, MC16_MAX_CLUSTER_ID),
+		GFP_NOWAIT | __GFP_NOWARN);
+}
+
+/* Reserve a real XArray zero entry, not a published refs-zero cache slot. */
+static int mc16_test_scan_marker(struct mc16_test_scan *f,
+				 unsigned int which, u32 id)
+{
+	unsigned long flags;
+	u32 reserved;
+	int ret;
+
+	xa_lock_irqsave(&mc16_clusters, flags);
+	ret = __xa_alloc(&mc16_clusters, &reserved, NULL, XA_LIMIT(id, id),
+			 GFP_NOWAIT | __GFP_NOWARN);
+	if (!ret)
+		f->markers[which] = reserved;
+	xa_unlock_irqrestore(&mc16_clusters, flags);
+	return ret;
+}
+
+static int mc16_test_scan_private(struct mc16_test_scan *f)
+{
+	const struct mc16_initial_payload initial = { .word = 0x5a5a };
+	struct mc16_test_storage *s = f->refs->storage;
+
+	return mc16_reserve_cache(&s->owner->model.objcg,
+		folio_nid(s->owner->folio), &initial, 1, &f->cache);
+}
+
+static void memcomp_test_scan_empty_budget(struct kunit *test)
+{
+	struct mc16_test_scan *f = mc16_test_scan_begin(test);
+	unsigned int scanned = 99;
+	u64 cursor = 0;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_EXPECT_EQ(test, mc16_scan_next(&cursor, 0, &f->guard,
+					     &scanned), MC16_SCAN_BUDGET);
+	KUNIT_EXPECT_EQ(test, cursor, 0ULL);
+	KUNIT_EXPECT_EQ(test, scanned, 0U);
+	KUNIT_EXPECT_NULL(test, f->guard.slot);
+	KUNIT_EXPECT_EQ(test, mc16_scan_next(&cursor, 1, &f->guard,
+					     &scanned), MC16_SCAN_END);
