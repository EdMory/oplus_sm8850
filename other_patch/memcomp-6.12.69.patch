+
+static void memcomp_test_fault_uffd_wp(struct kunit *test)
+{
+	mc16_ft_protection(test, 2);
+}
+
+static void memcomp_test_fault_readonly(struct kunit *test)
+{
+	mc16_ft_protection(test, 3);
+}
