diff --git a/kernel/sched/poc_selector.c b/kernel/sched/poc_selector.c
index 1412e29..37d562e 100644
--- a/kernel/sched/poc_selector.c
+++ b/kernel/sched/poc_selector.c
@@ -100,7 +100,7 @@ DEFINE_STATIC_KEY_FALSE(sched_poc_smt_fallback);
  * Disabled at boot if non-consecutive 2-way SMT or >2-way SMT
  * is detected on any LLC.
  */
-DEFINE_STATIC_KEY_TRUE(sched_poc_smt_consecutive);
+DEFINE_STATIC_KEY_FALSE(sched_poc_smt_consecutive);
 
 /*
  * SMT uniform 2-way layout: sched_poc_smt_uniform
@@ -118,7 +118,7 @@ DEFINE_STATIC_KEY_TRUE(sched_poc_smt_consecutive);
  *
  * Disabled at boot if any LLC contains non-2-way or non-uniform SMT.
  */
-DEFINE_STATIC_KEY_TRUE(sched_poc_smt_uniform);
+DEFINE_STATIC_KEY_FALSE(sched_poc_smt_uniform);
 
 /*
  * Target CPU sticky: sched_poc_target_sticky
@@ -152,7 +152,7 @@ DEFINE_STATIC_KEY_FALSE(sched_poc_target_sticky);
  *
  * Default: enabled.
  */
-DEFINE_STATIC_KEY_TRUE(sched_poc_early_select);
+DEFINE_STATIC_KEY_FALSE(sched_poc_early_select);
 
 /*
  * Greedy search: sched_poc_greedy_search
@@ -168,7 +168,7 @@ DEFINE_STATIC_KEY_TRUE(sched_poc_early_select);
  *
  * Default: enabled.
  */
-DEFINE_STATIC_KEY_TRUE(sched_poc_greedy_search);
+DEFINE_STATIC_KEY_FALSE(sched_poc_greedy_search);
 
 /*
  * sched_poc_aligned: true when all LLCs have poc_cpu_base aligned to 64
@@ -178,7 +178,7 @@ DEFINE_STATIC_KEY_TRUE(sched_poc_greedy_search);
  * is needed to align cpumask bits with POC's LLC-relative positions.
  * Defaults to true; disabled at boot if any LLC has non-aligned base.
  */
-DEFINE_STATIC_KEY_TRUE(sched_poc_aligned);
+DEFINE_STATIC_KEY_FALSE(sched_poc_aligned);
 
 /*
  * Packed priority search: sched_poc_packed
@@ -198,7 +198,7 @@ DEFINE_STATIC_KEY_TRUE(sched_poc_aligned);
  *
  * Disabled at boot if any LLC has > 32 CPUs.
  */
-DEFINE_STATIC_KEY_TRUE(sched_poc_packed);
+DEFINE_STATIC_KEY_FALSE(sched_poc_packed);
 
 /*
  * Improved RR strategy: sched_poc_rr_improved
@@ -219,7 +219,7 @@ DEFINE_STATIC_KEY_TRUE(sched_poc_packed);
  * once the improved path is validated, the legacy code will
  * be removed in a follow-up.
  */
-DEFINE_STATIC_KEY_TRUE(sched_poc_rr_improved);
+DEFINE_STATIC_KEY_FALSE(sched_poc_rr_improved);
 
 /*
  * Waker-yield handoff static key (sysctl kernel.sched_poc_waker_yield).
@@ -229,7 +229,7 @@ DEFINE_STATIC_KEY_TRUE(sched_poc_rr_improved);
  * places the wakee on the waker's own CPU: zero follow-on migration,
  * warm L1/L2/TLB.  Default on: A/B-able.
  */
-DEFINE_STATIC_KEY_TRUE(sched_poc_waker_yield);
+DEFINE_STATIC_KEY_FALSE(sched_poc_waker_yield);
 /**************************************************************
  * Debug counters (sysctl kernel.sched_poc_count):
  *
diff --git a/kernel/sched/sched.h b/kernel/sched/sched.h
index 1895d46..b1768ad 100644
--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -2228,13 +2228,13 @@ extern void poc_check_skip_fallback(void);
 #else
 static inline void poc_check_skip_fallback(void) {}
 #endif
-extern struct static_key_true sched_poc_aligned;
-extern struct static_key_true sched_poc_smt_consecutive;
-extern struct static_key_true sched_poc_smt_uniform;
+extern struct static_key_false sched_poc_aligned;
+extern struct static_key_false sched_poc_smt_consecutive;
+extern struct static_key_false sched_poc_smt_uniform;
 extern struct static_key_false sched_poc_target_sticky;
-extern struct static_key_true sched_poc_packed;
+extern struct static_key_false sched_poc_packed;
 extern void __set_cpu_idle_state_poc(int cpu, int state);
-extern struct static_key_true sched_poc_waker_yield;
+extern struct static_key_false sched_poc_waker_yield;
 void poc_aggregate(struct sched_domain_shared *sd_share);
 void poc_commit_cpu(int cpu);
 extern unsigned int poc_pull_budget;
