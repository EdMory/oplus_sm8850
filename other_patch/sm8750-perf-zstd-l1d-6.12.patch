From 6d2f4c6e8a0b2d4f6a8c0e2b4d6f8a0c2e4b6d8f Mon Sep 17 00:00:00 2001
From: brokestar233 <3765589194@qq.com>
Date: Tue, 12 Aug 2025 10:42:21 +0800
Subject: [PATCH] zstd: Optimize compression parameters based on L1D cache size

Rebased for 6.12.38 (oneplus/sm8845_b_16.0.0_ace_6t).

Introduce DSLAB_OPTIMIZE_COMPRESS macro to enable dynamic adjustment of
ZSTD compression parameters (hashLog and chainLog) based on the L1D cache
size, defined as DSLAB_L1DCACHE_LOG (64KB). This ensures hashLog does not
exceed DSLAB_L1DCACHE_LOG - 4, and chainLog is set to hashLog - 1 if it
would otherwise be larger, improving performance for cache-constrained
environments.

Macro definitions are placed inside lib/zstd/compress/zstd_compress.c
since the vendor 6.12 zstd.h does not expose the upstream hunk context.

Signed-off-by: brokestar233 <3765589194@qq.com>
---
--- a/lib/zstd/compress/zstd_compress.c
+++ b/lib/zstd/compress/zstd_compress.c
@@ -6071,6 +6071,12 @@
  *  Note: srcSizeHint 0 means 0, use ZSTD_CONTENTSIZE_UNKNOWN for unknown.
  *        Use dictSize == 0 for unknown or unused.
  *  Note: `mode` controls how we treat the `dictSize`. See docs for `ZSTD_cParamMode_e`. */
+#ifndef DSLAB_OPTIMIZE_COMPRESS
+#define DSLAB_OPTIMIZE_COMPRESS
+#endif
+#ifndef DSLAB_L1DCACHE_LOG
+#define DSLAB_L1DCACHE_LOG 16 /* 64KB L1d cache */
+#endif
 static ZSTD_compressionParameters ZSTD_getCParams_internal(int compressionLevel, unsigned long long srcSizeHint, size_t dictSize, ZSTD_cParamMode_e mode)
 {
     U64 const rSize = ZSTD_getCParamRowSize(srcSizeHint, dictSize, mode);
@@ -6086,6 +6092,15 @@
 
     {   ZSTD_compressionParameters cp = ZSTD_defaultCParameters[tableID][row];
         DEBUGLOG(5, "ZSTD_getCParams_internal selected tableID: %u row: %u strat: %u", tableID, row, (U32)cp.strategy);
+#ifdef DSLAB_OPTIMIZE_COMPRESS
+        /* Automatically adjust hashLog and chainLog according to the L1D cache size */
+        if (cp.hashLog > DSLAB_L1DCACHE_LOG - 4) {
+            cp.hashLog = DSLAB_L1DCACHE_LOG - 4;
+        }
+        if (cp.chainLog >= cp.hashLog) {
+            cp.chainLog = cp.hashLog - 1;
+        }
+#endif
         /* acceleration factor */
         if (compressionLevel < 0) {
             int const clampedCompressionLevel = MAX(ZSTD_minCLevel(), compressionLevel);
