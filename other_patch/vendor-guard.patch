diff --git a/include/linux/lru_cast_vendor.h b/include/linux/lru_cast_vendor.h
new file mode 100644
index 0000000..403ba70
--- /dev/null
+++ b/include/linux/lru_cast_vendor.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- the vendor modules the swap path is not shared with
+ * (mm/lru_cast/core/vendor.c).
+ *
+ * The loader asks here before a module is laid out: a tree that brings its
+ * own zram stack is refused, and what is refused costs nothing since the
+ * GKI zram and zsmalloc take the swap path. A tree that gets one in anyway
+ * is reported, and kcompressd then writes what it is given itself.
+ */
+#ifndef _LINUX_LRU_CAST_VENDOR_H
+#define _LINUX_LRU_CAST_VENDOR_H
+
+#include <linux/types.h>
+
+#ifdef CONFIG_LRU_CAST_VENDOR_GUARD
+
+/* the loader, before layout: true for the modules that are kept out */
+bool lru_cast_vendor_module_blocked(const char *name);
+/* the loader, once linked in: watch what was not kept out */
+void lru_cast_vendor_module_loaded(const char *name);
+
+/* a vendor zram stack is on the swap path: kcompressd stays synchronous */
+bool lru_cast_vendor_swap_mixed(void);
+
+/* /sys/kernel/mm/lru_cast/vendor: -1 as found, 0 as if absent, 1 synchronous */
+int lru_cast_vendor_guard_set(int value);
+int lru_cast_vendor_guard_show(char *buf);
+
+#else
+
+static inline bool lru_cast_vendor_module_blocked(const char *name)
+{
+	return false;
+}
+
+static inline void lru_cast_vendor_module_loaded(const char *name)
+{
+}
+
+static inline bool lru_cast_vendor_swap_mixed(void)
+{
+	return false;
+}
+
+#endif /* CONFIG_LRU_CAST_VENDOR_GUARD */
+
+#endif /* _LINUX_LRU_CAST_VENDOR_H */
diff --git a/kernel/module/main.c b/kernel/module/main.c
index 5f04267..7247f53 100644
--- a/kernel/module/main.c
+++ b/kernel/module/main.c
@@ -56,6 +56,7 @@
 #include <linux/dynamic_debug.h>
 #include <linux/audit.h>
 #include <linux/cfi.h>
+#include <linux/lru_cast_vendor.h>
 #include <linux/codetag.h>
 #include <linux/debugfs.h>
 #include <linux/execmem.h>
@@ -3277,3 +3278,7 @@
 static int early_mod_check(struct load_info *info, int flags)
 {
 	int err;
+	/* CAST: a swap path of its own, a folio handed on is not shared */
+	if (lru_cast_vendor_module_blocked(info->name))
+		return -ENOENT;
+
@@ -3463,6 +3468,7 @@ static int load_module(struct load_info *info, const char __user *uargs,
 	codetag_load_module(mod);
 
 	/* Done! */
+	lru_cast_vendor_module_loaded(mod->name);
 	trace_module_load(mod);
 
 	return do_init_module(mod);
diff --git a/mm/Kconfig b/mm/Kconfig
index 9ca6a51..fb82133 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -1397,3 +1397,28 @@ config LRU_CAST
 	  multi-gen LRU is as LRU_GEN_ENABLED says. At run time, one is
 	  switched off before the other is switched on:
 	  /sys/kernel/mm/lru_cast/enabled, /sys/kernel/mm/lru_gen/enabled.
+
+config LRU_CAST_VENDOR_GUARD
+	bool "CAST: keep the vendor zram stack out"
+	depends on LRU_CAST
+	default y
+	help
+	  An OnePlus/OPPO tree ships its own zram stack beside the GKI one:
+	  oplus_bsp_hybridswap_zram, oplus_bsp_zram_opt and
+	  oplus_bsp_zsmalloc. They take a folio handed to writeback as theirs
+	  alone, while CAST's kcompressd hands kswapd's folio to a thread and
+	  gets to it later, so the two disagree about who owns it and the boot
+	  after the handoff never finishes.
+
+	  With this on the module loader refuses those three before a byte is
+	  laid out: the swap path stays with the GKI zram and zsmalloc, and
+	  kcompressd runs. A tree that keeps the vendor stack under another
+	  name is not refused but reported, and kcompressd writes
+	  synchronously there, as it does with this off.
+
+	  oplus_bsp_fg_protect and oplus_exit_mm_optimize are not named here;
+	  the T2 increment adds them once swap and OOM have been seen to work
+	  without them.
+
+	  /sys/kernel/mm/lru_cast/vendor settles it by hand: -1 what the
+	  loader found, 0 run kcompressd, 1 write synchronously.
