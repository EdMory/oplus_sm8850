diff --git a/mm/lru_cast/core/vendor.c b/mm/lru_cast/core/vendor.c
new file mode 100644
index 0000000..36c8fab
--- /dev/null
+++ b/mm/lru_cast/core/vendor.c
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the vendor modules the swap path is not shared with.
+ *
+ * An OnePlus/OPPO tree carries its own zram stack beside the GKI one:
+ * oplus_bsp_hybridswap_zram, oplus_bsp_zram_opt and oplus_bsp_zsmalloc.
+ * They take a folio handed to writeback as theirs alone, while CAST's
+ * kcompressd hands kswapd's folio to a thread and gets to it later: two
+ * owners for one folio, and the vendor side's LRU and accounting bookkeeping
+ * drifts, which is how the handoff came out as a boot that never finishes.
+ *
+ * So the loader refuses those three before a byte is laid out --
+ * early_mod_check() in kernel/module/main.c. With them gone the swap path is
+ * the GKI zram and zsmalloc, and kcompressd runs. oplus_bsp_fg_protect and
+ * oplus_exit_mm_optimize are left alone here; the T2 increment takes them
+ * too, once swap and OOM have been seen to work without them.
+ *
+ * A tree that keeps the vendor stack under another name is not refused, and
+ * the loader cannot refuse zram on sight: the GKI module has that name too.
+ * What is loaded is reported instead, and kcompressd_active() in
+ * include/linux/lru_cast.h then answers no, which is the same synchronous
+ * write v0.2.9 does without this file.
+ *
+ * /sys/kernel/mm/lru_cast/vendor: -1 what the loader found, 0 as if the
+ * vendor stack were absent, 1 always synchronous.
+ */
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/lru_cast_vendor.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+
+#define VENDOR_NAME_MAX	48
+
+/* refused outright: names no GKI module has */
+static const char *const vendor_keep_out[] = {
+	"oplus_bsp_hybridswap_zram",
+	"oplus_bsp_zram_opt",
+	"oplus_bsp_zsmalloc",
+};
+
+/* watched when loaded anyway: a vendor zram stack under any of its names */
+static const char *const vendor_swap_marks[] = {
+	"zram",
+	"zsmalloc",
+	"hybridswap",
+};
+
+static bool vendor_mixed;
+static int vendor_override = -1;
+static char vendor_mixed_name[VENDOR_NAME_MAX];
+
+static bool vendor_named(const char *name, const char *const *set, int n)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (!strcmp(name, set[i]))
+			return true;
+	return false;
+}
+
+/* oplus, and about the swap path: what the GKI modules are not */
+static bool vendor_swap_like(const char *name)
+{
+	int i;
+
+	if (strncmp(name, "oplus", 5))
+		return false;
+	for (i = 0; i < ARRAY_SIZE(vendor_swap_marks); i++)
+		if (strstr(name, vendor_swap_marks[i]))
+			return true;
+	return false;
+}
+
+bool lru_cast_vendor_module_blocked(const char *name)
+{
+	if (!name || !vendor_named(name, vendor_keep_out,
+				   ARRAY_SIZE(vendor_keep_out)))
+		return false;
+
+	pr_info("lru_cast: %s stays out, the swap path is CAST's\n", name);
+	return true;
+}
+
+void lru_cast_vendor_module_loaded(const char *name)
+{
+	if (!name || !vendor_swap_like(name) || READ_ONCE(vendor_mixed))
+		return;
+
+	strscpy(vendor_mixed_name, name, sizeof(vendor_mixed_name));
+	WRITE_ONCE(vendor_mixed, true);
+	pr_warn("lru_cast: vendor %s is loaded, kcompressd stays synchronous\n",
+		name);
+}
+
+bool lru_cast_vendor_swap_mixed(void)
+{
+	int override = READ_ONCE(vendor_override);
+
+	return override < 0 ? READ_ONCE(vendor_mixed) : override;
+}
+
+int lru_cast_vendor_guard_show(char *buf)
+{
+	return sysfs_emit(buf, "%d %s\n", lru_cast_vendor_swap_mixed(),
+			  vendor_mixed_name[0] ? vendor_mixed_name : "-");
+}
+
+int lru_cast_vendor_guard_set(int value)
+{
+	if (value < -1 || value > 1)
+		return -EINVAL;
+
+	WRITE_ONCE(vendor_override, value);
+	return 0;
+}
diff --git a/mm/lru_cast/sysfs.c b/mm/lru_cast/sysfs.c
index 42d0503..774345f 100644
--- a/mm/lru_cast/sysfs.c
+++ b/mm/lru_cast/sysfs.c
@@ -244,6 +244,25 @@ static ssize_t kcompressd_store(struct kobject *kobj, struct kobj_attribute *att
 static struct kobj_attribute kcompressd_attr = __ATTR_RW(kcompressd);
 #endif
 
+#ifdef CONFIG_LRU_CAST_VENDOR_GUARD
+static ssize_t vendor_show(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+	return lru_cast_vendor_guard_show(buf);
+}
+
+static ssize_t vendor_store(struct kobject *kobj, struct kobj_attribute *attr,
+			    const char *buf, size_t len)
+{
+	int v;
+
+	if (kstrtoint(buf, 10, &v) || lru_cast_vendor_guard_set(v))
+		return -EINVAL;
+	return len;
+}
+
+static struct kobj_attribute vendor_attr = __ATTR_RW(vendor);
+#endif
+
 static struct kobj_attribute sweep_attr = __ATTR_RO(sweep);
 static struct kobj_attribute version_attr = __ATTR_RO(version);
 static struct kobj_attribute enabled_attr = __ATTR_RW(enabled);
@@ -278,6 +297,9 @@ static struct attribute *lru_cast_attrs[] = {
 	&sweep_attr.attr,
 #ifdef CONFIG_SWAP
 	&kcompressd_attr.attr,
+#endif
+#ifdef CONFIG_LRU_CAST_VENDOR_GUARD
+	&vendor_attr.attr,
 #endif
 	NULL,
 };
